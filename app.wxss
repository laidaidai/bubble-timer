/* 主色底上的文字统一用 --on-primary，深色主题下才看得清 */
.primary-button, .modal-confirm, .pause-button { color: var(--on-primary); }

/* ---- 公共顶栏（四个端口径一致，改这里全站生效） ---- */
.topbar { position: relative; z-index: 60; box-sizing: border-box; height: 176rpx; padding: 70rpx 28rpx 0; padding-top: max(70rpx, calc(env(safe-area-inset-top) + 6rpx)); display: flex; align-items: center; gap: 14rpx; color: var(--ink); background: var(--nav); border-bottom: 3rpx solid var(--edge); }
.topbar-title { flex: 1; min-width: 0; overflow: hidden; color: var(--ink); text-align: center; white-space: nowrap; font-size: 36rpx; font-weight: 900; line-height: 1.2; letter-spacing: 2rpx; }
.back-icon { flex: 0 0 70rpx; width: 70rpx !important; min-width: 70rpx !important; max-width: 70rpx; height: 60rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; color: var(--ink); background: transparent; border: 0; font-size: 60rpx; font-weight: 300; line-height: 1; }
.topbar-spacer { flex: 0 0 70rpx; width: 70rpx; height: 60rpx; }


/* ===== 全局动效：只做轻量反馈，不改变布局 ===== */
@keyframes app-page-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes app-rise-in { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes app-pop-in { 0% { opacity: 0; transform: scale(.88); } 65% { opacity: 1; transform: scale(1.04); } 100% { opacity: 1; transform: scale(1); } }

.app, .tools-page, .history-page, .todo-page, .settings-page, .quick-page, .timer-page, .stats-page {
  animation: app-page-fade .24s ease-out both;
}

button {
  transition: transform .12s ease, opacity .12s ease;
}
button:active {
  transform: scale(.96);
  opacity: .9;
}

.motion-rise { animation: app-rise-in .36s cubic-bezier(.2, .8, .3, 1) both; }

/* 进入横屏计时页的转屏遮罩：只铺主题底色，避免露出上一页放大的内容 */
.timer-launch-cover {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  background: var(--bg);
  pointer-events: none;
}

/* ===== 品牌标识 ===== */
.topbar-brand { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.brand-mark { flex: 0 0 64rpx; width: 64rpx; height: 64rpx; display: block; }
.topbar-brand-slot { flex: 0 0 70rpx; width: 70rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.brand-mark-side { flex-basis: 50rpx; width: 50rpx; height: 50rpx; }

/* 空状态 logo 共用漂浮动画 */
@keyframes history-logo-float { 0%, 100% { transform: translate(0, 0) rotate(0deg); } 50% { transform: translate(8rpx, -8rpx) rotate(-1.5deg); } }

/* 计时开始 / 结束往返时，首页遮罩中心也放品牌 logo，避免露出旧页内容 */
.timer-launch-cover { display: flex; align-items: center; justify-content: center; }
.launch-cover-logo { width: 150rpx; height: 150rpx; animation: launch-cover-breathe 1.7s ease-in-out infinite; }
@keyframes launch-cover-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-6rpx) scale(1.035); }
}

/* 全站按键与弹层统一柔软过渡 */
button { transform-origin: center; transition: transform .15s cubic-bezier(.2, .9, .3, 1), opacity .15s ease, box-shadow .15s ease; }
button:active { transform: scale(.955) translateY(1rpx); opacity: .92; }
.modal-mask { animation: app-page-fade .18s ease-out both; }
.modal-card { animation: app-pop-in .28s cubic-bezier(.2, .8, .3, 1) both; }
.imp-page { animation: app-page-fade .24s ease-out both; }

/* ===== 删除反馈：内容像泡泡一样炸成水滴后消失 ===== */
.bubble-bursting {
  position: relative !important;
  overflow: visible !important;
  pointer-events: none;
  z-index: 30;
  animation: bubble-card-pop .46s cubic-bezier(.2, .8, .3, 1) 0s both !important;
  animation-delay: 0s !important;
}
@keyframes bubble-card-pop {
  0% { opacity: 1; transform: scale(1); filter: blur(0); }
  18% { opacity: 1; transform: scale(1.045); }
  42% { opacity: 1; transform: scale(1.01); }
  72% { opacity: .86; transform: scale(.94); }
  100% { opacity: 0; transform: scale(.86); filter: blur(5rpx); }
}

.burst-layer {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 8;
  overflow: visible;
  pointer-events: none;
}
.burst-ring {
  position: absolute;
  left: 20%; top: 20%;
  width: 60%; height: 60%;
  box-sizing: border-box;
  border: 3rpx solid var(--primary);
  border-radius: 50%;
  opacity: 0;
  transform: scale(.4);
}
.bubble-bursting .burst-ring { animation: bubble-ring .5s ease-out both; }
@keyframes bubble-ring {
  0% { opacity: .7; transform: scale(.42); border-width: 5rpx; }
  65% { opacity: .25; }
  100% { opacity: 0; transform: scale(1.35); border-width: 1rpx; }
}

.burst-drop {
  position: absolute;
  left: calc(50% - 6rpx);
  top: calc(50% - 7rpx);
  width: 12rpx;
  height: 14rpx;
  background: var(--primary);
  border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
  opacity: 0;
  transform: translate(0, 0) scale(.2);
  box-shadow: inset -2rpx -2rpx 0 rgba(255, 255, 255, .42);
}
.burst-drop::after {
  content: "";
  position: absolute;
  left: 3rpx; top: 2rpx;
  width: 4rpx; height: 4rpx;
  background: rgba(255, 255, 255, .75);
  border-radius: 50%;
}
.bubble-bursting .burst-drop { animation-duration: .52s; animation-timing-function: cubic-bezier(.18, .7, .28, 1); animation-fill-mode: both; }
.bubble-bursting .d1 { animation-name: burst-drop-1; animation-delay: .01s; }
.bubble-bursting .d2 { animation-name: burst-drop-2; animation-delay: .04s; }
.bubble-bursting .d3 { animation-name: burst-drop-3; animation-delay: .02s; }
.bubble-bursting .d4 { animation-name: burst-drop-4; animation-delay: .07s; }
.bubble-bursting .d5 { animation-name: burst-drop-5; animation-delay: .03s; }
.bubble-bursting .d6 { animation-name: burst-drop-6; animation-delay: .08s; }
.bubble-bursting .d7 { animation-name: burst-drop-7; animation-delay: .05s; }
.bubble-bursting .d8 { animation-name: burst-drop-8; animation-delay: .06s; }

@keyframes burst-drop-1 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .95; }
  100% { opacity: 0; transform: translate(-96rpx, -66rpx) scale(.9) rotate(-16deg); }
}
@keyframes burst-drop-2 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .9; }
  100% { opacity: 0; transform: translate(-54rpx, -94rpx) scale(.72) rotate(12deg); }
}
@keyframes burst-drop-3 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .95; }
  100% { opacity: 0; transform: translate(6rpx, -106rpx) scale(.94) rotate(-10deg); }
}
@keyframes burst-drop-4 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .9; }
  100% { opacity: 0; transform: translate(72rpx, -78rpx) scale(.7) rotate(18deg); }
}
@keyframes burst-drop-5 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .95; }
  100% { opacity: 0; transform: translate(104rpx, -18rpx) scale(.9) rotate(-8deg); }
}
@keyframes burst-drop-6 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .9; }
  100% { opacity: 0; transform: translate(82rpx, 56rpx) scale(.68) rotate(14deg); }
}
@keyframes burst-drop-7 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .95; }
  100% { opacity: 0; transform: translate(22rpx, 92rpx) scale(.92) rotate(-18deg); }
}
@keyframes burst-drop-8 {
  0% { opacity: 0; transform: translate(0, 0) scale(.2); }
  18% { opacity: .9; }
  100% { opacity: 0; transform: translate(-66rpx, 72rpx) scale(.75) rotate(8deg); }
}

/* 横向排布的卡片里，水滴往左右扩散得更明显 */
.burst-layer.wide .burst-drop { background: var(--primary); }

/* 删除：模块先向内收缩，再炸成较大的水滴水泡 */
.bubble-bursting {
  animation: bubble-card-inward .48s cubic-bezier(.22, .75, .28, 1) 0s both !important;
  animation-delay: 0s !important;
}
@keyframes bubble-card-inward {
  0% { opacity: 1; transform: scale(1); filter: blur(0); }
  14% { opacity: 1; transform: scale(1.025); }
  38% { opacity: 1; transform: scale(.99); }
  62% { opacity: .96; transform: scale(.9); }
  84% { opacity: .7; transform: scale(.72); filter: blur(2rpx); }
  100% { opacity: 0; transform: scale(.52); filter: blur(6rpx); }
}

.burst-drop {
  left: calc(50% - 18rpx);
  top: calc(50% - 20rpx);
  width: 36rpx;
  height: 40rpx;
  background: var(--primary);
  border: 2rpx solid rgba(255, 255, 255, .62);
  border-radius: 50% 50% 50% 50% / 64% 64% 36% 36%;
  box-shadow: inset -4rpx -5rpx 0 rgba(255, 255, 255, .25), 0 6rpx 12rpx rgba(13, 39, 58, .18);
}
.burst-drop::after {
  left: 8rpx;
  top: 6rpx;
  width: 9rpx;
  height: 11rpx;
}
.burst-drop.d2,
.burst-drop.d4,
.burst-drop.d6,
.burst-drop.d8 { background: var(--primary-2); }

.bubble-bursting .burst-drop {
  animation-duration: .46s;
  animation-delay: .10s;
}
.bubble-bursting .d1 { animation-delay: .08s; }
.bubble-bursting .d2 { animation-delay: .12s; }
.bubble-bursting .d3 { animation-delay: .10s; }
.bubble-bursting .d4 { animation-delay: .15s; }
.bubble-bursting .d5 { animation-delay: .09s; }
.bubble-bursting .d6 { animation-delay: .14s; }
.bubble-bursting .d7 { animation-delay: .11s; }
.bubble-bursting .d8 { animation-delay: .16s; }

.bubble-bursting .burst-ring {
  border-width: 4rpx;
  animation-duration: .42s;
}

/* ===== 删除动画 v3：卡片被一颗泡泡收进去，泡泡上浮后轻轻破裂 ===== */
.bubble-bursting {
  overflow: visible !important;
  animation: bubble-card-absorb .56s cubic-bezier(.24, .72, .28, 1) 0s both !important;
  animation-delay: 0s !important;
}
@keyframes bubble-card-absorb {
  0% { opacity: 1; transform: scale(1); filter: blur(0); }
  16% { opacity: 1; transform: scale(1.012); }
  38% { opacity: 1; transform: scale(.995); }
  56% { opacity: 1; transform: scale(.96); }
  72% { opacity: .95; transform: scale(.87); filter: blur(1rpx); }
  86% { opacity: .52; transform: scale(.79); filter: blur(3rpx); }
  100% { opacity: 0; transform: scale(.72); filter: blur(9rpx); }
}

/* 中间的大泡泡：先罩住内容，再向上飘一点后破裂 */
.bubble-bursting .burst-ring {
  left: 50%;
  top: 50%;
  width: 78rpx;
  height: 78rpx;
  margin: -39rpx 0 0 -39rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--primary);
  border-radius: 50%;
  background: radial-gradient(circle at 34% 28%, rgba(255,255,255,.58) 0 12%, rgba(255,255,255,.16) 34%, rgba(255,255,255,0) 62%);
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.45), 0 8rpx 20rpx rgba(13,39,58,.12);
  transform: translate(0, 0) scale(.18);
  animation: bubble-globe-absorb .56s cubic-bezier(.22, .72, .26, 1) 0s both !important;
  z-index: 1;
}
.burst-ring::after {
  content: "";
  position: absolute;
  left: 15%;
  top: 12%;
  width: 24%;
  height: 16%;
  background: rgba(255,255,255,.68);
  border-radius: 50%;
  transform: rotate(-26deg);
}
@keyframes bubble-globe-absorb {
  0% { opacity: 0; transform: translate(0, 0) scale(.18); }
  24% { opacity: .76; transform: translate(0, -2rpx) scale(.56); }
  48% { opacity: .92; transform: translate(0, -4rpx) scale(1.03); }
  64% { opacity: .94; transform: translate(0, -9rpx) scale(1.02); }
  78% { opacity: .82; transform: translate(0, -16rpx) scale(1.12); }
  100% { opacity: 0; transform: translate(0, -34rpx) scale(1.38); }
}

/* 只保留 4 颗较大的水滴，泡泡破裂后向四周散开 */
.burst-drop {
  left: calc(50% - 12rpx);
  top: calc(50% - 13rpx);
  width: 24rpx;
  height: 26rpx;
  z-index: 3;
  background: var(--primary);
  border: 2rpx solid rgba(255,255,255,.66);
  border-radius: 50% 50% 50% 50% / 64% 64% 36% 36%;
  box-shadow: inset -3rpx -4rpx 0 rgba(255,255,255,.28), 0 5rpx 10rpx rgba(13,39,58,.16);
  opacity: 0;
  transform: translate(0, 0) scale(.25);
}
.burst-drop::after {
  left: 5rpx;
  top: 4rpx;
  width: 7rpx;
  height: 8rpx;
}
.bubble-bursting .burst-drop {
  animation-duration: .30s;
  animation-timing-function: cubic-bezier(.2, .7, .3, 1);
  animation-delay: .26s;
  animation-fill-mode: both;
}
.bubble-bursting .d1 { animation-name: bubble-drop-1; animation-delay: .26s; }
.bubble-bursting .d2 { animation-name: bubble-drop-2; animation-delay: .28s; }
.bubble-bursting .d3 { animation-name: bubble-drop-3; animation-delay: .27s; }
.bubble-bursting .d4 { animation-name: bubble-drop-4; animation-delay: .30s; }
.bubble-bursting .d5,
.bubble-bursting .d6,
.bubble-bursting .d7,
.bubble-bursting .d8 { display: none; }

@keyframes bubble-drop-1 {
  0% { opacity: 0; transform: translate(0, 0) scale(.25); }
  26% { opacity: .9; transform: translate(-34rpx, -30rpx) scale(1); }
  100% { opacity: 0; transform: translate(-82rpx, -76rpx) scale(.52) rotate(-16deg); }
}
@keyframes bubble-drop-2 {
  0% { opacity: 0; transform: translate(0, 0) scale(.25); }
  26% { opacity: .9; transform: translate(36rpx, -32rpx) scale(1); }
  100% { opacity: 0; transform: translate(88rpx, -84rpx) scale(.5) rotate(14deg); }
}
@keyframes bubble-drop-3 {
  0% { opacity: 0; transform: translate(0, 0) scale(.25); }
  26% { opacity: .9; transform: translate(40rpx, 28rpx) scale(1); }
  100% { opacity: 0; transform: translate(94rpx, 70rpx) scale(.46) rotate(8deg); }
}
@keyframes bubble-drop-4 {
  0% { opacity: 0; transform: translate(0, 0) scale(.25); }
  26% { opacity: .9; transform: translate(-40rpx, 26rpx) scale(1); }
  100% { opacity: 0; transform: translate(-86rpx, 66rpx) scale(.52) rotate(-10deg); }
}

/* ===== 删除动画 v4：卡片被柔软地擦除，不再炸成水滴 ===== */
.burst-layer { display: none !important; }

.bubble-bursting {
  position: relative !important;
  overflow: hidden !important;
  pointer-events: none;
  z-index: 30;
  animation: erase-card-away .56s cubic-bezier(.22, .72, .26, 1) 0s both !important;
  animation-delay: 0s !important;
}

@keyframes erase-card-away {
  0% { opacity: 1; transform: translateY(0) scale(1); box-shadow: 9rpx 10rpx 0 var(--shadow); }
  14% { opacity: 1; transform: translateY(-3rpx) scale(1.004); box-shadow: 7rpx 8rpx 0 var(--shadow); }
  62% { opacity: 1; transform: translateY(-1rpx) scale(1); }
  82% { opacity: .92; transform: translateY(1rpx) scale(.992); }
  100% { opacity: 0; transform: translateY(4rpx) scale(.982); box-shadow: 2rpx 3rpx 0 var(--shadow); }
}

/* 一层和卡片同色的软边覆盖从右往左推进，像轻轻擦掉整张卡片 */
.bubble-bursting::before {
  content: "";
  position: absolute;
  z-index: 9;
  top: -3rpx;
  bottom: -3rpx;
  right: -3rpx;
  width: 0;
  background: inherit;
  border-radius: inherit;
  box-shadow: -12rpx 0 18rpx rgba(13, 39, 58, .12);
  pointer-events: none;
  animation: erase-wipe-away .56s cubic-bezier(.42, 0, .22, 1) both;
}

@keyframes erase-wipe-away {
  0%, 14% { width: 0; }
  66% { width: calc(100% + 8rpx); }
  100% { width: calc(100% + 8rpx); }
}

/* 顶栏返回按钮：实心箭头，替换原来的品牌 logo */
.back-icon { font-size: 0; font-weight: 500; color: var(--ink); transition: transform .14s ease, opacity .14s ease; }
.back-icon::before {
  content: "";
  display: block;
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-radius: 2rpx;
  transform: translate(3rpx, -1rpx) rotate(45deg);
}
.back-icon:active { transform: scale(.9); opacity: .85; }

/* ===== 全站涂鸦按钮皮肤：沿用模块时长滑杆的粗描边、圆润胶囊与一点光泽 ===== */
/* 覆盖全站按钮；步进器内 −/＋ 在下方单独还原 */
button,
.mode-capsule,
.add-module-plus,
.home-feature-add,
.template-plus,
.template-save {
  border: 3rpx solid var(--edge) !important;
  border-radius: 999rpx 982rpx 999rpx 974rpx !important;
  background-image:
    radial-gradient(ellipse at 24% 10%, rgba(255, 255, 255, .28) 0%, rgba(255, 255, 255, .09) 24%, rgba(255, 255, 255, 0) 46%),
    linear-gradient(180deg, rgba(255, 255, 255, .08) 0%, rgba(255, 255, 255, 0) 40%, rgba(0, 0, 0, .03) 100%) !important;
  background-repeat: no-repeat !important;
  background-size: 100% 100% !important;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, .20),
    inset 0 -2rpx 0 rgba(0, 0, 0, .035),
    2rpx 3rpx 0 var(--shadow-soft) !important;
}

button:active,
.mode-capsule:active,
.add-module-plus:active,
.home-feature-add:active,
.template-plus:active,
.template-save:active {
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, .18),
    inset 0 -2rpx 0 rgba(0, 0, 0, .03),
    1rpx 2rpx 0 var(--shadow-soft) !important;
}

/* 正/倒计时切换胶囊的蓝色滑块也带一点高光 */
.mode-thumb {
  background-image:
    radial-gradient(ellipse at 24% 10%, rgba(255, 255, 255, .26) 0%, rgba(255, 255, 255, .08) 26%, rgba(255, 255, 255, 0) 48%),
    linear-gradient(180deg, rgba(255, 255, 255, .07) 0%, rgba(255, 255, 255, 0) 42%, rgba(0, 0, 0, .03) 100%) !important;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .18), inset 0 -2rpx 0 rgba(0, 0, 0, .03);
}

/* 圆形主按钮保持圆形，不因胶囊圆角变形 */
.delete-button,
.prev-button,
.pause-button,
.complete-button,
.add-module-plus,
.home-feature-add,
.template-plus {
  border-radius: 50% 48% 52% 49% !important;
}

/* 步进器 −/＋ 保持嵌在时长胶囊里，不被全站按钮皮肤切开 */
button.round-small {
  border: 0 !important;
  border-radius: 0 !important;
  background-image: none !important;
  box-shadow: none !important;
}
button.round-small:first-child { border-radius: 999rpx 0 0 999rpx !important; }
button.round-small:last-child { border-radius: 0 999rpx 999rpx 0 !important; }

/* ===== 铅笔手绘主题：纸面、铅笔线、淡彩与轻微手绘偏移 ===== */
.theme-sketch {
  background-color: var(--bg) !important;
  background-image:
    radial-gradient(rgba(59, 56, 50, .035) 0, rgba(59, 56, 50, .035) .7rpx, transparent .8rpx),
    radial-gradient(rgba(59, 56, 50, .022) 0, rgba(59, 56, 50, .022) .8rpx, transparent .9rpx),
    linear-gradient(180deg, rgba(255, 255, 255, .05) 0%, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0) 100%) !important;
  background-size: 16rpx 16rpx, 28rpx 24rpx, 100% 100% !important;
  background-position: 0 0, 9rpx 11rpx, 0 0 !important;
}

/* 纸张横线上的标题栏 */
.theme-sketch .topbar {
  background-image: repeating-linear-gradient(180deg, rgba(59, 56, 50, .035) 0, rgba(59, 56, 50, .035) 1rpx, transparent 1rpx, transparent 7rpx);
  border-bottom: 3rpx solid var(--edge);
}

/* 所有卡片统一成略带手绘偏移的纸卡 */
.theme-sketch .hero-card,
.theme-sketch .progress-card,
.theme-sketch .timer-card,
.theme-sketch .module-card,
.theme-sketch .completion-card,
.theme-sketch .insight-card,
.theme-sketch .compare-card,
.theme-sketch .history-card,
.theme-sketch .template-card,
.theme-sketch .tool-tile,
.theme-sketch .quick-feature,
.theme-sketch .todo-preview-row,
.theme-sketch .important-tool-item,
.theme-sketch .important-card,
.theme-sketch .todo-item,
.theme-sketch .metric-card,
.theme-sketch .clock-preview,
.theme-sketch .clock-style-card,
.theme-sketch .modal-card,
.theme-sketch .sheet,
.theme-sketch .theme-card,
.theme-sketch .sched-card,
.theme-sketch .home-todo-card,
.theme-sketch .home-cd-card,
.theme-sketch .home-feature-important-card,
.theme-sketch .empty-card,
.theme-sketch .opt,
.theme-sketch .habit-tile,
.theme-sketch .rp3-summary,
.theme-sketch .rp3-card,
.theme-sketch .rp3-module-card,
.theme-sketch .rp3-brand-card {
  border-width: 3rpx;
  border-color: var(--edge);
  border-radius: 28rpx 22rpx 30rpx 24rpx;
  box-shadow: 2rpx 3rpx 0 var(--shadow-soft);
}

/* 按钮与胶囊：铅笔斜线排线，保留手绘轮廓但去掉亮面 */
.theme-sketch button,
.theme-sketch .mode-capsule,
.theme-sketch .add-module-plus,
.theme-sketch .home-feature-add,
.theme-sketch .template-plus,
.theme-sketch .template-save {
  border-width: 2.5rpx !important;
  background-image:
    repeating-linear-gradient(-45deg, rgba(59, 56, 50, .055) 0, rgba(59, 56, 50, .055) 1rpx, transparent 1rpx, transparent 7rpx),
    radial-gradient(ellipse at 24% 10%, rgba(255, 255, 255, .14) 0%, rgba(255, 255, 255, 0) 42%),
    linear-gradient(180deg, rgba(255, 255, 255, .04) 0%, rgba(0, 0, 0, .025) 100%) !important;
  box-shadow:
    inset 0 1.5rpx 0 rgba(255, 255, 255, .16),
    1.5rpx 2rpx 0 var(--shadow-soft) !important;
}
.theme-sketch button.round-small {
  border: 0 !important;
  background-image: none !important;
  box-shadow: none !important;
}
.theme-sketch .mode-thumb {
  background-image:
    repeating-linear-gradient(-45deg, rgba(34, 49, 61, .06) 0, rgba(34, 49, 61, .06) 1rpx, transparent 1rpx, transparent 7rpx),
    radial-gradient(ellipse at 24% 10%, rgba(255, 255, 255, .16) 0%, rgba(255, 255, 255, 0) 44%) !important;
}

/* 输入框做成纸上横线格 */
.theme-sketch .modal-input,
.theme-sketch .custom-name,
.theme-sketch .sheet-textarea {
  border: 2.5rpx solid var(--edge);
  border-radius: 14rpx 18rpx 16rpx 20rpx;
  background-image: repeating-linear-gradient(180deg, transparent 0, transparent 45rpx, rgba(59, 56, 50, .07) 45rpx, rgba(59, 56, 50, .07) 46rpx);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, .35);
}

/* 数据色条也加一点排线，保持图纸感 */
.theme-sketch .rp3-compare-fill,
.theme-sketch .rp3-dist-seg,
.theme-sketch .progress-fill {
  background-image: repeating-linear-gradient(-45deg, rgba(255, 255, 255, .10) 0, rgba(255, 255, 255, .10) 2rpx, transparent 2rpx, transparent 7rpx);
}

.theme-sketch .theme-card.active {
  border-color: var(--primary-2);
  box-shadow: 3rpx 4rpx 0 var(--shadow);
}

/* 返回键热区置顶，避免被浮层或滚动区域吃掉点击 */
.back-icon {
  position: relative;
  z-index: 8;
  -webkit-tap-highlight-color: transparent;
}
.back-icon::before { pointer-events: none; }

/* ===== 桌面 / 大屏自适应 =====
 * 窗口变宽后 rpx 会跟着放大，页面不再无限拉宽：
 * 内容收进中央一列（与屏幕边缘保留留白），组件各自回到自己的位置，
 * 不会因为窗口变大而挤成一团或被横向拉长。
 */
.desk {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  box-sizing: border-box;
  /* 兜底：限宽后两侧留白靠这圈超大扩散的底色填平，
   * 即使 ::before 在个别页面被层叠上下文吃掉，也不会露出 app.json 的默认底色 */
  box-shadow: 0 0 0 100vmax var(--bg);
}
/* 桌面内容列限宽 1280 后，两侧留白会露出 app.json 里写死的默认底色，
 * 切换主题时只有中间那列变色、边缘不变。这里铺一层整屏主题底色兜住四边。
 * 用 fixed 而不是给根节点撑宽，避免影响各页已算好的滚动高度。 */
.desk::before {
  content: "";
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: -1;
  background: var(--bg);
  pointer-events: none;
}
.desk .page-content { max-width: 100%; }

/* ===== 桌面 / 大屏：顶栏锁在手机档高度，不再随窗口等比放大 =====
 * rpx 会跟着窗口宽度放大，179rpx 的顶栏在 1700px 窗口里能撑到 400px，
 * 这里直接用 px 钉死，并撑满视口宽（不受内容列限宽影响）。
 */
.desk .topbar {
  width: 100vw;
  margin-left: calc((100% - 100vw) / 2);
  height: 84px;
  padding: 34px 14px 0;
  gap: 7px;
  border-bottom-width: 2px;
}
.desk .topbar-title { font-size: 18px; letter-spacing: 1px; }
.desk .back-icon {
  flex: 0 0 36px;
  width: 36px !important;
  min-width: 36px !important;
  max-width: 36px;
  height: 32px;
  font-size: 30px;
}
.desk .topbar-spacer,
.desk .topbar-brand-slot { flex: 0 0 36px; width: 36px; height: 32px; }

/* ===== 桌面 / 大屏：滚动区高度按「px 底栏 + 安全区」精确计算 =====
 * 原来按 286rpx 预留，rpx 被放大后会算错，底部露出一条空白带。
 * 桌面底栏实际高度是 52px 外加安全区，这里两者都扣掉；
 * 无 tabBar 的页面直接占满一屏。
 */
/* 有底栏的页面：滚动区一路铺到窗口底边，底栏（不透明主题色）压在上面。
 * 之前是「扣掉 52px + 安全区」把滚动区截断在底栏上方，一旦实际底栏比这个估算高，
 * 截断线就会浮在底栏上方，露出一条画不出内容的死白带，最后一张卡还被切掉半截。
 * 现在改成整屏高 + 用内距把内容抬到底栏之上，滚到末尾最后一张卡能完整露出来。 */
.desk.app .config-scroll,
.desk.app .report-scroll,
.desk.tools-page .tools-body,
.desk.history-page .history-body {
  height: 100vh !important;
  box-sizing: border-box;
}
/* 内容末尾只给底栏（52px + 安全区）和 8px 呼吸位留净空；
 * 原来再叠 28px，滚到末尾会在底栏上方露出一整条背景空带。
 */
.desk.app .config-scroll {
  padding-bottom: calc(52px + env(safe-area-inset-bottom) + 8px) !important;
}
/* 工具 / 记录页没有这条背景带问题，保留原来的呼吸位，避开左下角浮层。 */
.desk.tools-page .tools-body,
.desk.history-page .history-body {
  padding-bottom: calc(52px + env(safe-area-inset-bottom) + 28px) !important;
}
.desk.stats-page .stats-body,
.desk.todo-page .todo-body,
.desk.imp-page .imp-body {
  height: 100vh !important;
  box-sizing: border-box;
}

/* ===== 桌面 / 大屏：通用弹窗（输入框与按钮属于控件，不随窗口放大）=====
 * 弹窗宽度收成一列（620px），输入框、取消/确定按钮全部回到手机档。
 */
.desk .modal-mask { padding: 0 22px; }
.desk .modal-card {
  max-width: 620px;
  margin: 0 auto;
  padding: 18px 16px 16px;
  border-width: 2px;
  border-radius: 17px;
  box-shadow: 4px 5px 0 var(--shadow);
}
.desk .modal-title { font-size: 18px; }
.desk .modal-desc { margin-top: 4px; font-size: 12px; }
.desk .modal-input {
  margin-top: 12px;
  height: 46px;
  padding: 0 12px;
  border-width: 1px;
  border-radius: 10px;
  font-size: 15px;
}
.desk .modal-actions { margin-top: 13px; gap: 9px; }
.desk .modal-cancel,
.desk .modal-confirm {
  padding: 11px 0;
  border-width: 1px;
  font-size: 14px;
}
.desk .modal-confirm { box-shadow: 2px 3px 0 var(--shadow); }

/* ===== 软键盘弹起时给 fixed 弹窗让位 =====
 * 弹层是 position: fixed 的，键盘弹起时不会跟页面一起上推，
 * 页面用 utils/keyboard.js 把键盘高度写进 --kb，这里把弹窗内容整体上移。
 * 用 !important 是因为各页 wxss 里的 `padding: 0 xx` 简写会覆盖 padding-bottom。 */
.modal-mask { padding-bottom: var(--kb, 0px) !important; }
