/* ===== 时钟皮肤（唯一改动入口） =====
 * 计时页（.clock-<style>）、快捷计时（.q-shell-<style>）、设置页预览（.q-shell-<style>）
 * 三种页面共用这套变量；每页只保留自己的尺寸与动画。
 * 想调某个时钟样式的配色/发光，改这里一处即可。
 */
.clock-flip,
.q-shell-flip {
  --clk-face: var(--cream-2);
  --clk-ink: var(--ink);
  --clk-line: var(--line-strong);
  --clk-accent: var(--accent-text);
}
.clock-blocks,
.q-shell-blocks {
  --clk-tile: var(--card);
  --clk-ink: var(--ink);
  --clk-line: var(--edge);
  --clk-deco: var(--line-strong);
}
.clock-led,
.q-shell-led {
  --clk-panel: var(--panel);
  --clk-panel-edge: var(--edge-deep);
  --clk-ink: var(--primary-2);
  --clk-glow: var(--primary-2);
}
.clock-outline,
.q-shell-outline {
  --clk-ink: var(--ink);
}
.clock-jelly,
.q-shell-jelly {
  --clk-ink: var(--ink);
  --clk-glow: var(--primary-2);
  --clk-fill: var(--primary);
}

/* ===== 共享外观：同一个 clockStyle 在计时页 / 快捷计时 / 设置预览里必须长得一样 =====
 * 这里只写「外观」：字体、字重、颜色、发光、描边、七段几何、牌面底色与描边色。
 * 尺寸（font-size / padding / 宽高）仍由各页自己定。
 * 选择器带页面根类（.timer-page / .quick-page / .settings-page），
 * 这样即使本文件在 wxss 顶部 @import，也能压过后面的页面级覆盖。
 */
.timer-page .clock-outline .plain-num,
.quick-page .q-shell-outline .q-plain-num,
.settings-page .q-shell-outline .q-plain-num {
  color: transparent;
  font-family: "Courier New", "Menlo", monospace;
  font-weight: 900;
  letter-spacing: 3rpx;
  -webkit-text-stroke: 4rpx var(--clk-ink);
}
.timer-page .clock-jelly .plain-num,
.quick-page .q-shell-jelly .q-plain-num,
.settings-page .q-shell-jelly .q-plain-num {
  color: var(--clk-fill, var(--primary));
  -webkit-text-stroke: 2rpx var(--clk-ink);
  text-shadow: 4rpx 5rpx 0 var(--clk-glow), 7rpx 8rpx 0 var(--clk-ink);
}

/* 毫秒读数：直接复用 q-plain-num 皮肤样式，只由 q-ms-inline 控制字号，
 * 不再单独写颜色/描边/投影，避免毫秒和主体看起来像两套字。 */

/* 积木方块：牌面底色 / 描边 / 投影两端共用 */
.timer-page .block-tile,
.quick-page .q-block-tile {
  background: var(--clk-tile);
  border: 3rpx solid var(--clk-line);
  border-radius: 12rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
}
.timer-page .block-num,
.timer-page .block-colon,
.quick-page .q-block-num,
.quick-page .q-block-colon {
  color: var(--clk-ink);
  font-family: "Courier New", "Menlo", monospace;
  font-weight: 900;
}

/* LED 灯：面板底色 + 七段几何两端共用（几何按百分比，跟着各页尺寸缩放） */
.timer-page .led-clock,
.quick-page .q-led-clock {
  background: var(--clk-panel);
  border: 2rpx solid var(--clk-panel-edge);
  box-shadow: inset 0 0 20rpx rgba(0, 0, 0, .32), 4rpx 5rpx 0 var(--shadow-soft);
}
.timer-page .led-seg,
.quick-page .q-led-seg { position: absolute; background: rgba(255, 255, 255, .10); border-radius: 3rpx; }
.timer-page .led-seg.on,
.quick-page .q-led-seg.on {
  background: var(--clk-glow);
  box-shadow: 0 0 6rpx var(--clk-glow), 0 0 14rpx var(--clk-glow);
}
.seg-a, .seg-d, .seg-g { left: 12%; width: 76%; height: 9%; }
.seg-a { top: 0; }
.seg-g { top: 45.5%; }
.seg-d { bottom: 0; }
.seg-b, .seg-c, .seg-e, .seg-f { width: 9%; height: 38%; }
.seg-f { top: 8%; left: 0; }
.seg-b { top: 8%; right: 0; }
.seg-e { bottom: 8%; left: 0; }
.seg-c { bottom: 8%; right: 0; }
.timer-page .led-dot,
.quick-page .q-led-dot {
  border-radius: 50%;
  background: var(--clk-glow);
  box-shadow: 0 0 6rpx var(--clk-glow), 0 0 13rpx var(--clk-glow);
}


/* ===== 贴纸数字：白字 + 深色描边 + 主色硬投影，浅底深底都清楚 ===== */
.clock-sticker,
.q-shell-sticker {
  --clk-ink: var(--ink);
  --clk-fill: var(--card);
  --clk-glow: var(--primary);
}
.timer-page .clock-sticker .plain-num,
.quick-page .q-shell-sticker .q-plain-num,
.settings-page .q-shell-sticker .q-plain-num {
  color: var(--clk-fill, var(--panel)) !important;
  -webkit-text-stroke: 2px var(--clk-ink) !important;
  font-family: "Arial Rounded MT Bold", "Yuanti SC", "PingFang SC", "Hiragino Sans GB", sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: 0 !important;
  text-shadow: 2px 3px 0 var(--clk-glow) !important;
}
/* 贴纸数字的毫秒跟随 q-plain-num，无需单独配色。 */

/* ==========================================================================
 * FINAL：8 种时钟样式在三页的唯一定义（基准 = 设置页预览）
 * 计时页 .timer-page.clock-<key> / 快捷计时 .q-clock-shell.q-shell-<key> /
 * 设置预览 .clock-preview-card / .clock-style-sample
 * 本段只覆盖「外观」：底色、边框、发光、字体、字重、字距、描边、投影。
 * 各页的 font-size / padding / 宽高仍由自己的 wxss 决定，不受本段影响，
 * 因此不会撑破计时页的等高槽，也不会改变设置预览的固定框。
 * ========================================================================== */

/* ---------- 1 翻页 flip：牌面统一由 components/flip-clock 负责，外壳一律透明 ---------- */
.quick-page .q-clock-shell.q-shell-flip,
.settings-page .clock-preview .clock-preview-card.q-shell-flip,
.settings-page .clock-style-card .clock-style-sample.q-shell-flip {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* ---------- 2 积木 blocks：奶白牌 + 深墨描边 + 硬投影 + 等宽深字 ---------- */
.timer-page .block-row .block-tile,
.quick-page .q-block-tile,
.settings-page .clock-block-tile {
  background: var(--card) !important;
  border: 2rpx solid var(--edge) !important;
  border-radius: 10rpx !important;
  box-shadow: 3rpx 3rpx 0 var(--shadow-soft) !important;
}
.timer-page .block-row .block-num,
.timer-page .block-row .block-colon,
.quick-page .q-block-num,
.quick-page .q-block-colon,
.settings-page .clock-block-num,
.settings-page .clock-block-colon {
  color: var(--ink) !important;
  font-family: "Courier New", "Menlo", monospace !important;
  font-weight: 900 !important;
  text-shadow: none !important;
}
.timer-page.clock-blocks .plain-clock,
.quick-page .q-clock-shell.q-shell-blocks,
.settings-page .clock-preview .clock-preview-card.q-shell-blocks,
.settings-page .clock-style-card .clock-style-sample.q-shell-blocks {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* ---------- 4 贴纸数字 sticker：奶白字 + 深墨描边 + 主色硬投影，外壳透明 ---------- */
.timer-page.clock-sticker .plain-clock,
.quick-page .q-clock-shell.q-shell-sticker,
.settings-page .clock-preview .clock-preview-card.q-shell-sticker,
.settings-page .clock-style-card .clock-style-sample.q-shell-sticker {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}
.timer-page.clock-sticker .plain-num,
.quick-page .q-clock-shell.q-shell-sticker .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-sticker .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-sticker .q-plain-num {
  color: var(--card) !important;
  -webkit-text-fill-color: var(--card) !important;
  -webkit-text-stroke: 2px var(--ink) !important;
  background-image: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  font-family: "Arial Rounded MT Bold", "Yuanti SC", "PingFang SC", "Hiragino Sans GB", sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: 0 !important;
  text-shadow: 2px 3px 0 var(--primary) !important;
}

/* ---------- 6 描边空心 outline：只画轮廓、中间留空，外壳一律无框 ---------- */
.timer-page.clock-outline .plain-clock,
.quick-page .q-clock-shell.q-shell-outline,
.settings-page .clock-preview .clock-preview-card.q-shell-outline,
.settings-page .clock-style-card .clock-style-sample.q-shell-outline {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.timer-page.clock-outline .plain-num,
.quick-page .q-clock-shell.q-shell-outline .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-outline .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-outline .q-plain-num {
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  -webkit-text-stroke: 2rpx var(--ink) !important;
  font-family: "PingFang SC", "Hiragino Sans GB", "Helvetica Neue", sans-serif !important;
  font-weight: 800 !important;
  letter-spacing: 2rpx !important;
  text-shadow: none !important;
  background-image: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
}
/* 描边空心的毫秒沿用 q-plain-num 的透明填充与同宽描边，不另写一套。 */

/* 桌面：字距/描边按 px 收，别被 rpx 放大（描边过粗会把空心填死）
 * 注意：计时页根节点不带 desk（它恒为 compact），所以计时页这批走媒体查询。 */
@media (min-width: 700px) {
  .timer-page.clock-outline .plain-num { -webkit-text-stroke-width: 1.5px !important; letter-spacing: 1px !important; }
}
.desk.quick-page .q-clock-shell.q-shell-outline .q-plain-num,
.desk.settings-page .clock-preview .clock-preview-card.q-shell-outline .q-plain-num,
.desk.settings-page .clock-style-card .clock-style-sample.q-shell-outline .q-plain-num { -webkit-text-stroke-width: 1.5px !important; letter-spacing: 1px !important; }

/* ---------- 8 果冻叠影 jelly：糖果色填充 + 深墨描边 + 双层错位投影 ---------- */
.timer-page.clock-jelly .plain-clock,
.quick-page .q-clock-shell.q-shell-jelly,
.settings-page .clock-preview .clock-preview-card.q-shell-jelly,
.settings-page .clock-style-card .clock-style-sample.q-shell-jelly {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}
.timer-page.clock-jelly .plain-num,
.quick-page .q-clock-shell.q-shell-jelly .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-jelly .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-jelly .q-plain-num {
  color: var(--primary) !important;
  -webkit-text-fill-color: var(--primary) !important;
  -webkit-text-stroke: 2rpx var(--edge) !important;
  background-image: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  font-family: "Arial Rounded MT Bold", "Yuanti SC", "PingFang SC", "Hiragino Sans GB", sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: 2rpx !important;
  text-shadow: 4rpx 5rpx 0 var(--primary-2), 7rpx 8rpx 0 var(--edge) !important;
}
/* 果冻叠影的毫秒沿用 q-plain-num 的双层错位投影，不再单独减配。 */

/* 贴纸数字的毫秒沿用 q-plain-num 的奶白字 + 深墨描边 + 主色投影。 */
/* ===== 桌面 / 大屏：果冻叠影的错位阴影改成 px =====
 * 原来错位量是 rpx（4/5 与 7/8），1700px 窗口下 1rpx≈2.3px，
 * 54px 的数字后面跟着 16px 的深色影子，看着像三份数字叠在一起。
 * 描边同理（2rpx 在宽屏会变成 4px 粗）。这里按手机档比例还原成 1–4px。
 */
.desk.timer-page.clock-jelly .plain-num,
.desk.quick-page .q-clock-shell.q-shell-jelly .q-plain-num,
.desk.settings-page .clock-preview .clock-preview-card.q-shell-jelly .q-plain-num,
.desk.settings-page .clock-style-card .clock-style-sample.q-shell-jelly .q-plain-num {
  -webkit-text-stroke-width: 1px !important;
  text-shadow: 2px 2px 0 var(--primary-2), 3px 4px 0 var(--edge) !important;
}

/* ==========================================================================
 * 新增三种手绘 / 果冻向皮肤（no frame：外壳一律透明无边框）
 * ========================================================================== */

/* ---------- 糖果手写 doodle：手写圆体 + 墨色描边 + 糖果色错位影子，不倾斜 ---------- */
.timer-page.clock-doodle .plain-clock,
.quick-page .q-clock-shell.q-shell-doodle,
.settings-page .clock-preview .clock-preview-card.q-shell-doodle,
.settings-page .clock-style-card .clock-style-sample.q-shell-doodle {
  background: transparent !important;
  background-image: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
  transform: none !important;
}
.timer-page.clock-doodle .plain-num,
.quick-page .q-clock-shell.q-shell-doodle .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-doodle .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-doodle .q-plain-num {
  color: var(--primary) !important;
  -webkit-text-fill-color: var(--primary) !important;
  -webkit-text-stroke: 3rpx var(--edge) !important;
  background-image: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  font-family: "Chalkboard SE", "Comic Sans MS", "Yuanti SC", "Arial Rounded MT Bold", "PingFang SC", sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: 1rpx !important;
  text-shadow: 5rpx 6rpx 0 var(--primary-3) !important;
  display: inline-block !important;
  transform: none !important;
}
/* 糖果手写的毫秒沿用 q-plain-num 的蓝字、墨色描边与错位影子。 */
.quick-page .q-clock-shell.q-shell-doodle .q-clock-ms { flex: 0 0 auto; min-width: 0; }
.quick-page .q-clock-shell.q-shell-doodle .q-ms-inline {
  flex: 0 0 auto;
  min-width: 2.1ch;
  color: var(--primary) !important;
  -webkit-text-fill-color: var(--primary) !important;
  background-image: none !important;
  -webkit-text-stroke: 3rpx var(--edge) !important;
  text-shadow: 3rpx 4rpx 0 var(--primary-3) !important;
}

/* ---------- 奶糖手写 stamp：深可可手写字 + 单层奶糖暖影，无外壳不倾斜 ---------- */
.timer-page.clock-stamp .plain-clock,
.quick-page .q-clock-shell.q-shell-stamp,
.settings-page .clock-preview .clock-preview-card.q-shell-stamp,
.settings-page .clock-style-card .clock-style-sample.q-shell-stamp {
  background: transparent !important;
  background-image: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
  transform: none !important;
}
.timer-page.clock-stamp .plain-num,
.quick-page .q-clock-shell.q-shell-stamp .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-stamp .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-stamp .q-plain-num {
  color: var(--ink) !important;
  -webkit-text-fill-color: var(--ink) !important;
  -webkit-text-stroke: 0 !important;
  background-image: none !important;
  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;
  font-family: "Chalkboard SE", "Comic Sans MS", "Yuanti SC", "Arial Rounded MT Bold", "PingFang SC", sans-serif !important;
  font-weight: 800 !important;
  letter-spacing: 3rpx !important;
  text-shadow: 2rpx 2rpx 0 rgba(255, 255, 255, .55), 4rpx 5rpx 0 var(--primary-3) !important;
  display: inline-block !important;
  transform: none !important;
}
/* 奶糖手写的毫秒沿用 q-plain-num 的深可可字与暖影。 */
.quick-page .q-clock-shell.q-shell-stamp .q-clock-ms { flex: 0 0 auto; min-width: 0; gap: 2rpx; }

/* 设置页预览框是整宽固定卡，旋转外壳会切角；这里只让字歪，边框保持水平 */
.settings-page .clock-preview .clock-preview-card.q-shell-doodle,
.settings-page .clock-style-card .clock-style-sample.q-shell-doodle,
.settings-page .clock-preview .clock-preview-card.q-shell-stamp,
.settings-page .clock-style-card .clock-style-sample.q-shell-stamp {
  transform: none !important;
}

/* ---------- 果冻弹跳 jellypop：主色果冻 + 奶白高光带 + 描边 + 轻微弹动 ---------- */
.timer-page.clock-jellypop .plain-clock,
.quick-page .q-clock-shell.q-shell-jellypop,
.settings-page .clock-preview .clock-preview-card.q-shell-jellypop,
.settings-page .clock-style-card .clock-style-sample.q-shell-jellypop {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}
.timer-page.clock-jellypop .plain-num,
.quick-page .q-clock-shell.q-shell-jellypop .q-plain-num,
.settings-page .clock-preview .clock-preview-card.q-shell-jellypop .q-plain-num,
.settings-page .clock-style-card .clock-style-sample.q-shell-jellypop .q-plain-num {
  color: transparent !important;
  -webkit-text-fill-color: transparent !important;
  background-image: linear-gradient(168deg, var(--primary) 0%, var(--primary) 36%, rgba(255, 255, 255, .92) 47%, var(--primary) 60%, var(--primary-2) 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  -webkit-text-stroke: 2rpx var(--edge) !important;
  font-family: "Arial Rounded MT Bold", "Yuanti SC", "PingFang SC", "Hiragino Sans GB", sans-serif !important;
  font-weight: 800 !important;
  letter-spacing: 1rpx !important;
  text-shadow: none !important;
  display: inline-block !important;
  transform-origin: 50% 100% !important;
  animation: clk-jellypop 2.8s ease-in-out infinite !important;
}
/* 果冻弹跳的毫秒沿用 q-plain-num 的渐变填充、描边和弹动。 */

@keyframes clk-jellypop {
  0%, 100% { transform: scale(1, 1); }
  42% { transform: scale(1.035, .945); }
  68% { transform: scale(.992, 1.018); }
}


/* ---------- 设置页深色预览卡（--panel 底）里换成浅色墨，否则深字压在深底上看不见 ---------- */
/* 设置页大预览与列表小卡统一走基础配色，避免同一皮肤两处颜色不一致 */
.settings-page .clock-preview .clock-preview-card.q-shell-stamp .q-plain-num {
  color: var(--ink) !important;
  -webkit-text-fill-color: var(--ink) !important;
  -webkit-text-stroke: 0 !important;
  text-shadow: 3rpx 4rpx 0 var(--primary-3) !important;
}
.settings-page .clock-preview .clock-preview-card.q-shell-jellypop .q-plain-num {
  -webkit-text-stroke: 2rpx var(--on-panel) !important;
  background-image: linear-gradient(168deg, var(--on-panel-warm) 0%, var(--on-panel-warm) 36%, rgba(255, 255, 255, .96) 47%, var(--on-panel-warm) 60%, var(--primary-2) 100%) !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
}

/* 桌面 / 宽窗口：描边与投影改成 px，别被 rpx 放大成粗黑边 */
@media (min-width: 700px) {
  .timer-page.clock-doodle .plain-num {
    -webkit-text-stroke-width: 2px !important;
    text-shadow: 4px 5px 0 var(--primary-3) !important;
  }
  .timer-page.clock-stamp .plain-num {
    -webkit-text-stroke-width: 0 !important;
    text-shadow: 2px 3px 0 var(--primary-3) !important;
  }
  .timer-page.clock-jellypop .plain-num { -webkit-text-stroke-width: 1px !important; }
  .timer-page.clock-doodle .plain-clock,
  .desk.quick-page .q-clock-shell.q-shell-doodle,
  .desk.settings-page .clock-preview .clock-preview-card.q-shell-doodle,
  .desk.settings-page .clock-style-card .clock-style-sample.q-shell-doodle {
    padding: 0 !important;
  }
  .timer-page.clock-stamp .plain-clock,
  .desk.quick-page .q-clock-shell.q-shell-stamp,
  .desk.settings-page .clock-preview .clock-preview-card.q-shell-stamp,
  .desk.settings-page .clock-style-card .clock-style-sample.q-shell-stamp {
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
