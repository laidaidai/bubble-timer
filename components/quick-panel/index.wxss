/* 首页「固定」面板：直接复用快捷计时页的整份样式，不另写一套 */
@import "../../pages/quick/quick.wxss";

/* 嵌进首页时不要占满整屏，也不抢背景 */
.quick-page.qp-embed {
  height: 62vh;
  min-height: 320px;
  max-height: 620px;
  background: transparent;
  overflow: visible;
}
.quick-page.qp-embed .quick-tabs { margin: 0 0 12rpx; }
.quick-page.qp-embed .quick-body { padding: 0 0 8rpx; }
.quick-page.qp-embed.desk { height: 460px; max-height: none; }
.qp-embed.desk .quick-tabs { margin: 0 0 10px; }
.qp-embed.desk .quick-body { padding: 0 0 6px; }

/* 嵌进首页后不再撑满一屏：随内容长高，交给首页自己的滚动，避免内容被面板裁掉 */
.quick-page.qp-embed { height: auto; max-height: none; }
.qp-embed .quick-body { flex: 0 0 auto; overflow: visible; padding-bottom: 8rpx !important; }
.qp-embed .quick-clock-card { flex: 0 0 auto; }
.qp-embed .quick-clock-stage { flex: 0 0 auto; min-height: 0; }
.qp-embed .time-picker { max-height: 30vh; }
/* 首页里按钮跟着面板走，不再悬浮到屏幕底部 */
.qp-embed .quick-actions { position: static; left: auto; right: auto; bottom: auto; z-index: auto; padding: 0; margin-top: 14rpx; }
/* 时钟本体也不许越出面板：夹在面板宽度内，超出就裁在面板里而不是溢出屏幕 */
.qp-embed .quick-clock-stage { width: 100%; overflow: hidden; }
.qp-embed .clock-display { max-width: 100%; }
