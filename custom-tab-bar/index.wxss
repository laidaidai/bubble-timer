.tabbar {
  position: fixed;
  box-shadow: 0 -8rpx 24rpx rgba(31, 31, 31, .05);
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  border-top: 1rpx solid rgba(31, 31, 31, .06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.tabbar-inner {
  height: 100rpx;
  display: flex;
  align-items: stretch;
}
.tab-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}
.tab-item.active .tab-label { font-weight: 900; }
.tab-icon-wrap { height: 38rpx; display: flex; align-items: center; justify-content: center; transition: transform .16s ease; }
.tab-item.active .tab-icon-wrap { animation: dock-bounce .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.tab-item:active .tab-icon-wrap { transform: scale(.88); }
.tab-label { transition: color .18s ease, transform .18s ease; }
.tab-item.active .tab-label { transform: translateY(1rpx); }
.icon-home { position: relative; width: 38rpx; height: 36rpx; }
.home-roof { position: absolute; left: 50%; top: 1rpx; width: 25rpx; height: 25rpx; box-sizing: border-box; border-left: 3rpx solid; border-top: 3rpx solid; border-radius: 3rpx 0 0 0; transform: translateX(-50%) rotate(45deg); }
.home-body { position: absolute; left: 50%; bottom: 0; width: 34rpx; height: 25rpx; box-sizing: border-box; border: 3rpx solid; border-top: 0; border-radius: 0 0 6rpx 6rpx; transform: translateX(-50%); }
.home-door { position: absolute; left: 50%; bottom: 0; width: 10rpx; height: 14rpx; border-radius: 4rpx 4rpx 0 0; transform: translateX(-50%); }
.icon-timer {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 2rpx solid;
  border-radius: 50%;
}
.icon-tools {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.tool-sq { width: 16rpx; height: 16rpx; box-sizing: border-box; border: 2rpx solid; border-radius: 4rpx; }
.icon-records {
  width: 34rpx;
  height: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5rpx;
}
.rec-line { height: 2rpx; border-radius: 2rpx; }
.rec-line.long { width: 34rpx; }
.rec-line.mid { width: 26rpx; }
.rec-line.short { width: 18rpx; }
.tab-label { font-size: 20rpx; line-height: 1.2; font-weight: 800; }

@keyframes dock-bounce { 0% { transform: scale(.82); } 55% { transform: scale(1.12); } 100% { transform: scale(1); } }

/* ===== 桌面 / 大屏：底栏回到手机尺寸，只占总内容上方一小条 ===== */
.tabbar.desk-bar { border-top-width: 1px; box-shadow: 0 -2px 8px rgba(31, 31, 31, .05); }
.tabbar.desk-bar .tabbar-inner { height: 52px; }
.tabbar.desk-bar .tab-item { gap: 3px; }
.tabbar.desk-bar .tab-icon-wrap { height: 20px; }
.tabbar.desk-bar .tab-label { font-size: 11px; }
.tabbar.desk-bar .icon-home { width: 19px; height: 18px; }
.tabbar.desk-bar .home-roof { top: 1px; width: 13px; height: 13px; border-left-width: 2px; border-top-width: 2px; border-radius: 2px 0 0 0; }
.tabbar.desk-bar .home-body { width: 17px; height: 13px; border-width: 2px; border-top-width: 0; border-radius: 0 0 3px 3px; }
.tabbar.desk-bar .home-door { width: 5px; height: 7px; border-radius: 2px 2px 0 0; }
.tabbar.desk-bar .icon-tools { width: 18px; height: 18px; gap: 2px; }
.tabbar.desk-bar .tool-sq { width: 8px; height: 8px; border-width: 1px; border-radius: 2px; }
.tabbar.desk-bar .icon-records { width: 17px; height: 15px; gap: 2px; }
.tabbar.desk-bar .rec-line { height: 1px; border-radius: 1px; }
.tabbar.desk-bar .rec-line.long { width: 17px; }
.tabbar.desk-bar .rec-line.mid { width: 13px; }
.tabbar.desk-bar .rec-line.short { width: 9px; }
