.train-page { min-height: 100vh; background: var(--bg); color: var(--ink); }
.train-body { padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }

/* 目标时间 */
.train-hero { padding: 24rpx 26rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 26rpx; box-shadow: 5rpx 6rpx 0 var(--shadow); }
.train-eyebrow { color: var(--text-warm); font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; }
.train-total { margin-top: 8rpx; display: flex; align-items: baseline; }
.train-total .num { font-size: 64rpx; font-weight: 900; line-height: 1; }
.train-unit { margin-left: 8rpx; font-size: 26rpx; font-weight: 900; }
.train-count { margin-left: auto; color: var(--text-3); font-size: 21rpx; font-weight: 700; }

/* 模块列表 */
.train-list { margin-top: 22rpx; display: flex; flex-direction: column; gap: 14rpx; }
.train-module { display: flex; align-items: center; gap: 14rpx; padding: 18rpx 18rpx 18rpx 22rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.train-module-main { flex: 1; min-width: 0; }
.train-name { width: 100%; height: 46rpx; color: var(--ink); font-size: 27rpx; font-weight: 900; }
.train-stepper { margin-top: 12rpx; display: flex; align-items: center; gap: 12rpx; }
.train-step { flex: 0 0 60rpx; width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 50%; font-size: 32rpx; font-weight: 900; line-height: 1; }
.train-step:active { transform: scale(.94); }
.train-minutes { flex: 0 0 96rpx; width: 96rpx; height: 60rpx; padding: 0 8rpx; text-align: center; color: var(--ink); background: var(--cream-2); border: 2rpx solid var(--edge); border-radius: 14rpx; font-size: 27rpx; font-weight: 900; }
.train-min-unit { color: var(--text-3); font-size: 20rpx; font-weight: 700; }

.train-del { flex: 0 0 56rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; color: var(--text-3); background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 50%; font-size: 30rpx; font-weight: 900; line-height: 1; }

.train-empty { padding: 44rpx 20rpx; color: var(--text-3); text-align: center; background: var(--card); border: 2rpx dashed var(--line-strong); border-radius: 22rpx; font-size: 23rpx; }
.train-add { padding: 24rpx; color: var(--text-mid); text-align: center; background: var(--cream-1); border: 2rpx dashed var(--line-strong); border-radius: 22rpx; font-size: 24rpx; font-weight: 800; }
.train-add:active { opacity: .8; }

/* 开始 */
.train-start { margin-top: 30rpx; box-sizing: border-box; width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; color: var(--on-primary); background: var(--primary); border: 3rpx solid var(--edge); border-radius: 999rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); font-size: 30rpx; font-weight: 900; line-height: 1; }
.train-start::after { border: 0; }
.train-start:active { transform: translateY(2rpx); box-shadow: 4rpx 5rpx 0 var(--shadow); }
.train-start.is-disabled { opacity: .55; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.train-play { margin-left: 10rpx; font-size: 24rpx; }

/* 桌面：rpx 会被放大，顶栏换成 px 小头 */
.train-desk-head { display: flex; align-items: center; max-width: 620px; margin: 0 auto; padding: 18px 0 4px; }
.train-desk-back { flex: 0 0 auto; padding: 6px 14px; color: var(--ink); background: var(--cream-1); border: 2px solid var(--edge); border-radius: 999px; box-shadow: 2px 3px 0 var(--shadow-soft); font-size: 13px; font-weight: 800; }
.train-desk-back:active { transform: translateY(1px); box-shadow: 1px 2px 0 var(--shadow-soft); }
.train-desk-title { flex: 1; color: var(--ink); text-align: center; font-size: 17px; font-weight: 900; letter-spacing: 1px; }
.train-desk-gap { flex: 0 0 76px; width: 76px; }

/* 桌面 / 大屏：限宽居中，换 px 档，避免 rpx 被放大成巨物 */
.train-page.desk .train-body { max-width: 620px; margin: 0 auto; padding: 24px 0 40px; }
.train-page.desk .train-hero { padding: 20px 22px; border-radius: 20px; box-shadow: 4px 5px 0 var(--shadow); }
.train-page.desk .train-eyebrow { font-size: 13px; }
.train-page.desk .train-total .num { font-size: 46px; }
.train-page.desk .train-unit { font-size: 16px; }
.train-page.desk .train-count { font-size: 13px; }
.train-page.desk .train-list { margin-top: 16px; gap: 10px; }
.train-page.desk .train-module { padding: 12px 14px 12px 16px; border-radius: 16px; box-shadow: 3px 4px 0 var(--shadow-soft); }
.train-page.desk .train-name { height: 28px; font-size: 16px; }
.train-page.desk .train-stepper { margin-top: 8px; gap: 10px; }
.train-page.desk .train-step { flex-basis: 40px; width: 40px; height: 40px; font-size: 22px; }
.train-page.desk .train-minutes { flex-basis: 64px; width: 64px; height: 40px; font-size: 17px; border-radius: 10px; }
.train-page.desk .train-min-unit { font-size: 13px; }
.train-page.desk .train-del { flex-basis: 36px; width: 36px; height: 36px; font-size: 20px; }
.train-page.desk .train-empty { padding: 30px 16px; font-size: 14px; border-radius: 16px; }
.train-page.desk .train-add { padding: 14px; font-size: 15px; border-radius: 16px; }
.train-page.desk .train-start { margin-top: 22px; height: 54px; border-radius: 999px; box-shadow: 4px 5px 0 var(--shadow); font-size: 18px; }
.train-page.desk .train-play { font-size: 14px; }
