page { height: 100%; background: var(--bg); }
.blank-page { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--bg); }
.blank-page.leaving { animation: blank-fade-out .2s ease-in forwards; }

.blank-loader { position: relative; width: 200rpx; height: 200rpx; display: flex; align-items: center; justify-content: center; animation: blank-stage-in .48s cubic-bezier(.2, .9, .3, 1.15) both; }
.blank-logo { position: relative; z-index: 2; width: 150rpx; height: 150rpx; animation: blank-logo-in .56s cubic-bezier(.2, .9, .3, 1.25) both, blank-logo-breathe 1.7s .56s ease-in-out infinite; }
.blank-ring { position: absolute; top: 8rpx; right: 8rpx; bottom: 8rpx; left: 8rpx; border: 2rpx solid var(--line-strong); border-radius: 50%; opacity: .55; animation: blank-ring-spin 2.4s linear infinite; }
.blank-bubble { position: absolute; z-index: 3; width: 26rpx; height: 26rpx; box-sizing: border-box; border: 2rpx solid var(--edge); border-radius: 50%; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); animation: blank-bubble-bob 1.15s ease-in-out infinite; }
.blank-bubble.b1 { top: 8rpx; left: 87rpx; background: var(--primary); animation-delay: 0s; }
.blank-bubble.b2 { left: 10rpx; bottom: 38rpx; background: var(--primary-2); animation-delay: -.38s; }
.blank-bubble.b3 { right: 10rpx; bottom: 38rpx; background: var(--card); animation-delay: -.76s; }

@keyframes blank-ring-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
@keyframes blank-bubble-bob {
  0%, 100% { transform: translateY(0) scale(.82); opacity: .55; }
  50% { transform: translateY(-16rpx) scale(1.12); opacity: 1; }
}
@keyframes blank-stage-in {
  0% { opacity: 0; transform: scale(.82); }
  65% { opacity: 1; transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes blank-logo-in {
  0% { opacity: 0; transform: scale(.65) rotate(-5deg); }
  60% { opacity: 1; transform: scale(1.08) rotate(2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
@keyframes blank-logo-breathe {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-6rpx) scale(1.03); }
}
@keyframes blank-fade-out { from { opacity: 1; } to { opacity: 0; } }
