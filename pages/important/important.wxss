.imp-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--ink);
  overflow: hidden;
  animation: app-page-fade .24s ease-out both;
}

.imp-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 22rpx 24rpx 0;
  overflow-y: auto;
}

.imp-add {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--ink);
  background: var(--primary);
  border: 3rpx solid var(--edge);
  border-radius: 999rpx;
  box-shadow: 5rpx 6rpx 0 var(--shadow);
  font-size: 25rpx;
  font-weight: 900;
}
.imp-add:active { transform: translate(2rpx, 2rpx); box-shadow: 2rpx 3rpx 0 var(--shadow); }
.imp-add-plus {
  position: relative;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  background: var(--cream-1);
  border: 2rpx solid var(--edge);
  border-radius: 50%;
}
.imp-add-plus::before, .imp-add-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--ink);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}
.imp-add-plus::before { width: 16rpx; height: 3rpx; }
.imp-add-plus::after { width: 3rpx; height: 16rpx; }

.imp-list { margin-top: 22rpx; display: flex; flex-direction: column; gap: 14rpx; }

/* 条目与首页待办行同一套：白卡 + 2rpx 浅描边 + 18rpx 圆角 + 空心小圆点 + 右侧时间 */
.imp-row {
  box-sizing: border-box;
  width: 100%;
  min-height: 84rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 18rpx;
}
.imp-row:active { transform: translate(1rpx, 1rpx); }
.imp-row.past { opacity: .55; }
.imp-dot {
  flex: 0 0 14rpx;
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line-strong);
  border-radius: 50%;
}
.imp-dot.soon { background: var(--primary); border-color: var(--primary); }
.imp-row.past { opacity: .55; }
.imp-row:not(.bubble-bursting) { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.imp-row:nth-child(2) { animation-delay: .05s; }
.imp-row:nth-child(3) { animation-delay: .10s; }
.imp-row:nth-child(n+4) { animation-delay: .15s; }

.imp-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.imp-title-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.imp-name {
  min-width: 0;
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.imp-yearly {
  flex: 0 0 auto;
  padding: 2rpx 10rpx;
  color: var(--text-mid);
  background: var(--cream-2);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}
.imp-date { color: var(--text-3); font-size: 19rpx; font-weight: 700; letter-spacing: 0; }

.imp-count { flex: 0 0 auto; color: var(--text-2); font-size: 19rpx; font-weight: 900; white-space: nowrap; }
.imp-unit { color: var(--text-2); font-size: 19rpx; font-weight: 900; }

.imp-empty {
  margin-top: 24rpx;
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: var(--cream-1);
  border: 3rpx dashed var(--line-strong);
  border-radius: 26rpx;
}
.imp-empty:active { opacity: .72; }
.imp-empty-plus {
  position: relative;
  width: 82rpx;
  height: 82rpx;
  box-sizing: border-box;
  background: var(--primary);
  border: 3rpx solid var(--edge);
  border-radius: 50%;
  box-shadow: 4rpx 5rpx 0 var(--shadow);
}
.imp-empty-plus::before, .imp-empty-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--ink);
  border-radius: 3rpx;
  transform: translate(-50%, -50%);
}
.imp-empty-plus::before { width: 34rpx; height: 6rpx; }
.imp-empty-plus::after { width: 6rpx; height: 34rpx; }
.imp-empty-text { color: var(--text-2); font-size: 22rpx; font-weight: 800; }

/* ---- 添加 / 编辑弹层 ---- */
.modal-mask {
  position: fixed;
  z-index: 999;
  left: 0; right: 0; top: 0; bottom: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  background: rgba(20, 40, 56, .46);
}
.modal-card {
  box-sizing: border-box;
  width: 100%;
  padding: 30rpx 26rpx 26rpx;
  background: var(--card);
  border: 3rpx solid var(--edge);
  border-radius: 28rpx;
  box-shadow: 8rpx 9rpx 0 var(--shadow);
}
.important-modal { max-height: 86vh; overflow-y: auto; }
.modal-title { color: var(--ink); font-size: 32rpx; font-weight: 900; }
.modal-input {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  color: var(--ink);
  background: var(--cream-4);
  border: 2rpx solid var(--edge);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}
.important-form-row { margin-top: 14rpx; display: flex; align-items: stretch; gap: 10rpx; }
.important-date-btn {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx;
  background: var(--cream-4);
  border: 2rpx solid var(--edge);
  border-radius: 14rpx;
}
.important-date-btn.on { background: var(--accent-bg); }
.important-date-label { display: block; color: var(--text-2); font-size: 17rpx; font-weight: 700; }
.important-date-value { display: block; margin-top: 3rpx; color: var(--ink); font-size: 23rpx; font-weight: 900; }
.important-yearly {
  flex: 0 0 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  color: var(--text-mid);
  background: var(--cream-1);
  border: 2rpx solid var(--edge);
  border-radius: 14rpx;
  font-size: 18rpx;
  font-weight: 900;
}
.important-yearly.on { color: var(--on-primary); background: var(--primary); box-shadow: 3rpx 3rpx 0 var(--shadow); }

.important-calendar { margin-top: 12rpx; padding: 12rpx; background: var(--cream-4); border: 2rpx solid var(--line-strong); border-radius: 18rpx; }
.important-cal-head { display: flex; align-items: center; justify-content: space-between; }
.important-cal-nav { width: 52rpx; color: var(--text-mid); text-align: center; font-size: 28rpx; font-weight: 900; }
.important-cal-title { color: var(--ink); font-size: 22rpx; font-weight: 900; }
.important-cal-weekdays { margin-top: 8rpx; display: flex; gap: 5rpx; }
.important-cal-weekday { flex: 1; color: var(--text-3); text-align: center; font-size: 17rpx; font-weight: 800; }
.important-cal-row { width: 100%; min-width: 0; margin-top: 5rpx; display: flex; gap: 5rpx; }
.important-cal-cell {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
}
.important-cal-cell.empty { background: transparent; border-color: transparent; }
.important-cal-cell.today { color: var(--text-warm); border-color: var(--line-strong); }
.important-cal-cell.selected { color: var(--on-primary); background: var(--primary); border-color: var(--edge); box-shadow: 2rpx 2rpx 0 var(--shadow); }

.modal-actions { margin-top: 22rpx; display: flex; gap: 14rpx; }
.modal-cancel, .modal-confirm {
  flex: 1;
  padding: 19rpx 0;
  border: 2rpx solid var(--edge);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}
.modal-cancel { color: var(--text-dim); background: var(--cream-1); }
.modal-confirm { color: var(--ink); background: var(--primary); box-shadow: 4rpx 5rpx 0 var(--shadow); }

/* ===== 重要日子动效 ===== */
.imp-add { animation: app-rise-in .42s cubic-bezier(.2, .8, .3, 1) backwards; }
.imp-add-plus { animation: imp-plus-breathe 3s ease-in-out infinite; }
.imp-row { animation: app-rise-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.imp-row:nth-child(2) { animation-delay: .05s; }
.imp-row:nth-child(3) { animation-delay: .10s; }
.imp-row:nth-child(4) { animation-delay: .15s; }
.imp-row:nth-child(n+5) { animation-delay: .20s; }
.imp-dot.soon { animation: imp-soon-pulse 2.4s ease-in-out infinite; }
.imp-empty { animation: app-pop-in .5s cubic-bezier(.2, .8, .3, 1) both; }
.imp-empty-plus { animation: imp-plus-breathe 3s ease-in-out infinite; }
.modal-card { animation: imp-modal-in .32s cubic-bezier(.2, .8, .3, 1) both; }
.important-calendar { animation: app-rise-in .26s ease-out both; }
.important-cal-cell.selected { animation: imp-cell-pop .28s cubic-bezier(.2, .8, .3, 1) both; }

@keyframes imp-plus-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.10) rotate(90deg); } }
@keyframes imp-soon-pulse { 0%, 100% { transform: scale(1); } 45% { transform: scale(1.055); } }
@keyframes imp-modal-in { 0% { opacity: 0; transform: translateY(22rpx) scale(.94); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes imp-cell-pop { 0% { transform: scale(.78); } 65% { transform: scale(1.08); } 100% { transform: scale(1); } }
.modal-mask { animation: app-page-fade .18s ease-out both; }

/* 重要日子为空：只留 logo，不再放解释文字 */
.imp-empty-logo { width: 168rpx; height: 168rpx; opacity: .9; animation: history-logo-float 4.2s ease-in-out infinite; }

/* ===== 桌面 / 大屏：重要日子 =====
 * 只看主内容（条目名称 + 日期 + 倒计时）稍微放大；
 * 添加胶囊、加号、弹层里的输入框 / 日期块 / 日历格 / 按钮一律锁手机档，不随窗口放大。
 */
/* 底部内距避开左下角悬浮球 */
.desk .imp-body { padding: 12px 13px 0; }
.desk .imp-add {
  height: 49px;
  padding: 0 12px;
  gap: 7px;
  border-width: 2px;
  box-shadow: 3px 4px 0 var(--shadow);
  font-size: 14px;
}
.desk .imp-add-plus { flex: 0 0 19px; width: 19px; height: 19px; border-width: 1px; }
.desk .imp-add-plus::before { width: 9px; height: 2px; }
.desk .imp-add-plus::after { width: 2px; height: 9px; }
.desk .imp-list { margin-top: 12px; gap: 8px; }
.desk .imp-row {
  min-height: 47px;
  padding: 9px 10px;
  gap: 7px;
  border-width: 1px;
  border-radius: 10px;
}
.desk .imp-dot { flex: 0 0 8px; width: 8px; height: 8px; border-width: 1px; }
.desk .imp-main { gap: 2px; }
.desk .imp-title-row { gap: 6px; }
.desk .imp-title { font-size: 15px; }
.desk .imp-date { font-size: 11px; }
.desk .imp-count, .desk .imp-unit { font-size: 12px; }
.desk .imp-empty { margin-top: 13px; min-height: 179px; gap: 10px; border-width: 2px; border-radius: 15px; }
.desk .imp-empty-plus { width: 46px; height: 46px; border-width: 2px; box-shadow: 2px 3px 0 var(--shadow); }
.desk .imp-empty-plus::before { width: 19px; height: 3px; }
.desk .imp-empty-plus::after { width: 3px; height: 19px; }
.desk .imp-empty-text { font-size: 12px; }
.desk .imp-empty-logo { width: 94px; height: 94px; }

/* 添加 / 编辑弹层 */
.desk .modal-mask { padding: 0 22px; }
.desk .modal-card { padding: 17px 15px 15px; border-width: 2px; border-radius: 16px; box-shadow: 4px 5px 0 var(--shadow); }
.desk .important-modal { max-height: 76vh; }
.desk .modal-title { font-size: 18px; }
.desk .modal-input {
  height: 46px;
  margin-top: 11px;
  padding: 0 10px;
  border-width: 1px;
  border-radius: 9px;
  font-size: 15px;
}
.desk .important-form-row { margin-top: 8px; gap: 6px; }
.desk .important-date-btn { padding: 7px 9px; border-width: 1px; border-radius: 8px; }
.desk .important-date-label { font-size: 10px; }
.desk .important-date-value { margin-top: 2px; font-size: 13px; }
.desk .important-yearly {
  flex: 0 0 83px;
  padding: 0 5px;
  border-width: 1px;
  border-radius: 8px;
  font-size: 11px;
}
.desk .important-calendar { margin-top: 7px; padding: 7px; border-width: 1px; border-radius: 10px; }
.desk .important-cal-nav { width: 29px; font-size: 16px; }
.desk .important-cal-title { font-size: 12px; }
.desk .important-cal-weekdays { margin-top: 4px; gap: 3px; }
.desk .important-cal-weekday { font-size: 10px; }
.desk .important-cal-row { margin-top: 3px; gap: 3px; }
.desk .important-cal-cell { height: 27px; border-width: 1px; border-radius: 6px; font-size: 11px; }
.desk .modal-actions { margin-top: 12px; gap: 8px; }
.desk .modal-cancel,
.desk .modal-confirm {
  padding: 11px 0;
  border-width: 1px;
  border-radius: 999px;
  font-size: 14px;
}
.desk .modal-confirm { box-shadow: 2px 3px 0 var(--shadow); }

/* ===== 独立页外壳：顶栏 + 真实内容组件 ===== */
.imp-shell {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--ink);
  animation: app-page-fade .24s ease-out both;
}
.imp-view-slot {
  flex: 1 1 auto;
  min-height: 0;
}
.imp-view {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}
.desk .imp-view-slot {
  flex: 1 1 auto;
  height: auto;
}
