<view class="imp-shell theme-{{theme}} {{isDesktop ? 'desk' : ''}}" style="{{themeStyle}}">
  <view class="topbar" wx:if="{{!isDesktop}}">
    <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
    <view class="topbar-title">重要日子</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" above-tabbar="{{true}}" dim="{{dockDim}}"></brand-dock>

  <view class="imp-view-slot">
    <important-view id="importantView" class="imp-view" bind:dockdim="onDockDim"></important-view>
  </view>

  <app-dock />
</view>
