.quick-home-label { color: var(--ink); font-size: 23rpx; font-weight: 900; line-height: 1; }
.quick-home-icon { position: relative; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; }

/* 首页：快捷计时单模式，一点即开始 */
.quick-home-stage {
