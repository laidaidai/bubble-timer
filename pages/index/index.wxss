.app { min-height: 100vh; background:var(--bg);}
.page-content { padding: 16rpx 20rpx 64rpx; }
.config-scroll { height: calc(100vh - 286rpx - env(safe-area-inset-bottom)); box-sizing: border-box; }
.report-scroll { height: calc(100vh - 286rpx - env(safe-area-inset-bottom)); box-sizing: border-box; touch-action: pan-y; overflow-x: hidden; }

.hero-card, .timer-card, .module-card, .compare-card, .template-card { background:var(--card); border:2rpx solid var(--edge); border-radius: 28rpx; box-shadow:6rpx 7rpx 0 var(--shadow); }

.target-row { display: flex; align-items: stretch; gap: 14rpx; }
.hero-card { flex: 1; min-width: 0; min-height: 150rpx; padding: 22rpx 24rpx; display: flex; align-items: center; justify-content: space-between; background:var(--accent-bg); }
.hero-main { display: flex; flex-direction: column; gap: 6rpx; }
.eyebrow { color:var(--text-mid); font-size: 23rpx; font-weight: 800; letter-spacing: 1rpx; }
.total-target { color:var(--ink); font-size: 64rpx; font-weight: 900; line-height: 1.1; }
.unit { margin-left: 8rpx; color:var(--text-warm); font-size: 24rpx; font-weight: 800; }
.hero-sub { color:var(--text-mid); font-size: 22rpx; font-weight: 600; }
.tomato-board { position: relative; flex: 0 0 48%; width: 48%; min-width: 0; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; gap: 7rpx; }
.tomato-plus { position: absolute; z-index: 3; top: -22rpx; right: 6rpx; color: var(--text-warm); font-size: 26rpx; font-weight: 900; line-height: 1; text-shadow: 0 2rpx 0 var(--card); animation: tomato-plus .7s cubic-bezier(.2, .8, .3, 1) both; }
.tomato-grid { width: 100%; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 5rpx; }
.tomato { position: relative; width: 28rpx; height: 25rpx; box-sizing: border-box; background: #F2603C; border: 2rpx solid var(--edge); border-radius: 48% 48% 52% 52%; box-shadow: 2rpx 3rpx 0 var(--shadow); }
.tomato::before { content: ""; position: absolute; top: -6rpx; left: 7rpx; width: 12rpx; height: 7rpx; box-sizing: border-box; background: #5F9B58; border: 2rpx solid var(--edge); border-radius: 50% 50% 40% 40%; transform: rotate(-8deg); }
.tomato::after { content: ""; position: absolute; left: 5rpx; top: 5rpx; width: 6rpx; height: 8rpx; background: rgba(255, 255, 255, .38); border-radius: 50%; transform: rotate(24deg); }
.tomato.ghost { background: var(--cream-3); border-style: dashed; box-shadow: none; opacity: .8; }
.tomato.ghost::before { opacity: .55; }
.tomato.star { width: 28rpx; height: 28rpx; background: var(--primary); border: 0; border-radius: 0; box-shadow: none; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.tomato.star::before, .tomato.star::after { display: none; }
.tomato.star.ghost { background: var(--cream-3); opacity: .55; }
.tomato.bubble { width: 26rpx; height: 26rpx; margin: 2rpx; background: var(--primary); border-radius: 50%; }
.tomato.bubble::before { top: 5rpx; left: 5rpx; width: 7rpx; height: 7rpx; background: rgba(255, 255, 255, .55); border: 0; border-radius: 50%; transform: none; }
.tomato.bubble::after { display: none; }
.tomato.bubble.ghost { background: var(--cream-3); border-style: dashed; }
.tomato.fish { width: 31rpx; height: 22rpx; background: var(--primary); }
.tomato.fish::before { top: 3rpx; left: auto; right: -7rpx; width: 0; height: 0; background: none; border: 5rpx solid transparent; border-left-color: var(--primary); border-radius: 0; transform: none; }
.tomato.fish::after { left: 6rpx; top: 7rpx; width: 5rpx; height: 5rpx; background: var(--ink); border-radius: 50%; transform: none; }
.tomato.fish.ghost { background: var(--cream-3); }
.tomato.fish.ghost::before { border-left-color: var(--cream-3); }
.tomato-empty { display: flex; align-items: center; gap: 8rpx; }
.tomato-empty-text { color: var(--text-mid); font-size: 18rpx; font-weight: 800; }
.tomato-caption { max-width: 100%; color: var(--text-mid); font-size: 18rpx; font-weight: 800; line-height: 1.35; text-align: right; }
.tomato-progress { width: 100%; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.tomato-progress-track { width: 100%; height: 8rpx; overflow: hidden; background: var(--cream-3); border: 1.5rpx solid var(--line-strong); border-radius: 999rpx; }
.tomato-progress-fill { height: 100%; background: var(--primary); border-radius: 999rpx; transition: width .3s ease; }
.tomato-progress-text { color: var(--text-mid); font-size: 16rpx; font-weight: 800; }
.tomato-board.pop .tomato { animation: tomato-pop 520ms cubic-bezier(.2, .8, .3, 1); }
@keyframes tomato-pop { 0% { transform: scale(.55); opacity: .4; } 55% { transform: scale(1.18); } 100% { transform: scale(1); opacity: 1; } }

.important-card { margin-top: 14rpx; padding: 18rpx 20rpx 16rpx; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 26rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.important-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.important-title-wrap { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.important-title { color: var(--ink); font-size: 25rpx; font-weight: 900; }
.important-sub { color: var(--text-3); font-size: 18rpx; font-weight: 700; }
.important-add { flex: 0 0 auto; padding: 6rpx 14rpx; color: var(--text-warm); background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 19rpx; font-weight: 800; }
.important-scroll { margin-top: 12rpx; width: 100%; height: 136rpx; }
.important-track { display: flex; gap: 12rpx; padding: 2rpx 2rpx 6rpx; }
.important-item { flex: 0 0 214rpx; width: 214rpx; padding: 13rpx 16rpx 12rpx; display: flex; flex-direction: column; gap: 3rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 18rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); }
.important-item.soon { background: var(--accent-bg); }
.important-item.past { opacity: .58; }
.important-name-row { display: flex; align-items: center; gap: 6rpx; min-width: 0; }
.important-name { overflow: hidden; color: var(--ink); font-size: 23rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.important-yearly-tag { flex: 0 0 auto; padding: 2rpx 7rpx; color: var(--text-warm); background: var(--cream-2); border: 1rpx solid var(--line-strong); border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.important-count { display: flex; align-items: baseline; gap: 4rpx; line-height: 1.1; }
.important-num { color: var(--ink); font-size: 38rpx; font-weight: 900; }
.important-unit { color: var(--text-mid); font-size: 18rpx; font-weight: 800; }
.important-date { color: var(--text-3); font-size: 18rpx; font-weight: 700; }
.important-empty { margin-top: 12rpx; padding: 16rpx 18rpx; display: flex; flex-direction: column; gap: 3rpx; background: var(--cream-4); border: 2rpx dashed var(--line-strong); border-radius: 18rpx; }
.important-empty-main { color: var(--ink); font-size: 22rpx; font-weight: 800; }
.important-empty-sub { color: var(--text-3); font-size: 18rpx; font-weight: 600; }

/* 首页倒计时：1 个占满一行，2 个对半，3 个三等分 */
.home-cd-card { margin-top: 14rpx; padding: 16rpx 18rpx; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 24rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.home-cd-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.home-cd-title { color: var(--ink); font-size: 25rpx; font-weight: 900; }
.home-cd-link { color: var(--text-warm); font-size: 19rpx; font-weight: 800; }
.home-cd-row { display: flex; align-items: stretch; gap: 10rpx; }
.home-cd-item { box-sizing: border-box; min-width: 0; padding: 15rpx 16rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 6rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 16rpx; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); }
.home-cd-row.count-1 .home-cd-item { flex: 1 1 100%; }
.home-cd-row.count-2 .home-cd-item { flex: 0 0 calc(50% - 5rpx); }
.home-cd-row.count-3 .home-cd-item { flex: 0 0 calc(33.333% - 7rpx); }
.home-cd-item.soon { background: var(--accent-bg); }
.home-cd-item.past { opacity: .58; }
.home-cd-name-row { flex: 1; display: flex; align-items: center; gap: 5rpx; min-width: 0; }
.home-cd-name { flex: 1; min-width: 0; overflow: hidden; color: var(--ink); font-size: 22rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.home-cd-yearly { flex: 0 0 auto; padding: 1rpx 6rpx; color: var(--text-warm); background: var(--cream-2); border: 1rpx solid var(--line-strong); border-radius: 999rpx; font-size: 16rpx; font-weight: 800; }
.home-cd-count { flex: 0 0 auto; display: flex; align-items: baseline; gap: 3rpx; line-height: 1.1; white-space: nowrap; }
.home-cd-num { color: var(--ink); font-size: 32rpx; font-weight: 900; }
.home-cd-unit { color: var(--text-mid); font-size: 17rpx; font-weight: 800; }
.home-cd-date { color: var(--text-3); font-size: 17rpx; font-weight: 700; }
.home-cd-empty { margin-top: 10rpx; padding: 14rpx 16rpx; display: flex; flex-direction: column; gap: 3rpx; background: var(--cream-4); border: 2rpx dashed var(--line-strong); border-radius: 16rpx; }
.home-cd-empty-main { color: var(--ink); font-size: 22rpx; font-weight: 800; }
.home-cd-empty-sub { color: var(--text-3); font-size: 18rpx; font-weight: 600; }

.home-todo-card { min-height: 84rpx; margin-top: 0; padding: 16rpx 18rpx; display: flex; align-items: center; gap: 10rpx; background: var(--card); border: 2rpx solid var(--line-strong); border-radius: 18rpx; }
.home-todo-card.overdue { border-color: var(--danger); background: var(--danger-bg); }
.home-todo-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; box-sizing: border-box; border: 2rpx solid var(--line-strong); border-radius: 50%; }
.home-todo-card.overdue .home-todo-dot { background: var(--danger); border-color: var(--danger); }
.home-todo-text { flex: 1; min-width: 0; overflow: hidden; color: var(--ink); font-size: 24rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.home-todo-time { flex: 0 0 auto; color: var(--text-2); font-size: 19rpx; font-weight: 900; }

.control-bar { margin: 18rpx 0 26rpx; display: flex; align-items: center; gap: 12rpx; }
.control-bar.solo { justify-content: center; }
.primary-button { color:var(--ink); background:var(--primary); font-weight: 900; border:2rpx solid var(--edge); border-radius: 999rpx; }
.control-bar .primary-button { display: inline-flex; align-items: center; justify-content: center; width: 204rpx; margin: 0; padding: 22rpx 12rpx; font-size: 27rpx; line-height: 1; white-space: nowrap; box-shadow:4rpx 5rpx 0 var(--shadow); }
.primary-button text { margin-left: 8rpx; color:var(--warn-text); }
.primary-button[disabled] { opacity: .45; }

.section-title-row, .module-head, .module-foot { display: flex; align-items: center; justify-content: space-between; }
.section-title-row { margin-top: 30rpx; }
.section-title { color:var(--ink); font-size: 30rpx; font-weight: 900; }
.section-title-main { display: flex; align-items: center; gap: 12rpx; min-width: 0; }

.module-card { position: relative; margin: 14rpx 0; padding: 24rpx 26rpx 20rpx; border-radius: 40rpx; box-shadow:9rpx 10rpx 0 var(--shadow); transition: transform 200ms cubic-bezier(0.25, 0.8, 0.3, 1), box-shadow 160ms ease, background-color 160ms ease; will-change: transform; }
.module-card::after { content: ""; position: absolute; top: 28rpx; right: 104rpx; bottom: 28rpx; width: 2rpx; background:var(--line-2); }
.dragging { transform: scale(1.02); box-shadow:14rpx 18rpx 0 var(--shadow); }
.module-card.drag-mode { transition: transform 180ms cubic-bezier(0.25, 0.8, 0.3, 1); }
.module-card.dragging { background:var(--cream-3); border-color:var(--edge); transition: transform 0ms, box-shadow 100ms ease, background-color 100ms ease; }
.module-head { position: relative; margin-right: 110rpx; }
.module-name { position: relative; z-index: 1; width: 100%; color:var(--ink); font-size: 30rpx; font-weight: 900; }
.delete-button { position: absolute; z-index: 2; top: 0; right: -22rpx; display: inline-flex !important; flex: 0 0 56rpx; width: 56rpx !important; min-width: 56rpx !important; max-width: 56rpx; height: 56rpx; margin: 0; padding: 0; box-sizing: border-box; align-items: center; justify-content: center; color:var(--on-panel); background:var(--danger); border-radius: 50%; box-shadow:3rpx 4rpx 0 var(--shadow); font-size: 32rpx; font-weight: 700; line-height: 52rpx; }
.duration-row { width: auto; margin: 36rpx 110rpx 0 0; display: flex; align-items: flex-start; }
.stepper { flex: 0 0 190rpx; height: 58rpx; display: flex; overflow: hidden; border:2rpx solid var(--edge); border-radius: 999rpx; }
.round-small { flex: 1; width: auto !important; min-width: 0 !important; max-width: none; height: 54rpx; margin: 0; padding: 0; color:var(--ink); background:var(--cream-1); border: 0; border-radius: 0; font-size: 30rpx; font-weight: 800; line-height: 54rpx; }
.stepper .round-small:first-child { border-radius: 999rpx 0 0 999rpx; }
.stepper .round-small:last-child { border-radius: 0 999rpx 999rpx 0; }
.minute-input { flex: 0 0 64rpx; width: 64rpx; height: 54rpx; color:var(--ink); background:var(--cream-2); border-top: 0; border-bottom: 0; border-left:2rpx solid var(--edge); border-right:2rpx solid var(--edge); font-size: 30rpx; font-weight: 900; text-align: center; }
.slider-wrap { flex: 1; min-width: 0; margin: 14rpx 0 0 24rpx; }
.duration-slider { width: 100%; margin: 0; padding: 0; }
.slider-labels { margin: -2rpx 0 0; display: flex; justify-content: space-between; color:var(--text-3); font-size: 20rpx; }
.module-foot { position: absolute; top: 50%; right: 20rpx; width: 76rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; transform: translateY(-50%); color:var(--text-3); font-size: 20rpx; }
.drag-handle { color:var(--text-3); font-size: 30rpx; line-height: 1; }
.template-list { margin-top: 10rpx; }
.template-list-label { margin-bottom: 10rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color:var(--text-2); font-size: 21rpx; }
.template-save { padding: 6rpx 16rpx; color: var(--text-warm); background:var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 19rpx; font-weight: 800; }
.section-title-actions { display: flex; align-items: center; gap: 10rpx; flex: 0 0 auto; }
.section-clear { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; color: var(--danger); background: var(--card); border: 2rpx solid var(--danger); border-radius: 999rpx; box-shadow: 2rpx 3rpx 0 var(--shadow-soft); font-size: 26rpx; font-weight: 900; line-height: 1; }
.section-clear:active { transform: scale(.94); }
.template-list-pills { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.template-pick { padding: 10rpx 18rpx; color:var(--text-mid); background:var(--card); border:2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 22rpx; }
.template-pick.active { color:var(--on-panel); background:var(--panel); border-color:var(--edge); }
.template-add { color:var(--text-warm); background:var(--cream-2); border-style: dashed; }
.template-plus { flex: 0 0 52rpx; width: 52rpx; height: 52rpx; padding: 0; display: flex; align-items: center; justify-content: center; color: var(--text-warm); background: var(--cream-2); border: 2rpx dashed var(--line-strong); border-radius: 50%; font-size: 30rpx; font-weight: 900; line-height: 1; }
.quick-templates { margin: 4rpx 0 0; }
.module-switching { animation: module-switch-in 260ms ease-out both; }
@keyframes module-switch-in {
  from { opacity: .35; transform: translateX(18rpx) scale(.98); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}

.on-track { color:var(--success-text); font-weight: 900; }
.overtime { color:var(--danger-text); font-weight: 900; }

.report-page { padding: 16rpx 20rpx 64rpx; }

/* 总览 */
.rp-hero { padding: 30rpx 28rpx 24rpx; color: var(--on-panel); background: var(--panel); border: 2rpx solid var(--edge); border-radius: 28rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); }
.rp-hero-meta { color: var(--on-panel-warm); font-size: 20rpx; font-weight: 700; }
.rp-dot { margin: 0 10rpx; }
.rp-hero-main { margin-top: 10rpx; display: flex; align-items: baseline; }
.rp-percent { font-size: 92rpx; font-weight: 900; line-height: 1; }
.rp-percent-unit { margin-left: 6rpx; font-size: 30rpx; font-weight: 900; }
.rp-percent-cap { margin-left: auto; color: var(--on-panel); opacity: .72; font-size: 20rpx; font-weight: 700; }
.rp-metrics { margin-top: 24rpx; display: flex; border-top: 2rpx solid rgba(255, 255, 255, .18); padding-top: 20rpx; }
.rp-metric { flex: 1; min-width: 0; }
.rp-metric + .rp-metric { padding-left: 20rpx; border-left: 2rpx solid rgba(255, 255, 255, .18); }
.rp-metric-v { color: var(--on-panel); font-size: 32rpx; font-weight: 900; line-height: 1.1; white-space: nowrap; }
.rp-metric-k { margin-top: 6rpx; color: var(--on-panel); opacity: .66; font-size: 19rpx; }
.rp-metric-u { margin-left: 4rpx; font-size: 18rpx; opacity: .7; }
.rp-metric-v.warn { color: var(--on-panel-warm); }

/* 结论 */
.rp-tips { margin-top: 18rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.rp-tips.single { grid-template-columns: 1fr; }
.rp-tip { padding: 18rpx 20rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 20rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.rp-tip-k { color: var(--text-warm); font-size: 19rpx; font-weight: 800; }
.rp-tip-v { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-tip-v .num { margin-left: 6rpx; font-size: 20rpx; color: var(--text-mid); }
.rp-tip-v .warn { color: var(--danger-text); }

/* 模块清单 */
.rp-list { margin-top: 18rpx; padding: 6rpx 24rpx 18rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 24rpx; box-shadow: 5rpx 6rpx 0 var(--shadow-soft); }
.rp-list-head { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0 12rpx; }
.rp-list-title { color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-list-sub { color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-item { padding: 16rpx 0; border-top: 2rpx solid var(--line); }
.rp-item-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.rp-item-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 25rpx; font-weight: 900; }
.rp-item-index { margin-right: 10rpx; color: var(--text-3); font-size: 19rpx; font-weight: 800; }
.rp-item-time { flex: 0 0 auto; color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-item-target { margin-left: 4rpx; color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-item-track { margin-top: 12rpx; height: 10rpx; overflow: hidden; background: var(--track); border-radius: 999rpx; }
.rp-item-fill { height: 100%; border-radius: 999rpx; background: var(--primary-2); }
.rp-item-fill.fill-on-track { background: var(--success); }
.rp-item-fill.fill-near { background: var(--primary-3); }
.rp-item-fill.fill-overtime { background: var(--danger); }
.rp-item-fill.fill-incomplete, .rp-item-fill.fill-skipped { background: var(--bar-incomplete); }
.rp-item-foot { margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between; }
.rp-item-status { font-size: 19rpx; font-weight: 800; }
.rp-item-delta { color: var(--text-mid); font-size: 20rpx; font-weight: 800; }
.rp-more { margin-top: 12rpx; padding: 16rpx; color: var(--text-mid); text-align: center; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 21rpx; font-weight: 900; }

.rp-quote { margin-top: 22rpx; color: var(--text-warm); text-align: center; font-size: 22rpx; font-weight: 700; }

.rp-actions { margin-top: 26rpx; display: flex; flex-direction: column; gap: 14rpx; }
.rp-action-row { display: flex; gap: 12rpx; }
.rp-btn { flex: 1; min-width: 0; min-height: 84rpx; padding: 20rpx 6rpx; color: var(--ink); background: var(--card); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 5rpx 0 var(--shadow); font-size: 24rpx; font-weight: 900; line-height: 1.2; }
.rp-btn.primary { color: var(--on-primary); background: var(--primary); }
.rp-btn-rerun { font-size: 22rpx; }

.report-page { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.delete-link { margin: 0; padding: 16rpx 28rpx; color:var(--on-panel); background:var(--danger); border:2rpx solid var(--edge); border-radius: 999rpx; box-shadow:3rpx 4rpx 0 var(--shadow); font-size: 23rpx; font-weight: 900; }
.empty-state { padding: 100rpx 20rpx; color:var(--text-2); text-align: center; font-size: 26rpx; }
.empty-state .primary-button { margin-top: 30rpx; padding: 22rpx 40rpx; }
.back-button { margin-top: 10rpx; padding: 22rpx; color:var(--ink); background:var(--cream-2); border:2rpx solid var(--edge); border-radius: 999rpx; box-shadow:4rpx 5rpx 0 var(--shadow); font-size: 26rpx; font-weight: 900; }

