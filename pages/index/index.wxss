@keyframes tomato-plus {
  0% { opacity: 0; transform: translateY(12rpx) scale(.7); }
  22% { opacity: 1; transform: translateY(0) scale(1.06); }
  100% { opacity: 0; transform: translateY(-34rpx) scale(1.12); }
}

/* ===== 训练分析报告 v2：结论优先，明细后置 ===== */
.rp-hero {
  position: relative;
  padding: 28rpx 28rpx 24rpx 34rpx;
  color: var(--ink);
  background: var(--card);
  border: 2rpx solid var(--edge);
  border-radius: 30rpx;
  box-shadow: 7rpx 8rpx 0 var(--shadow);
  overflow: hidden;
}
.rp-hero::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: var(--primary);
  border-right: 2rpx solid var(--edge);
}
.rp-hero-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.rp-hero-kicker { color: var(--text-warm); font-size: 23rpx; font-weight: 900; letter-spacing: 1rpx; }
.rp-date { color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-score-row { margin-top: 14rpx; display: flex; align-items: flex-end; gap: 20rpx; }
.rp-score { display: flex; align-items: baseline; flex: 0 0 auto; }
.rp-percent { color: var(--ink); font-size: 108rpx; font-weight: 900; line-height: .95; }
.rp-percent-unit { margin-left: 6rpx; color: var(--text-warm); font-size: 30rpx; font-weight: 900; }
.rp-score-copy { flex: 1; min-width: 0; padding-bottom: 10rpx; display: flex; flex-direction: column; gap: 10rpx; }
.rp-verdict { color: var(--ink); font-size: 27rpx; font-weight: 900; line-height: 1.25; }
.rp-status-line { display: flex; flex-wrap: wrap; gap: 8rpx; }
.rp-status-item { padding: 5rpx 12rpx; border: 2rpx solid var(--line); border-radius: 999rpx; color: var(--text-mid); background: var(--cream-1); font-size: 18rpx; font-weight: 800; line-height: 1.2; }
.rp-status-item.ok { color: var(--success-text); background: var(--success-bg); border-color: var(--success-line); }
.rp-status-item.warn { color: var(--danger-text); background: var(--danger-bg); border-color: var(--danger-line); }
.rp-status-item.muted { color: var(--text-3); background: var(--cream-2); }
.rp-progress { margin-top: 20rpx; height: 16rpx; overflow: hidden; background: var(--track); border: 2rpx solid var(--line); border-radius: 999rpx; }
.rp-progress-fill { height: 100%; background: var(--primary); border-right: 2rpx solid var(--edge); border-radius: 999rpx; transition: width .4s cubic-bezier(.2, .8, .3, 1); }
.rp-metrics { margin-top: 20rpx; padding-top: 18rpx; display: flex; border-top: 2rpx solid var(--line); }
.rp-metric { flex: 1; min-width: 0; }
.rp-metric + .rp-metric { padding-left: 20rpx; border-left: 2rpx solid var(--line); }
.rp-metric-v { color: var(--ink); font-size: 33rpx; font-weight: 900; line-height: 1.1; white-space: nowrap; }
.rp-metric-k { margin-top: 6rpx; color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-metric-u { margin-left: 4rpx; font-size: 18rpx; color: var(--text-3); }
.rp-metric-v.warn { color: var(--danger-text); }

.rp-insights { margin-top: 16rpx; display: flex; gap: 12rpx; }
.rp-insight { flex: 1; min-width: 0; padding: 16rpx 18rpx; background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.rp-insight-k { color: var(--text-warm); font-size: 19rpx; font-weight: 800; }
.rp-insight-main { margin-top: 8rpx; display: flex; align-items: baseline; gap: 8rpx; min-width: 0; }
.rp-insight-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-insight-time { color: var(--text-mid); font-size: 20rpx; font-weight: 800; }

.rp-list { margin-top: 16rpx; padding: 4rpx 24rpx 14rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 24rpx; box-shadow: 5rpx 6rpx 0 var(--shadow-soft); }
.rp-list-head { display: flex; align-items: baseline; justify-content: space-between; padding: 18rpx 0 12rpx; }
.rp-list-title { color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-list-sub { color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-item { padding: 16rpx 0 14rpx; border-top: 2rpx solid var(--line); }
.rp-item-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.rp-item-name { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10rpx; overflow: hidden; color: var(--ink); font-size: 25rpx; font-weight: 900; }
.rp-item-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rp-status-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; border: 2rpx solid var(--edge); border-radius: 50%; background: var(--primary); }
.rp-status-dot.dot-on-track, .rp-status-dot.dot-near { background: var(--success); }
.rp-status-dot.dot-overtime { background: var(--danger); }
.rp-status-dot.dot-incomplete, .rp-status-dot.dot-skipped { background: var(--bar-incomplete); }
.rp-item-time { flex: 0 0 auto; color: var(--ink); font-size: 24rpx; font-weight: 900; }
.rp-item-target { margin-left: 4rpx; color: var(--text-3); font-size: 19rpx; font-weight: 700; }
.rp-item-track { position: relative; margin-top: 13rpx; height: 12rpx; background: var(--track); border-radius: 999rpx; }
.rp-item-fill { height: 100%; border-radius: 999rpx; background: var(--primary-2); }
.rp-item-fill.fill-on-track { background: var(--success); }
.rp-item-fill.fill-near { background: var(--primary-3); }
.rp-item-fill.fill-overtime { background: var(--danger); }
.rp-item-fill.fill-incomplete, .rp-item-fill.fill-skipped { background: var(--bar-incomplete); }
.rp-item-target-mark { position: absolute; top: -5rpx; bottom: -5rpx; width: 2rpx; z-index: 2; background: var(--edge); border-radius: 2rpx; }
.rp-item-foot { margin-top: 8rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.rp-status { font-size: 18rpx; font-weight: 800; }
.rp-status.status-on-track { color: var(--success-text); }
.rp-status.status-near { color: var(--text-warm); }
.rp-status.status-overtime { color: var(--danger-text); }
.rp-status.status-incomplete, .rp-status.status-skipped { color: var(--text-3); }
.rp-delta { color: var(--text-mid); font-size: 18rpx; font-weight: 800; }
.rp-actions { margin-top: 22rpx; }

/* 首页：快捷计时 */
.quick-home { margin-top: 8rpx; }
.quick-home-head {
  padding: 16rpx 4rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
