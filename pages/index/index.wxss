.home-feature-add { width: 112rpx; height: 112rpx; margin: 46rpx auto 20rpx; display: flex; align-items: center; justify-content: center; color: var(--text-warm); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 50%; box-shadow: 4rpx 5rpx 0 var(--shadow); font-size: 44rpx; font-weight: 900; line-height: 1; }
