<view class="app theme-{{theme}}" style="{{themeStyle}}">
  <view class="topbar">
    <button class="back-icon" wx:if="{{homeTimerOverride && view !== 'report'}}" bindtap="exitTimerOverride">‹</button>
    <button class="back-icon" wx:elif="{{view === 'report'}}" bindtap="handleBack">‹</button>
    <view class="topbar-spacer" wx:else></view>
    <view class="topbar-title" wx:if="{{view === 'report'}}">训练分析报告</view>
    <view class="topbar-title" wx:else>小鱼时钟</view>
    <view class="topbar-spacer"></view>
  </view>

  <block wx:if="{{view === 'config'}}">
    <scroll-view class="config-scroll" scroll-y="{{!dragging}}" enhanced show-scrollbar="{{false}}" bindscroll="onConfigScroll" bindscrolltolower="onConfigBottom">
      <view class="page-content">
        <block wx:if="{{homePrimary === 'timer' || homeTimerOverride}}">
          <view class="target-row">
            <view class="hero-card">
              <view class="hero-main">
                <view class="eyebrow">目标时间</view>
                <view class="total-target"><text class="num">{{totalMinutes}}</text><text class="unit">分钟</text></view>
              </view>
              <view class="tomato-board {{tomatoPop ? 'pop' : ''}}">
                <view class="tomato-grid">
                  <view class="tomato {{incentiveType}} {{item.filled ? '' : 'ghost'}}" wx:for="{{tomatoIcons}}" wx:key="id"></view>
                </view>
                <text class="tomato-caption" wx:if="{{tomatoCaption}}">{{tomatoCaption}}</text>
              </view>
            </view>
          </view>

          <view class="control-bar">
            <view class="mode-capsule">
              <view class="mode-seg {{mode === item.key ? 'on' : ''}}" wx:for="{{modes}}" wx:key="key" data-key="{{item.key}}" bindtap="chooseMode">{{item.name}}</view>
            </view>
            <button class="primary-button" bindtap="startTraining" disabled="{{!modules.length}}">开始计时 <text>▶</text></button>
          </view>

          <view class="home-feature home-feature-in-timer" wx:if="{{homeImportantPreview.length}}">
            <view class="home-feature-important-grid count-{{homeImportantPreview.length}}">
              <view class="home-feature-important-card {{item.soon ? 'soon' : ''}} {{item.isPast ? 'past' : ''}}" wx:for="{{homeImportantPreview}}" wx:key="id" bindtap="goTools">
                <view class="home-feature-important-name-row"><text class="home-feature-important-name">{{item.name}}</text></view>
                <view class="home-feature-important-count"><text class="home-feature-important-num num">{{item.countdownNumber}}</text><text class="home-feature-important-unit" wx:if="{{item.countdownUnit}}">{{item.countdownUnit}}</text></view>
              </view>
            </view>
          </view>


          <view class="section-title-row">
            <view class="section-title-main">
              <view class="section-title">训练模块</view>
              <view class="template-plus" bindtap="openTemplateModal">＋</view>
            </view>
            <text class="template-save" bindtap="saveCurrentTemplate">保存</text>
          </view>

          <view class="template-list quick-templates" wx:if="{{templates.length}}">
            <view class="template-list-pills">
              <view class="template-pick {{item.name === templateName ? 'active' : ''}}" wx:for="{{templates}}" wx:key="name" data-index="{{index}}" data-name="{{item.name}}" bindtap="loadTemplate" bindlongpress="removeTemplate">{{item.name}}</view>
            </view>
          </view>

          <view class="module-card {{dragIndex === index ? 'dragging' : ''}} {{dragging && dragIndex !== index ? 'drag-mode' : ''}} {{templateSwitching ? 'module-switching' : ''}}" style="{{dragIndex === index ? dragStyle : settleIndex === index ? settleStyle : dragStyles[index]}}" wx:for="{{modules}}" wx:key="id" data-index="{{index}}" bindtouchstart="touchStart" bindlongpress="activateDrag" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd">
            <view class="module-head">
              <input class="module-name" value="{{item.name}}" data-index="{{index}}" bindinput="changeModuleName" bindblur="normalizeModuleName" maxlength="20" />
              <button class="delete-button" data-index="{{index}}" catchtap="removeModule">×</button>
            </view>
            <view class="duration-row">
              <view class="stepper">
                <button class="round-small" data-index="{{index}}" data-step="-1" bindtap="adjustMinutes">−</button>
                <input class="minute-input num" type="number" value="{{item.targetMinutes}}" data-index="{{index}}" bindinput="changeMinutes" />
                <button class="round-small" data-index="{{index}}" data-step="1" bindtap="adjustMinutes">＋</button>
              </view>
              <view class="slider-wrap">
                <slider class="duration-slider" min="0" max="60" step="1" value="{{item.targetMinutes}}" data-index="{{index}}" bindchanging="changeSlider" bindchange="changeSlider" activeColor="{{sliderActive}}" backgroundColor="{{sliderTrack}}" blockColor="{{sliderBlock}}" block-size="20" />
              </view>
            </view>
            <view class="module-foot" data-index="{{index}}" catchtouchstart="handleTouchStart" catchtouchmove="touchMove" catchtouchend="touchEnd" catchtouchcancel="touchEnd"><text class="drag-handle">☰</text></view>
          </view>

          <view class="add-module-row" wx:if="{{addVisible && modules.length < 8}}"><view class="add-module-plus" bindtap="openPresetSheet">＋</view></view>
        </block>

        <block wx:elif="{{homePrimary === 'todo'}}">
          <view class="home-feature">
            <view class="home-feature-list {{homeTodoPreview.length === 1 ? 'single' : ''}}" wx:if="{{homeTodoPreview.length}}">
              <view class="home-todo-card {{item.overdue ? 'overdue' : ''}}" wx:for="{{homeTodoPreview}}" wx:key="id" bindtap="openTodoPage">
                <view class="home-todo-dot"></view>
                <text class="home-todo-text">{{item.text}}</text>
                <text class="home-todo-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
              </view>
            </view>
            <view class="home-feature-add" wx:else bindtap="openTodoPage">＋</view>
          </view>
        </block>

        <block wx:elif="{{homePrimary === 'important'}}">
          <view class="home-feature">
            <view class="home-feature-important-grid {{homeImportantPreview.length === 1 ? 'single' : ''}}" wx:if="{{homeImportantPreview.length}}">
              <view class="home-feature-important-card {{item.soon ? 'soon' : ''}} {{item.isPast ? 'past' : ''}}" wx:for="{{homeImportantPreview}}" wx:key="id" bindtap="goTools">
                <view class="home-feature-important-name-row"><text class="home-feature-important-name">{{item.name}}</text></view>
                <view class="home-feature-important-count"><text class="home-feature-important-num num">{{item.countdownNumber}}</text><text class="home-feature-important-unit" wx:if="{{item.countdownUnit}}">{{item.countdownUnit}}</text></view>
              </view>
            </view>
            <view class="home-feature-add" wx:else bindtap="goTools">＋</view>
          </view>
        </block>

        <block wx:elif="{{homePrimary === 'stats'}}">
          <view class="home-feature" bindtap="openStatsPage">
            <view class="home-feature-head">
              <text class="home-feature-title">打卡</text>

            </view>
            <view class="home-feature-stats">
              <text class="home-feature-percent num">{{homeStats.percent || 0}}%</text>
              <view class="home-feature-bar"><view class="home-feature-bar-fill" style="width: {{homeStats.percent || 0}}%;"></view></view>
              <text class="home-feature-streak">{{homeStats.streak || 0}} 天</text>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </block>


  <block wx:if="{{view === 'report'}}">
    <scroll-view class="report-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-content report-page">
      <view class="rp-hero">
        <view class="rp-hero-meta"><text class="num">{{report.startedAtText}}</text><text class="rp-dot">·</text><text>已完成</text></view>
        <view class="rp-hero-main">
          <text class="rp-percent num">{{report.passRate}}</text><text class="rp-percent-unit">%</text>
          <text class="rp-percent-cap">模块达标率</text>
        </view>
        <view class="rp-metrics">
          <view class="rp-metric">
            <view class="rp-metric-v num">{{report.totalActualText}}</view>
            <view class="rp-metric-k">实际用时</view>
          </view>
          <view class="rp-metric">
            <view class="rp-metric-v num">{{report.totalTarget}}<text class="rp-metric-u">分</text></view>
            <view class="rp-metric-k">计划用时</view>
          </view>
          <view class="rp-metric">
            <view class="rp-metric-v num {{report.overtimeCount ? 'warn' : ''}}">{{report.overtimeCount}}</view>
            <view class="rp-metric-k">超时模块</view>
          </view>
        </view>
      </view>

      <view class="rp-tips {{(!report.shortestName || report.shortestName === report.slowestName) ? 'single' : ''}}" wx:if="{{report.slowestName}}">
        <view class="rp-tip">
          <view class="rp-tip-k">最耗时</view>
          <view class="rp-tip-v">{{report.slowestName}} <text class="num">{{report.slowestText}}</text></view>
        </view>
        <view class="rp-tip" wx:if="{{report.shortestName && report.shortestName !== report.slowestName}}">
          <view class="rp-tip-k">最短时</view>
          <view class="rp-tip-v">{{report.shortestName}} <text class="num">{{report.shortestText}}</text></view>
        </view>
      </view>

      <view class="rp-list">
        <view class="rp-list-head">
          <text class="rp-list-title">模块用时</text>
        </view>
        <view class="rp-item" wx:for="{{reportView}}" wx:key="id">
          <view class="rp-item-head">
            <view class="rp-item-name"><text class="rp-item-index num">{{item.indexLabel}}</text>{{item.name}}</view>
            <view class="rp-item-time"><text class="num">{{item.actualText}}</text><text class="rp-item-target">/ {{item.targetMinutes}}:00</text></view>
          </view>
          <view class="rp-item-track"><view class="rp-item-fill fill-{{item.statusCode}}" style="width:{{item.actualPercent}}%"></view></view>
        </view>
      </view>

      <view class="rp-actions">
        <view class="rp-action-row">
          <button class="rp-btn primary" bindtap="exportReport">保存图片</button>
          <button class="rp-btn" bindtap="shareReport">分享</button>
          <button class="rp-btn rp-btn-rerun" bindtap="restartTraining">↻ 再练一次</button>
        </view>
      </view>
      <canvas canvas-id="reportCanvas" class="report-canvas" />
    </view>
    </scroll-view>
  </block>

  <view class="modal-mask" wx:if="{{presetSheetOpen}}" catchtouchmove="blockTouch" bindtap="closePresetSheet">
    <view class="modal-card" catchtap="blockTouch">
      <view class="modal-title">添加训练模块</view>
      <view class="preset-grid">
        <view class="preset-chip" wx:for="{{presets}}" wx:key="name" data-index="{{index}}" bindtap="pickPreset">{{item.name}}<text class="preset-min num">{{item.minutes}}M</text></view>
      </view>
      <view class="modal-actions">
        <button class="modal-cancel" bindtap="closePresetSheet">取消</button>
        <button class="modal-confirm" bindtap="pickCustom">自定义</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{templateModalOpen}}" catchtouchmove="blockTouch" bindtap="closeTemplateModal">
    <view class="modal-card" catchtap="blockTouch">
      <view class="modal-title">新建模板</view>
      <input class="modal-input" value="{{newTemplateName}}" placeholder="例如：周末训练" maxlength="12" focus="{{templateModalOpen}}" confirm-type="done" bindinput="onTemplateNameInput" bindconfirm="confirmTemplate" />
      <view class="modal-actions">
        <button class="modal-cancel" bindtap="closeTemplateModal">取消</button>
        <button class="modal-confirm" bindtap="confirmTemplate">保存模板</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{importantModalOpen}}" catchtouchmove="blockTouch" bindtap="closeImportantModal">
    <view class="modal-card important-modal" catchtap="blockTouch">
      <view class="modal-title">{{importantEditingId ? '编辑重要日子' : '添加重要日子'}}</view>
      <input class="modal-input" value="{{importantName}}" placeholder="例如：考研初试、妈妈的生日" maxlength="16" focus="{{importantModalOpen}}" confirm-type="done" bindinput="onImportantNameInput" bindconfirm="saveImportantDate" />
      <view class="important-form-row">
        <view class="important-date-btn {{importantCalendarOpen ? 'on' : ''}}" bindtap="toggleImportantCalendar">
          <text class="important-date-label">日期</text>
          <text class="important-date-value">{{importantDateText}}</text>
        </view>
        <view class="important-yearly {{importantYearly ? 'on' : ''}}" bindtap="toggleImportantYearly">每年重复</view>
      </view>
      <view class="important-calendar" wx:if="{{importantCalendarOpen}}">
        <view class="important-cal-head">
          <view class="important-cal-nav" data-step="-1" catchtap="shiftImportantMonth">‹</view>
          <text class="important-cal-title">{{importantCalTitle}}</text>
          <view class="important-cal-nav" data-step="1" catchtap="shiftImportantMonth">›</view>
        </view>
        <view class="important-cal-weekdays">
          <text class="important-cal-weekday" wx:for="{{importantCalWeekLabels}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="important-cal-row" wx:for="{{importantCalRows}}" wx:key="key" wx:for-item="row">
          <view class="important-cal-cell {{cell.empty ? 'empty' : ''}} {{cell.selected ? 'selected' : ''}} {{cell.today ? 'today' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key" data-key="{{cell.key}}" bindtap="selectImportantDay">{{cell.day}}</view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="modal-cancel" bindtap="closeImportantModal">取消</button>
        <button class="modal-confirm" bindtap="saveImportantDate">{{importantEditingId ? '保存修改' : '添加'}}</button>
      </view>
    </view>
  </view>
</view>
