}

/* 结算主体：直接使用品牌 logo，替换手绘番茄 */
.celebrate-logo {
  position: relative;
  z-index: 1;
  width: 180rpx;
  height: 180rpx;
  display: block;
  animation: celebrate-logo-in .62s cubic-bezier(.2, .9, .3, 1.15) both .06s;
  filter: drop-shadow(0 12rpx 18rpx rgba(13, 39, 58, .14));
}
@keyframes celebrate-logo-in {
  0% { opacity: 0; transform: scale(.68) rotate(-8deg); }
  58% { opacity: 1; transform: scale(1.08) rotate(2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
.timer-page.compact .celebrate-logo {
  width: 132px;
  height: 132px;
}

/* 结算背景：强模糊 + 柔和光晕，彻底压掉下层卡片的边框轮廓 */
.celebrate-mask {
  background:
    radial-gradient(circle at 50% 44%,
      rgba(255, 253, 247, .99) 0%,
      rgba(255, 253, 247, .94) 36%,
      rgba(255, 253, 247, .66) 62%,
      rgba(255, 253, 247, .22) 82%,
      rgba(255, 253, 247, 0) 96%),
    rgba(250, 245, 236, .52);
  -webkit-backdrop-filter: blur(24px) saturate(1.04);
  backdrop-filter: blur(24px) saturate(1.04);
}
.celebrate-card,
.timer-page.compact .celebrate-card {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}
.timer-page.compact .celebrate-reward {
  flex-basis: 160px;
  width: 160px;
  height: 150px;
}

/* 底部控制区：左右两组分散到两侧，不再挤在中间 */
.controls {
  width: 100%;
  box-sizing: border-box;
  padding: 0 16px;
  justify-content: space-between;
  gap: 0;
}
.timer-page.compact .controls {
  width: 100%;
  padding: 0 14px;
  justify-content: space-between;
  gap: 0;
}
.timer-page.compact .control-group { gap: 10px; }

/* 底部四个控制键在整行内均匀分开，而不是拆成左右两组 */
.controls {
  width: 100%;
  box-sizing: border-box;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
}
.timer-page.compact .controls {
  width: 100%;
  padding: 0 15px;
  justify-content: space-between;
  gap: 0;
}

/* 计时页中间时钟整体放大：横屏紧凑模式更饱满，但不挤压控制区 */
.timer-page.compact .flip-card { width: 72px; height: 122px; }
.timer-page.compact .flip-num { font-size: 52px; line-height: 122px; }
.timer-page.compact .flip-colon { font-size: 30px; }

.timer-page.compact .block-tile { width: 74px; height: 100px; }
.timer-page.compact .block-num { font-size: 44px; }
.timer-page.compact .block-colon { font-size: 28px; }

.timer-page.compact .plain-num { font-size: 96px; }
.timer-page.compact .clock-gradient .plain-num { font-size: 96px; padding: 0 32px; }
.timer-page.compact .clock-minimal .plain-num { font-size: 96px; }
.timer-page.compact .clock-neon .plain-num,
.timer-page.compact .clock-outline .plain-num { font-size: 96px; }
.timer-page.compact .clock-neon .plain-clock,
.timer-page.compact .clock-outline .plain-clock { padding: 12px 34px; }
.timer-page.compact .clock-jelly .plain-num { font-size: 96px; }

.timer-page.compact .led-clock { gap: 6px; padding: 12px 22px; }
.timer-page.compact .led-digit { flex-basis: 68px; width: 68px; height: 116px; }
.timer-page.compact .led-colon { flex-basis: 9px; width: 9px; height: 68px; gap: 18px; }
.timer-page.compact .led-dot { width: 8px; height: 8px; }

/* 非紧凑窗口同步放大，保持各时钟比例一致 */
.flip-card { width: 74rpx; height: 128rpx; }
.flip-num { font-size: 52rpx; line-height: 128rpx; }
.flip-colon { font-size: 32rpx; }
.block-tile { width: 56rpx; height: 74rpx; }
.block-num { font-size: 40rpx; }
.block-colon { font-size: 30rpx; }
.plain-num { font-size: 88rpx; }
.clock-gradient .plain-num { font-size: 84rpx; }
.clock-minimal .plain-num { font-size: 80rpx; }
.clock-neon .plain-num, .clock-outline .plain-num { font-size: 84rpx; }
.clock-jelly .plain-num { font-size: 84rpx; }
.led-digit { flex-basis: 66px; width: 66px; height: 108px; }
.led-colon { flex-basis: 9px; width: 9px; height: 60px; gap: 16px; }

/* 全屏过渡：不再换字号/换尺寸，只让时钟做一次连续的位移 + 缩放形变
   起点由 timer.js 量出（时钟中心 → 页面中心），因此布局切换那一帧的画面与原画面完全重合 */
.timer-page {
  --immersive-clock-scale: 1.28;
}
.timer-page.clock-flip { --immersive-clock-scale: 1.28; }
.timer-page.clock-blocks { --immersive-clock-scale: 1.32; }
.timer-page.clock-led { --immersive-clock-scale: 1.12; }
.timer-page.clock-gradient { --immersive-clock-scale: 1.25; }
.timer-page.clock-minimal { --immersive-clock-scale: 1.23; }
.timer-page.clock-neon,
.timer-page.clock-outline,
.timer-page.clock-jelly { --immersive-clock-scale: 1.26; }

.timer-page .clock-body {
  transform-origin: center center;
  transition: transform .44s cubic-bezier(.22, .78, .26, 1);
}

/* 形变起步的那一帧先关掉过渡与布局过渡，等下一帧再放开，避免起点被二次补间 */
.timer-page.clock-morphing .clock-body { transition: none; }
.timer-page.clock-morphing .module-side,
.timer-page.clock-morphing .timer-main { transition: none; }

/* ===== 时钟皮肤收口：颜色一律取自 styles/clocks.wxss，页面里不再各写一份 ===== */
.block-tile { background: var(--clk-tile); border-color: var(--clk-line); }
.block-num,
.block-colon { color: var(--clk-ink); }
.clock-led .led-seg.on,
.clock-led .led-dot { background: var(--clk-glow); box-shadow: 0 0 6px var(--clk-glow), 0 0 14px var(--clk-glow); }
.clock-gradient .plain-num { color: var(--clk-ink); }
.clock-minimal .plain-num { color: var(--clk-ink); }
.clock-neon .plain-num { color: var(--clk-ink); }
.clock-outline .plain-num { -webkit-text-stroke-color: var(--clk-ink); }
.clock-jelly .plain-num { color: var(--clk-ink); }

/* 全屏闲置：退出键静置 3s 自动收纳，点屏幕任何位置唤回（只动透明度/缩放，不参与布局） */
.timer-page.immersive .immersive-toggle { transition: transform .26s cubic-bezier(.2, .9, .3, 1), opacity .26s ease, background-color .18s ease, box-shadow .18s ease; }
.timer-page.immersive.chrome-idle .immersive-toggle { opacity: 0; transform: scale(.86); pointer-events: none; }
/* 竖屏沉浸：退出键同样让开状态栏；系统胶囊仍在，别贴着顶部 */
.timer-page.portrait.immersive .immersive-toggle {
  top: var(--portrait-top, calc(env(safe-area-inset-top) + 10px));
}

/* 时钟尺寸不再靠“先写死高度再 transform 放大”，统一交给 .clock-slot + --clk-fit（见文件末尾） */

/* TARGET / ON TRACK 下移一档并左右向中间收拢；两级下方各挂一个胶囊 */
.stage-target { padding: 0 12%; }
.timer-page.compact .stage-target { padding: 0 12%; }

/* ==================== 竖屏一套（窗口高>宽时启用，独立样式，横屏规则一条不改） ==================== */
.timer-page.portrait {
  flex-direction: column;
  padding: 8rpx 18rpx calc(8rpx + env(safe-area-inset-bottom));
}
.timer-page.portrait .portrait-main {
  position: relative;
  width: 100%;
  flex: 1 1 auto;
  min-height: 0;
}
.timer-page.portrait .portrait-stage {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 0 0 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
}
/* 顶部：模块名 + 模块时间 */
.timer-page.portrait .stage-meta { margin: 0; gap: 10px; }
/* 正计时 / 倒计时标签：竖屏右上角悬浮，不占布局高度 */
.timer-page.portrait .portrait-corner {
  position: absolute;
  z-index: 22;
  top: var(--portrait-corner-top, calc(env(safe-area-inset-top) + 46px));
  right: 6px;
  display: flex;
  justify-content: flex-end;
}
.timer-page.portrait .portrait-corner .mode-chip { position: static; align-self: flex-end; margin: 0; }
/* 嘀嗒开关：进度条正下方一行，居中 */
.timer-page.portrait .tick-pill { margin: 6px 0 0; align-self: center; }
/* 第三行：固定大小的大时钟（8 种样式同一尺寸，整排缩放到 375 宽不出界） */
.timer-page.portrait .clock-stage {
  position: relative;
  top: 0;
  width: 100%;
  height: auto;
  padding: 0;
  gap: 0;
}
/* 容器尺寸由窗口算出（JS 写 --slot-w / --slot-h），与皮肤无关 */
.timer-page .clock-slot {
  position: relative;
  width: var(--slot-w, 100%);
  height: var(--slot-h, 150px);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
/* 实际可视高度兜底：即使系统上报的 windowHeight 偏大，也不让时钟槽位挤掉顶部模块行与底部按钮 */
.timer-page:not(.immersive) .clock-slot {
  max-height: calc(100vh - 230px);
}
/* 竖屏时钟的大小不再写死 0.7，统一交给 JS 实测后写出的 --clk-fit 决定（见文件末尾） */
.timer-page.portrait .clock-slot .clock-body {
  flex: 0 0 auto;
}
/* 第四行：进度条 */
.timer-page.portrait .progress-rail {
  --rail-pad: 32px;
  width: 92%;
  margin: 0 auto;
  padding-bottom: var(--rail-pad);
}
.timer-page.portrait .stage-progress { max-width: 100%; }
.timer-page.portrait .quote-slot { margin: 0; }
.timer-page.portrait .time-quote { width: 92%; max-width: 92%; padding: 0; margin: 0; }
/* 第五行：两个英文标签 */
.timer-page.portrait .stage-target {
  width: 92%;
  margin: 0 auto;
  padding: 0;
}
/* 第六行：四个按键 */
.timer-page.portrait .controls {
  width: 92%;
  margin: 14px auto 0;
  padding: 0;
  gap: 0;
  justify-content: space-between;
}
.timer-page.portrait .prev-button,
.timer-page.portrait .pause-button,
.timer-page.portrait .complete-button {
  flex: 0 0 62px;
  width: 62px;
  min-width: 62px;
  max-width: 62px;
  height: 62px;
  min-height: 62px;
  max-height: 62px;
  border-width: 3px;
  font-size: 27px;
}
.timer-page.portrait .prev-button { font-size: 23px; }
.timer-page.portrait .complete-button { font-size: 30px; }
.timer-page.portrait .next-button {
  flex: 0 0 auto;
  width: auto !important;
  min-width: 0;
  max-width: none;
  height: 56px;
  min-height: 56px;
  padding: 0 16px;
  gap: 6px;
  border-width: 3px;
  font-size: 15px;
}
.timer-page.portrait .next-arrow { font-size: 14px; }
/* 第七行：可收纳的模块分栏 */
.timer-page.portrait .module-side {
  width: 100%;
  height: 24vh;
  flex: 0 0 24vh;
  max-height: 24vh;
  padding: 8px 0 0;
  border-top: 2px solid var(--line);
}
.timer-page.portrait .module-list { border-radius: 16rpx; margin: 4rpx 0; }
.timer-page.portrait .module-toggle {
  top: auto;
  bottom: 24vh;
  right: 10px;
  transform: none;
  width: 26px;
  height: 26px;
  z-index: 41;
  background: var(--cream-1);
  border: 2px solid var(--line-strong);
  border-radius: 999px;
  opacity: .92;
}
.timer-page.portrait.module-collapsed .module-toggle { right: 10px; bottom: 10px; }
.timer-page.portrait.module-collapsed .module-side { display: none; }
/* 竖屏：避开系统状态栏与微信右上角胶囊，全屏按钮不压时间 */
.timer-page.portrait .immersive-toggle {
  top: var(--portrait-top, calc(env(safe-area-inset-top) + 10px));
}

/* 竖屏全屏：只留大时钟（三优先级压过 .compact / .immersive 的两段规则） */
.timer-page.portrait.immersive { padding: 0; }
.timer-page.portrait.immersive .portrait-corner,
.timer-page.portrait.immersive .tick-pill,
.timer-page.portrait.immersive .stage-meta,
.timer-page.portrait.immersive .stage-target,
.timer-page.portrait.immersive .quote-slot,
.timer-page.portrait.immersive .time-quote,
.timer-page.portrait.immersive .progress-rail,
.timer-page.portrait.immersive .controls,
.timer-page.portrait.immersive .module-side,
.timer-page.portrait.immersive .module-toggle { display: none; }
.timer-page.portrait.immersive .portrait-stage { padding-top: 0; gap: 0; justify-content: center; }
.timer-page.portrait.immersive .clock-stage { height: auto; flex: 0 0 auto; justify-content: center; }
.timer-page.portrait.immersive .clock-slot { height: 100%; }

/* 右上角悬浮：正计时 / 倒计时标签 + 嘀嗒开关，纵向排列，不占布局高度 */
.corner-chips {
  position: absolute;
  z-index: 22;
  top: calc(env(safe-area-inset-top) + 44px);
  right: 14px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
}
.timer-main .corner-chips .mode-chip { position: static; align-self: flex-end; margin: 0; }
.timer-main .corner-chips .tick-pill { margin-top: 0; }

/* ================= 选择模块：logo 悬浮球 + 弹出面板（横竖屏共用） ================= */
.module-fab {
  position: absolute;
  z-index: 40;
  right: 16px;
  bottom: var(--fab-bottom, 18px);
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--card);
  border: 2px solid var(--edge);
  box-shadow: 4px 5px 0 var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .26s cubic-bezier(.2, .9, .3, 1), box-shadow .26s ease;
  will-change: transform;
}
.module-fab.dragging,
.module-fab.settling { transition: none; }
.module-fab.dragging { box-shadow: 2px 3px 0 var(--shadow); }
.module-fab:active { box-shadow: 2px 3px 0 var(--shadow); }
.module-fab.open { transform: scale(.9) rotate(-8deg); box-shadow: 2px 3px 0 var(--shadow); }
.module-fab-logo { width: 32px; height: 32px; }

.module-mask {
  position: absolute;
  z-index: 38;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 40, 60, .14);
  opacity: 0;
  pointer-events: none;
  transition: opacity .24s ease;
}
.module-mask.show { opacity: 1; pointer-events: auto; }

.module-panel {
  position: absolute;
  z-index: 39;
  right: 16px;
  bottom: var(--panel-bottom, 82px);
  top: auto;
  width: 316px;
  max-width: 82vw;
  max-height: var(--panel-max, 54vh);
  box-sizing: border-box;
  padding: 10px 8px 6px;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border: 2px solid var(--edge);
  border-radius: 20px;
  box-shadow: 6px 8px 0 var(--shadow);
  opacity: 0;
  transform: translateY(12px) scale(.94);
  transform-origin: bottom right;
  pointer-events: none;
  transition: opacity .22s ease, transform .26s cubic-bezier(.2, .9, .3, 1);
}
.module-panel.up { bottom: var(--panel-bottom, 82px); top: auto; transform-origin: bottom right; }
.module-panel.down { top: var(--panel-top, 82px); bottom: auto; transform: translateY(-12px) scale(.94); transform-origin: top right; }
.module-panel.down.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.module-panel.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.module-panel-head { display: flex; align-items: center; justify-content: space-between; padding: 0 10px 8px; }
.module-panel-title { font-size: 15px; font-weight: 900; color: var(--ink); }
.module-panel-count { font-size: 13px; font-weight: 900; color: var(--text-3); }
.module-panel-body { flex: 1 1 auto; min-height: 0; max-height: var(--panel-body-max, 200px); }
.module-panel-body::-webkit-scrollbar { width: 0 !important; height: 0 !important; display: none !important; }

/* 竖屏：球与面板贴右下，面板更宽一些，方便单手点 */
.timer-page.portrait .module-fab { right: 14px; bottom: var(--fab-bottom, 20px); }
.timer-page.portrait .module-panel { right: 14px; width: 86%; max-width: 340px; max-height: var(--panel-max, 48vh); }
.timer-page.portrait .module-panel-body { max-height: var(--panel-body-max, 180px); }

/* 全屏时球和面板一起收起 */
.timer-page.immersive .module-fab,
.timer-page.immersive .module-mask,
.timer-page.immersive .module-panel { display: none; }

.timer-page.reveal .module-fab { animation: timer-chip-in .4s .16s cubic-bezier(.2, .9, .3, 1) backwards; }

/* 面板里的模块列表：比原分栏字号更大，便于点选 */
.module-panel .module-list {
  padding: 10px 10px;
  margin: 4px 0;
  border-radius: 14px;
  font-size: 15px;
}
.module-panel .module-list.selected { transform: none; box-shadow: 3px 4px 0 var(--shadow); border-width: 2px; }
.module-panel .module-index { flex: 0 0 20px; width: 20px; font-size: 15px; }
.module-panel .module-info { font-size: 15px; gap: 2px; }
.module-panel .module-info .mi-num { font-size: 13px; }

/* 横屏嘀嗒开关：进度条正下方一行，居中 */
.timer-page.compact .clock-stage .tick-pill { margin: 4px 0 0; align-self: center; }
.timer-page.landscape .clock-stage .tick-pill { margin: 4px 0 0; align-self: center; }

/* 全屏沉浸：给时钟一个固定大小、看不见的框（98vw × 90vh），时钟缩放到框里居中，
   倍率 --ic 由 timer.js 按「当前皮肤实测原始尺寸 × 倍率 ≈ 94vw / 86vh」算出来，
   框本身无底色无边框，只负责把内容限制在屏幕内 */
.timer-page.immersive .timer-main .clock-stage,
.timer-page.immersive .portrait-main .clock-stage {
  position: relative;
  top: 0;
  width: 98vw;
  height: 90vh;
  padding: 0;
  gap: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(var(--ic, 1));
  transform-origin: center center;
  transition: transform .44s cubic-bezier(.22, .78, .26, 1);
  overflow: visible;
}
.timer-page.clock-morphing .clock-stage { transition: none; }

/* 全屏时把子层的零散缩放全部清零（紧凑档 1.15 / 竖屏 0.70），避免与上面的倍率互相削弱 */
.timer-page.immersive .clock-stage .clock-flip-host,
.timer-page.immersive .clock-stage .block-row,
.timer-page.immersive .clock-stage .led-clock,
.timer-page.immersive .clock-stage .plain-clock,
.timer-page.immersive .clock-stage .clock-slot,
.timer-page.immersive .clock-stage .clock-slot .clock-flip-host,
.timer-page.immersive .clock-stage .clock-slot .block-row,
.timer-page.immersive .clock-stage .clock-slot .led-clock,
.timer-page.immersive .clock-stage .clock-slot .plain-clock {
  transform: none;
}

/* 横竖屏切换：时钟从旧位置平滑滑到新位置（起点由 timer.js 量出来，过渡结束后清空内联样式） */
.timer-page.orient-anim .clock-stage { transition: transform .46s cubic-bezier(.22, .78, .26, 1); }
.timer-page.orient-anim .clock-stage .clock-slot { transition: transform .46s cubic-bezier(.22, .78, .26, 1); }

/* ===== 大窗口横屏（电脑 / 平板）：组件各归其位、靠向屏幕四周，
 * 与边缘固定留白，只做小幅放大，不再全部挤在屏幕中间 ===== */
.timer-page.wide .timer-main { padding: 0 26px 20px; }
.timer-page.wide .immersive-toggle { left: calc(env(safe-area-inset-left) + 22px); }
.timer-page.wide .corner-chips { top: calc(env(safe-area-inset-top) + 14px); right: 26px; }
.timer-page.wide .clock-stage { top: 6px; }
.timer-page.wide:not(.immersive) .clock-slot { max-height: calc(100vh - 270px); }
.timer-page.wide .progress-rail { width: 100%; max-width: 760px; margin: 0 auto; }
.timer-page.wide .stage-target { width: 100%; max-width: 760px; margin: 0 auto; padding: 0 10px; }
.timer-page.wide .controls { width: 100%; max-width: var(--slot-w, 100%); margin: 8px auto 0; padding: 0 2px; justify-content: space-between; gap: 0; }

/* 时钟：只比紧凑档放大一档，约 8% */
.timer-page.wide .clock-stage .clock-flip-host,
.timer-page.wide .clock-stage .block-row,
.timer-page.wide .clock-stage .led-clock,
.timer-page.wide .clock-stage .plain-clock { height: 140px; }
.timer-page.wide .stage-meta { margin: 2px 0 18px; gap: 18px; }
.timer-page.wide .flip-card { width: 62px; height: 102px; }
.timer-page.wide .flip-num { font-size: 43px; line-height: 102px; }
.timer-page.wide .flip-colon { font-size: 28px; }
.timer-page.wide .block-tile { width: 64px; height: 102px; }
.timer-page.wide .block-num { font-size: 39px; }
.timer-page.wide .plain-num { font-size: 68px; }
.timer-page.wide .led-digit { flex-basis: 54px; width: 54px; height: 98px; }

/* ===== 大窗口（电脑 / 平板横屏）：时钟长宽高等比放大 =====
 * 原来只改了高度（甚至比手机档还窄），这里统一用 --ts 倍率乘原始尺寸，
 * 宽高同步放大、比例不变；外围组件用更温和的 --cs，避免按钮变成巨块。
 * 沉浸模式有自己的 --ic 倍率，用 :not(.immersive) 排除。
 */
/* ===== 大窗口：时钟不再按皮肤各写一套倍数
 * 之前用 --ts 把翻页牌、积木、LED、数字分别放大，翻页组件再套一层 transform: scale，
 * transform 不改布局 → 牌面视觉溢出容器，直接压住下面的进度条。
 * 现在所有皮肤只按自身原始宽高渲染，由 .clock-slot 的 --clk-fit（zoom）统一等比塞进容器。
 */
/* 外围组件：模块名 / 目标 / 进度 / 控制按钮 / 状态胶囊，温和跟随 */
.timer-page.wide:not(.immersive) .stage-meta {
  font-size: 20px;
  gap: 14px;
  margin: 2px 0 calc(16px * var(--cs, 1));
}
/* 模块名和时间在 rpx 下会跟着大窗口一起涨到 30px 以上，挤出进度条下方的空隙；
   这里单独设上限，保证只占一行、不压到目标与名言 */
.timer-page.wide:not(.immersive) .stage-meta .meta-module { font-size: 20px; }
.timer-page.wide:not(.immersive) .stage-meta .meta-total { margin-left: 0; font-size: 18px; }
.timer-page.wide:not(.immersive) .stage-target {
  max-width: var(--slot-w, 100%);
  margin: calc(6px * var(--cs, 1)) auto 0;
  font-size: calc(11px * var(--cs, 1));
  padding: 0 calc(12px * var(--cs, 1));
}
.timer-page.wide:not(.immersive) .progress-rail {
  --rail-pad: 28px;
  max-width: var(--slot-w, 100%);
  padding-bottom: var(--rail-pad);
}
.timer-page.wide:not(.immersive) .progress-rail .stage-progress { height: calc(7px * var(--cs, 1)); }
.timer-page.wide:not(.immersive) .controls { max-width: var(--slot-w, 100%); gap: 0; }
.timer-page.wide:not(.immersive) .pause-button,
.timer-page.wide:not(.immersive) .prev-button,
.timer-page.wide:not(.immersive) .complete-button {
  flex: 0 0 calc(64px * var(--cs, 1));
  width: calc(64px * var(--cs, 1));
  min-width: calc(64px * var(--cs, 1));
  max-width: calc(64px * var(--cs, 1));
  height: calc(64px * var(--cs, 1));
  min-height: calc(64px * var(--cs, 1));
  max-height: calc(64px * var(--cs, 1));
  font-size: calc(27px * var(--cs, 1));
}
.timer-page.wide:not(.immersive) .next-button {
  height: calc(58px * var(--cs, 1));
  min-height: calc(58px * var(--cs, 1));
  padding: 0 calc(16px * var(--cs, 1)) 0 calc(18px * var(--cs, 1));
  font-size: calc(19px * var(--cs, 1));
}
.timer-page.wide:not(.immersive) .tick-pill {
  margin-top: calc(10px * var(--cs, 1));
  padding: calc(4px * var(--cs, 1)) calc(12px * var(--cs, 1));
  font-size: calc(13px * var(--cs, 1));
}
.timer-page.wide:not(.immersive) .mode-chip {
  padding: calc(4px * var(--cs, 1)) calc(11px * var(--cs, 1));
  font-size: calc(13px * var(--cs, 1));
}

/* ===== 切换时钟样式的提示：短暂浮现，颜色跟主题走 ===== */
.style-hint {
  position: fixed;
  z-index: 40;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 104px);
  padding: calc(7px * var(--cs, 1)) calc(14px * var(--cs, 1));
  transform: translate(-50%, 8px);
  opacity: 0;
  pointer-events: none;
  color: var(--on-primary);
  background: var(--primary);
  border: 2px solid var(--edge);
  border-radius: 999px;
  box-shadow: 3px 4px 0 var(--shadow);
  font-size: calc(14px * var(--cs, 1));
  font-weight: 900;
  letter-spacing: 1px;
  white-space: nowrap;
  transition: opacity .18s ease, transform .18s ease;
}
.style-hint.show { transform: translate(-50%, 0); opacity: 1; }

/* ===== 时钟自适应：任何样式、任何窗口都不许越界 =====
 * JS（timer.js fitClock）按实测宽高把 --clk-fit 写成 0.55~1，
 * 这里用 zoom 应用：zoom 会真的改变布局尺寸，时钟缩小时
 * 模块名 / 进度条 / 按钮会一起往中间收，不会「视觉小了但还占着原来那么宽」。
 * 全屏（immersive）由沉浸布局自己的倍率负责，这里必须关掉，避免叠加缩小。
 */
.timer-page .clock-body { zoom: var(--clk-fit, 1); transform: scale(var(--clk-scale, 1)); transform-origin: center center; }
.timer-page.immersive .clock-body { zoom: 1; }
.timer-page.immersive .clock-slot { width: 100%; height: 100%; }

/* 模块名 + 模块时间：宁可省略模块名，也不许把时间顶出屏幕 */
.timer-page .stage-meta { max-width: 100%; box-sizing: border-box; padding: 0 6px; }
.timer-page .stage-meta .meta-module {
  max-width: 58%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.timer-page .stage-meta .meta-total { flex: 0 0 auto; white-space: nowrap; }
.timer-page .stage-target { box-sizing: border-box; padding: 0 6px; }

/* 矮窗口（手机横屏、分屏小窗）：上下间距一口气收紧，
 * 把省出来的高度全给时钟，模块名 / 进度 / 按钮依然完整可见 */
@media (max-height: 430px) {
  .timer-page.compact { padding: 4px 12px 10px; }
  .timer-page.compact .timer-main { padding: 0 8px 8px; }
  .timer-page.compact .clock-stage { top: 0; padding: 4px 0 0; gap: 5px; }
  .timer-page.compact .stage-meta { font-size: 13px; gap: 10px; margin: 0 0 2px; }
  .timer-page.compact .meta-total { margin-left: 4px; font-size: 13px; }
  .timer-page.compact .stage-target { font-size: 12px; }
  .timer-page.compact .ms-line { margin-bottom: 1px; font-size: 12px; }
  .timer-page.compact .tick-pill { margin-top: 0; padding: 2px 9px; font-size: 12px; }
  .timer-page.compact .tick-icon { font-size: 13px; }
  .timer-page.compact .controls { margin-top: 2px; }
  .timer-page.compact .pause-button,
  .timer-page.compact .complete-button,
  .timer-page.compact .prev-button { flex: 0 0 58px; width: 58px; min-width: 58px; max-width: 58px; height: 58px; min-height: 58px; max-height: 58px; font-size: 27px; }
  .timer-page.compact .prev-button { font-size: 24px; }
  .timer-page.compact .complete-button { font-size: 29px; }
}

/* 模块名与模块时间悬浮在进度条与名言之间：绝对定位在进度轨道的底部内距里，
   不参与中部舞台的高度计算，进度条和时钟的尺寸都不动。 */
.timer-page:not(.immersive) .stage-meta {
  position: absolute;
  z-index: 12;
  top: calc(100% - var(--rail-pad, 22px));
  left: 0;
  right: 0;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0 12px;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  pointer-events: none;
}
.timer-page.wide:not(.immersive) .stage-meta {
  top: calc(100% - var(--rail-pad, 22px));
  margin: 0;
}

/* 描边空心没有外壳，内距会白白算进「原始尺寸」，导致 JS 把整钟缩得更小（字反而更细更小）
   —— 计时页里直接清零，让轮廓字铺满容器 */
.timer-page.clock-outline .plain-clock,
.timer-page.compact .clock-outline .plain-clock,
.timer-page.wide .clock-stage .clock-outline .plain-clock {
  padding: 0 !important;
}
