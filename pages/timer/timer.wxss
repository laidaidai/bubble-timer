page { height: 100%; overflow: hidden; background:var(--bg); }
.timer-page { height: 100%; min-height: 0; background: var(--bg); display: flex; overflow: hidden; padding: 8rpx 24rpx; box-sizing: border-box; color:var(--ink); }
.timer-main { flex: 1; min-width: 0; height: 100%; padding: 0 24rpx 0 0; align-items: center; display: flex; flex-direction: column; justify-content: center; box-sizing: border-box; border-right:2rpx solid var(--line); }
.clock-stage { position: relative; width: 100%; padding: 22rpx 0 6rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx; border-radius: 28rpx; }

/* 翻页时钟 */
.flip-row { display: flex; align-items: center; gap: 4rpx; perspective: 760rpx; }
.flip-colon { color:var(--ink); font-size: 24rpx; font-weight: 900; padding: 0 1rpx; }
.flip-card { position: relative; width: 80rpx; height: 98rpx; display: flex; align-items: center; justify-content: center; background:var(--panel); border:2rpx solid var(--edge-deep); border-radius: 10rpx; box-shadow:3rpx 4rpx 0 var(--shadow-soft); transform-origin: center center; backface-visibility: hidden; }
.flip-card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 50%; background: linear-gradient(180deg, rgba(255, 255, 255, .08), rgba(255, 255, 255, 0)); border-radius: 10rpx 10rpx 0 0; }
.flip-split { position: absolute; left: 0; right: 0; top: 50%; height: 2rpx; margin-top: -1rpx; background:var(--panel-deep); }
.flip-num { color:var(--accent-text); font-family: "Courier New", "Menlo", monospace; font-size: 46rpx; font-weight: 900; line-height: 1; letter-spacing: 0; }
.flip-a { animation: flip-turn-a 720ms cubic-bezier(0.4, 0.05, 0.3, 1); }
.flip-b { animation: flip-turn-b 720ms cubic-bezier(0.4, 0.05, 0.3, 1); }
@keyframes flip-turn-a {
  0% { transform: rotateX(-88deg); opacity: .75; }
  50% { transform: rotateX(-12deg); opacity: .92; }
  88% { transform: rotateX(4deg); opacity: 1; }
  100% { transform: rotateX(0deg); }
}
@keyframes flip-turn-b {
  0% { transform: rotateX(-88deg); opacity: .75; }
  50% { transform: rotateX(-12deg); opacity: .92; }
  88% { transform: rotateX(4deg); opacity: 1; }
  100% { transform: rotateX(0deg); }
}

/* 积木方块 */
.block-row { display: flex; align-items: center; gap: 6rpx; }
.block-colon { color:var(--ink); font-size: 24rpx; font-weight: 900; margin: 0 1rpx; }
.block-tile { width: 42rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; background:var(--card); border:2rpx solid var(--edge); border-radius: 10rpx; box-shadow:3rpx 4rpx 0 var(--shadow); }
.block-num { color:var(--ink); font-family: "Courier New", "Menlo", monospace; font-size: 30rpx; font-weight: 900; line-height: 1; }

/* 数字时钟 */
.plain-clock { display: flex; align-items: center; justify-content: center; }
.plain-num { font-family: "Courier New", "Menlo", monospace; font-weight: 900; line-height: 1; }
.clock-digital .plain-num { padding: 10rpx 28rpx; color:var(--on-panel-warm); background:var(--panel); border-radius: 18rpx; box-shadow:5rpx 6rpx 0 var(--shadow-soft), inset 0 0 30rpx rgba(255, 209, 102, .16); font-size: 66rpx; letter-spacing: 2rpx; text-shadow: 0 0 14rpx rgba(255, 209, 102, .55); }

/* 极简线条 */
.clock-minimal .plain-num { color:var(--ink); font-size: 62rpx; font-weight: 300; letter-spacing: 5rpx; }
.clock-minimal .clock-stage { background: transparent; }
.clock-minimal 
.stage-meta { margin-top: 0; display: flex; align-items: baseline; gap: 22rpx; color:var(--text-warm); font-size: 18rpx; }
.meta-module { color:var(--ink); font-weight: 900; }
.meta-total { margin-left: 10rpx; color:var(--text-2); font-size: 18rpx; }
.stage-progress { width: 360rpx; height: 8rpx; margin-top: 2rpx; overflow: hidden; background:var(--track); border:2rpx solid var(--edge); border-radius: 999rpx; }
.stage-progress-fill { height: 100%; background:var(--primary-2); }
.overtime-fill { background:var(--danger); }
.stage-target { width: 360rpx; display: flex; justify-content: space-between; color:var(--text-2); font-size: 18rpx; font-weight: 900; }
.on-track { color:var(--success-text); }
.overtime { color:var(--danger-text); }

.controls { margin: 6rpx 0 0; display: flex; justify-content: center; gap: 16rpx; }
.pause-button, .complete-button { flex: 0 0 58rpx; width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; min-height: 58rpx; max-height: 58rpx; box-sizing: border-box; padding: 0; display: flex; align-items: center; justify-content: center; border:3rpx solid var(--edge); border-radius: 50%; box-shadow:3rpx 4rpx 0 var(--shadow); font-size: 26rpx; line-height: 1; text-align: center; }
.pause-button { color:var(--ink); background:var(--primary); }
.complete-button { position: relative; color:var(--ink); background:var(--cream-1); }
.complete-button.holding { animation: complete-hold-fill 1s linear forwards; }
@keyframes complete-hold-fill {
  from { background:var(--cream-1); }
  to { background:var(--primary); }
}
.complete-button text { position: absolute; right: 7rpx; bottom: 9rpx; font-size: 18rpx; font-weight: 900; }

.module-side { width: 34%; height: 100%; min-height: 0; padding-left: 24rpx; box-sizing: border-box; }
.module-list { min-height: 0; margin: 4rpx 0 6rpx; padding: 11rpx 12rpx; display: flex; align-items: center; color:var(--text-4); }
.module-list.selected { color:var(--ink); background:var(--card); border:3rpx solid var(--edge); border-radius: 20rpx; box-shadow:5rpx 6rpx 0 var(--shadow); }
.module-index { width: 30rpx; font-size: 21rpx; font-weight: 900; }
.module-info { display: flex; flex-direction: column; gap: 2rpx; font-size: 21rpx; font-weight: 800; }
.module-info text:last-child { color:var(--text-2); font-size: 18rpx; font-weight: 900; }

.style-hint { position: absolute; top: 0; left: 50%; display: flex; align-items: center; gap: 6rpx; padding: 5rpx 16rpx; color: var(--text-mid); background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 18rpx; font-weight: 800; white-space: nowrap; animation: hint-pop 2.6s ease forwards; }
.hint-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary-2); }
@keyframes hint-pop {
  0% { opacity: 0; transform: translateX(-50%) translateY(-6rpx); }
  14% { opacity: 1; transform: translateX(-50%) translateY(0); }
  78% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-6rpx); }
}

.ms-line { display: block; margin-bottom: 6rpx; color: var(--text-3); font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 1.1; }
.ms-val { color: var(--text-2); font-family: "Courier New", Menlo, monospace; font-weight: 800; font-variant-numeric: tabular-nums; }

.next-button { flex: 0 0 auto; height: 58rpx; min-height: 58rpx; margin: 0; padding: 0 16rpx 0 18rpx; display: flex; align-items: center; gap: 6rpx; color: var(--ink); background: var(--cream-1); border: 3rpx solid var(--edge); border-radius: 999rpx; box-shadow: 3rpx 4rpx 0 var(--shadow); font-size: 19rpx; font-weight: 900; line-height: 1; white-space: nowrap; }
.next-arrow { color: var(--primary-2); font-size: 18rpx; }

.mode-chip { position: static; align-self: flex-start; margin: 0 0 4rpx 2rpx; display: flex; align-items: center; gap: 6rpx; padding: 5rpx 12rpx; color: var(--text-warm); background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 18rpx; font-weight: 900; }
.mode-chip.focus { color: var(--on-panel); background: var(--primary-2); border-color: var(--edge); }
.mode-chip.rest { color: var(--on-panel); background: var(--success); border-color: var(--edge); }
.mode-phase { font-size: 18rpx; font-weight: 900; letter-spacing: 1rpx; }

.prev-button { flex: 0 0 58rpx; width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; min-height: 58rpx; max-height: 58rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; color: var(--ink); background: var(--cream-1); border: 3rpx solid var(--edge); border-radius: 50%; box-shadow: 3rpx 4rpx 0 var(--shadow); font-size: 22rpx; line-height: 1; }
.prev-button.disabled { opacity: .38; }
