<view class="timer-page theme-{{theme}} clock-{{clockStyle}} {{compact ? 'compact' : ''}} {{immersive ? 'immersive' : ''}}" style="{{themeStyle}}">
  <view class="timer-main">
    <view class="immersive-toggle {{immersive ? 'on' : ''}}" catchtap="toggleImmersive">
      <view class="fs-icon" wx:if="{{!immersive}}">
        <view class="fs-corner fs-tl"></view>
        <view class="fs-corner fs-tr"></view>
        <view class="fs-corner fs-bl"></view>
        <view class="fs-corner fs-br"></view>
      </view>
      <view class="fs-exit" wx:else><text class="fs-exit-char">‹</text></view>
    </view>
    <view class="mode-chip {{phaseLabel ? (phaseLabel === '专注' ? 'focus' : 'rest') : ''}}">
      <text>{{modeName}}</text>
      <text class="mode-phase" wx:if="{{phaseLabel}}">{{phaseLabel}}</text>
    </view>
    <view class="clock-stage" bindtap="cycleClockStyle">
      <text class="ms-line">{{mainLabel}} <text class="ms-val">+{{msText}}</text> ms</text>

      <!-- 翻页时钟 -->
      <view class="flip-row" wx:if="{{clockStyle === 'flip'}}">
        <block wx:for="{{flipCells}}" wx:key="key">
          <view class="flip-colon" wx:if="{{item.sep}}">:</view>
          <view class="flip-card {{item.changed ? (flipPhase ? 'flip-a' : 'flip-b') : ''}}" wx:else>
            <view class="flip-face flip-face-top"><text class="flip-num">{{item.text}}</text></view>
            <view class="flip-face flip-face-bottom"><text class="flip-num">{{item.text}}</text></view>
            <view class="flip-face flip-face-bottom flip-face-old" wx:if="{{item.changed}}"><text class="flip-num">{{item.oldText}}</text></view>
            <view class="flip-flap flip-flap-top" wx:if="{{item.changed}}">
              <view class="flip-flap-face"><text class="flip-num">{{item.oldText}}</text></view>
            </view>
            <view class="flip-flap flip-flap-bottom" wx:if="{{item.changed}}">
              <view class="flip-flap-face flip-flap-face-bottom"><text class="flip-num">{{item.text}}</text></view>
            </view>
            <view class="flip-split"></view>
          </view>
        </block>
      </view>

      <!-- 积木方块 -->
      <view class="block-row" wx:elif="{{clockStyle === 'blocks'}}">
        <block wx:for="{{flipDigits}}" wx:key="key">
          <view class="block-colon" wx:if="{{item.sep}}">:</view>
          <view class="block-tile" wx:else><text class="block-num">{{item.text}}</text></view>
        </block>
      </view>

      <!-- LED 数码管 -->
      <view class="led-clock" wx:elif="{{clockStyle === 'led'}}">
        <block wx:for="{{ledDigits}}" wx:key="key">
          <view class="led-colon" wx:if="{{item.sep}}">
            <view class="led-dot"></view>
            <view class="led-dot"></view>
          </view>
          <view class="led-digit" wx:else>
            <view class="led-seg seg-a {{item.segs[0] ? 'on' : ''}}"></view>
            <view class="led-seg seg-b {{item.segs[1] ? 'on' : ''}}"></view>
            <view class="led-seg seg-c {{item.segs[2] ? 'on' : ''}}"></view>
            <view class="led-seg seg-d {{item.segs[3] ? 'on' : ''}}"></view>
            <view class="led-seg seg-e {{item.segs[4] ? 'on' : ''}}"></view>
            <view class="led-seg seg-f {{item.segs[5] ? 'on' : ''}}"></view>
            <view class="led-seg seg-g {{item.segs[6] ? 'on' : ''}}"></view>
          </view>
        </block>
      </view>

      <!-- 数字时钟 / 极简 -->
      <view class="plain-clock" wx:else>
        <text class="plain-num {{clockStyle === 'digital' ? 'glow' : 'thin'}}">{{mainTimeText}}</text>
      </view>

      <view class="stage-meta">
        <text class="meta-module">{{currentModule.name || '训练完成'}}</text>
        <text class="meta-total"><text class="num">{{moduleTimeText}}</text></text>
      </view>

      <view class="stage-progress">
        <view class="stage-progress-fill {{isOvertime ? 'overtime-fill' : ''}}" style="width: {{progressPercent}}%;"></view>
      </view>
      <view class="stage-target">
        <text>TARGET: <text class="num">{{currentModule.targetMinutes}}</text> 分</text>
        <text class="{{isOvertime ? 'overtime' : 'on-track'}}">{{isOvertime ? 'OVERTIME' : 'ON TRACK'}}</text>
      </view>
      <view class="tick-pill {{tickMuted ? 'muted' : ''}}" catchtap="toggleTick">
        <text class="tick-icon">♪</text>
        <text>{{tickMuted ? '滴答 · 静音' : '滴答 · 开'}}</text>
      </view>
    </view>

    <view class="controls">
      <button class="prev-button {{isFirstModule ? 'disabled' : ''}}" bindtap="prevModule">◀</button>
      <button class="pause-button" bindtap="togglePause">{{isPaused ? '▶' : 'Ⅱ'}}</button>
      <button class="next-button" bindtap="nextModule"><text class="next-label">下一模块</text><text class="next-arrow">▶</text></button>
      <button class="complete-button {{isHolding ? 'holding' : ''}}" catchtouchstart="startCompleteHold" catchtouchend="endCompleteHold" catchtouchcancel="endCompleteHold">✓</button>
    </view>
  </view>

  <scroll-view class="module-side" scroll-y="true" enhanced="true" show-scrollbar="false">
    <view class="module-list {{item.status === 'current' ? 'selected' : ''}}" wx:for="{{runtimeModules}}" wx:key="id" data-index="{{index}}" bindtap="selectModule">
      <view class="module-index num">{{item.status === 'done' ? '✓' : index + 1}}</view>
      <view class="module-info"><text>{{item.name}}</text><text class="num">{{item.targetMinutes}} 分</text></view>
    </view>
  </scroll-view>
</view>
