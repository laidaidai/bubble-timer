<view class="timer-page theme-{{theme}} clock-{{clockStyle}} {{compact ? 'compact' : ''}} {{immersive ? 'immersive' : 'normal'}} {{immersiveAnim ? 'immersive-anim' : ''}} {{immersiveLeaving ? 'immersive-leaving' : ''}} {{clockMorph ? 'clock-morphing' : ''}} {{moduleOpen ? 'module-open' : ''}} {{timerReveal ? 'reveal' : ''}} {{chromeIdle ? 'chrome-idle' : ''}} {{portrait ? 'portrait' : 'landscape'}} {{wide ? 'wide' : ''}} {{isPaused ? 'paused' : 'running'}} {{orientAnim ? 'orient-anim' : ''}}" style="{{themeStyle}} {{slotVars}} {{stageVars}} {{immersiveVars}} {{clockFitVars}} {{navVars}} {{moduleFabVars}}" bindtap="handlePageTap">

  <!-- ================= 横屏一套：当前成品，位置/尺寸一律不动 ================= -->
  <block wx:if="{{!portrait}}">
  <view class="timer-main">
    <view class="immersive-toggle {{(immersive || immersiveLeaving) ? 'on' : ''}}" catchtap="toggleImmersive">
      <view class="fs-icon {{(immersive || immersiveLeaving) ? 'hidden' : ''}}">
        <view class="fs-corner fs-tl"></view>
        <view class="fs-corner fs-tr"></view>
        <view class="fs-corner fs-bl"></view>
        <view class="fs-corner fs-br"></view>
      </view>
      <view class="fs-exit {{(immersive || immersiveLeaving) ? 'show' : ''}}"><text class="fs-exit-char">‹</text></view>
    </view>

    <view class="corner-chips">
            <view class="mode-chip {{phaseLabel ? (phaseLabel === '专注' ? 'focus' : 'rest') : ''}}">
              <text>{{modeName}}</text>
              <text class="mode-phase" wx:if="{{phaseLabel}}">{{phaseLabel}}</text>
            </view>
    </view>
    <view class="clock-stage" style="{{orientStyle}}">

      <view class="clock-slot">
      <!-- 翻页时钟：抽到 components/flip-clock，timer 仅透传状态 -->
      <flip-clock class="clock-body clock-flip-host" wx:if="{{clockStyle === 'flip'}}"
        cells="{{flipCells}}"
        flip-phase="{{flipPhase}}"
        compact="{{compact}}"
        bindtap="cycleClockStyle"
        style="{{clockMorphStyle}}"/>

      <!-- 积木方块 -->
      <view class="block-row clock-body" bindtap="cycleClockStyle" wx:elif="{{clockStyle === 'blocks'}}" style="{{clockMorphStyle}}">
        <block wx:for="{{flipDigits}}" wx:key="key">
          <view class="block-colon" wx:if="{{item.sep}}">:</view>
          <view class="block-tile" wx:else><text class="block-num">{{item.text}}</text></view>
        </block>
      </view>

      <!-- LED 数码管 -->
      <view class="led-clock clock-body" bindtap="cycleClockStyle" wx:elif="{{clockStyle === 'led'}}" style="{{clockMorphStyle}}">
        <block wx:for="{{ledDigits}}" wx:key="key">
          <view class="led-colon" wx:if="{{item.sep}}">
            <view class="led-dot"></view>
            <view class="led-dot"></view>
          </view>
          <view class="led-digit" wx:else>
            <view class="led-seg seg-a {{item.segs[0] ? 'on' : ''}}"></view>
            <view class="led-seg seg-b {{item.segs[1] ? 'on' : ''}}"></view>
            <view class="led-seg seg-c {{item.segs[2] ? 'on' : ''}}"></view>
            <view class="led-seg seg-d {{item.segs[3] ? 'on' : ''}}"></view>
            <view class="led-seg seg-e {{item.segs[4] ? 'on' : ''}}"></view>
            <view class="led-seg seg-f {{item.segs[5] ? 'on' : ''}}"></view>
            <view class="led-seg seg-g {{item.segs[6] ? 'on' : ''}}"></view>
          </view>
        </block>
      </view>

      <!-- 数字时钟 / 极简 -->
      <view class="plain-clock clock-body" bindtap="cycleClockStyle" wx:else style="{{clockMorphStyle}}">
        <text class="plain-num {{clockStyle === 'outline' ? 'outline' : ''}} {{clockStyle === 'jelly' ? 'jelly' : ''}}">{{mainTimeText}}</text>
      </view>

      </view>
      <view class="progress-rail">
        <view class="stage-progress">
          <view class="stage-progress-fill {{isOvertime ? 'overtime-fill' : ''}}" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-logo" style="left: {{progressPercent}}%;">
          <image class="progress-logo-img" src="/assets/brand/logo-mark.png" mode="aspectFit"></image>
        </view>
        <view class="stage-meta">
          <text class="meta-module">{{currentModule.name || '训练完成'}}</text>
          <text class="meta-total"><text class="num">{{moduleTimeText}}</text></text>
          <text class="meta-ms" wx:if="{{msShow}}">{{msText}}ms</text>
        </view>
      </view>

      <view class="stage-target">
        <text class="target-left">TARGET: <text class="num">{{targetText}}</text></text>
        <text class="target-right {{isOvertime ? 'overtime' : 'on-track'}}">{{isOvertime ? 'OVERTIME' : 'ON TRACK'}}</text>
      </view>
      <view class="quote-slot" wx:if="{{quoteText}}">
        <view class="time-quote">
          <text class="time-quote-text">{{quoteText}}</text>
        </view>
      </view>
      <view class="tick-pill {{tickMuted ? 'muted' : ''}}" catchtap="toggleTick">
        <text class="tick-icon">♪</text>
        <text>{{tickMuted ? '滴答 · 静音' : '滴答 · 开'}}</text>
      </view>
    </view>

    <view class="controls">
      <button class="prev-button {{isFirstModule ? 'disabled' : ''}}" bindtap="prevModule">◀</button>
      <button class="pause-button" bindtap="togglePause">{{isPaused ? '▶' : 'Ⅱ'}}</button>
      <button class="next-button" bindtap="nextModule"><text class="next-label">下一模块</text><text class="next-arrow">▶</text></button>
      <button class="complete-button {{isHolding ? 'holding' : ''}}" catchtouchstart="startCompleteHold" catchtouchend="endCompleteHold" catchtouchcancel="endCompleteHold">✓</button>
    </view>
  </view>

  </block>

  <!-- ================= 竖屏一套（独立结构；横屏那套在其上方，未做任何改动） ================= -->
  <block wx:else>
  <view class="portrait-main">
    <view class="immersive-toggle {{(immersive || immersiveLeaving) ? 'on' : ''}}" catchtap="toggleImmersive">
      <view class="fs-icon {{(immersive || immersiveLeaving) ? 'hidden' : ''}}">
        <view class="fs-corner fs-tl"></view>
        <view class="fs-corner fs-tr"></view>
        <view class="fs-corner fs-bl"></view>
        <view class="fs-corner fs-br"></view>
      </view>
      <view class="fs-exit {{(immersive || immersiveLeaving) ? 'show' : ''}}"><text class="fs-exit-char">‹</text></view>
    </view>

    <view class="portrait-corner">
          <view class="mode-chip {{phaseLabel ? (phaseLabel === '专注' ? 'focus' : 'rest') : ''}}">
            <text>{{modeName}}</text>
            <text class="mode-phase" wx:if="{{phaseLabel}}">{{phaseLabel}}</text>
          </view>
    </view>
    <view class="portrait-stage">
      <view class="clock-stage" style="{{orientStyle}}">
        <view class="clock-slot">
          <flip-clock class="clock-body clock-flip-host" wx:if="{{clockStyle === 'flip'}}"
            cells="{{flipCells}}"
            flip-phase="{{flipPhase}}"
            compact="{{compact}}"
            bindtap="cycleClockStyle"
            style="{{clockMorphStyle}}"/>

          <view class="block-row clock-body" bindtap="cycleClockStyle" wx:elif="{{clockStyle === 'blocks'}}" style="{{clockMorphStyle}}">
            <block wx:for="{{flipDigits}}" wx:key="key">
              <view class="block-colon" wx:if="{{item.sep}}">:</view>
              <view class="block-tile" wx:else><text class="block-num">{{item.text}}</text></view>
            </block>
          </view>

          <view class="led-clock clock-body" bindtap="cycleClockStyle" wx:elif="{{clockStyle === 'led'}}" style="{{clockMorphStyle}}">
            <block wx:for="{{ledDigits}}" wx:key="key">
              <view class="led-colon" wx:if="{{item.sep}}">
                <view class="led-dot"></view>
                <view class="led-dot"></view>
              </view>
              <view class="led-digit" wx:else>
                <view class="led-seg seg-a {{item.segs[0] ? 'on' : ''}}"></view>
                <view class="led-seg seg-b {{item.segs[1] ? 'on' : ''}}"></view>
                <view class="led-seg seg-c {{item.segs[2] ? 'on' : ''}}"></view>
                <view class="led-seg seg-d {{item.segs[3] ? 'on' : ''}}"></view>
                <view class="led-seg seg-e {{item.segs[4] ? 'on' : ''}}"></view>
                <view class="led-seg seg-f {{item.segs[5] ? 'on' : ''}}"></view>
                <view class="led-seg seg-g {{item.segs[6] ? 'on' : ''}}"></view>
              </view>
            </block>
          </view>

          <view class="plain-clock clock-body" bindtap="cycleClockStyle" wx:else style="{{clockMorphStyle}}">
            <text class="plain-num {{clockStyle === 'outline' ? 'outline' : ''}} {{clockStyle === 'jelly' ? 'jelly' : ''}}">{{mainTimeText}}</text>
          </view>
        </view>
      </view>
      <view class="progress-rail">
        <view class="stage-progress">
          <view class="stage-progress-fill {{isOvertime ? 'overtime-fill' : ''}}" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-logo" style="left: {{progressPercent}}%;">
          <image class="progress-logo-img" src="/assets/brand/logo-mark.png" mode="aspectFit"></image>
        </view>
        <view class="stage-meta">
          <text class="meta-module">{{currentModule.name || '训练完成'}}</text>
          <text class="meta-total"><text class="num">{{moduleTimeText}}</text></text>
          <text class="meta-ms" wx:if="{{msShow}}">{{msText}}ms</text>
        </view>
      </view>

      <view class="quote-slot" wx:if="{{quoteText}}">
        <view class="time-quote">
          <text class="time-quote-text">{{quoteText}}</text>
        </view>
      </view>
        <view class="tick-pill {{tickMuted ? 'muted' : ''}}" catchtap="toggleTick">
          <text class="tick-icon">♪</text>
          <text>{{tickMuted ? '滴答 · 静音' : '滴答 · 开'}}</text>
        </view>
      <view class="stage-target">
        <text class="target-left">TARGET: <text class="num">{{targetText}}</text></text>
        <text class="target-right {{isOvertime ? 'overtime' : 'on-track'}}">{{isOvertime ? 'OVERTIME' : 'ON TRACK'}}</text>
      </view>
      <view class="controls">
        <button class="prev-button {{isFirstModule ? 'disabled' : ''}}" bindtap="prevModule">◀</button>
        <button class="pause-button" bindtap="togglePause">{{isPaused ? '▶' : 'Ⅱ'}}</button>
        <button class="next-button" bindtap="nextModule"><text class="next-label">下一模块</text><text class="next-arrow">▶</text></button>
        <button class="complete-button {{isHolding ? 'holding' : ''}}" catchtouchstart="startCompleteHold" catchtouchend="endCompleteHold" catchtouchcancel="endCompleteHold">✓</button>
      </view>
    </view>
  </view>

  </block>

  <view class="style-hint {{styleHint ? 'show' : ''}}">{{styleHint}}</view>

  <!-- ================= 选择模块：logo 悬浮球 + 弹出面板（横竖屏共用一份） ================= -->
  <view
    class="module-fab {{moduleOpen ? 'open' : ''}} {{moduleMenuDown ? 'at-top' : 'at-bottom'}} {{fabDragging ? 'dragging' : ''}} {{fabSettling ? 'settling' : ''}}"
    style="{{fabDragging ? 'transform: translate3d(0,' + fabDragY + 'px,0) scale(1.04)' : ''}}"
    catchtap="toggleModuleFab"
    bindtouchstart="onModuleFabStart"
    catchtouchmove="onModuleFabMove"
    bindtouchend="onModuleFabEnd"
    bindtouchcancel="onModuleFabEnd"
    aria-label="{{moduleOpen ? '收起模块列表' : '选择模块，可上下拖动'}}"
  >
    <image class="module-fab-logo" src="/assets/brand/logo-mark.png" mode="aspectFit"></image>
  </view>

  <view class="module-mask {{moduleOpen ? 'show' : ''}}" catchtap="closeModuleFab"></view>

  <view class="module-panel {{moduleMenuDown ? 'down' : 'up'}} {{moduleOpen ? 'open' : ''}}">
    <view class="module-panel-head">
      <text class="module-panel-title">选择模块</text>
      <text class="module-panel-count num">{{currentIndex + 1}} / {{runtimeModules.length}}</text>
    </view>
    <scroll-view class="module-panel-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-into-view="{{moduleScrollTarget}}" scroll-with-animation="{{true}}">
      <view id="module-{{index}}" class="module-list {{item.status === 'current' ? 'selected' : ''}} {{item.status === 'done' ? 'done' : ''}}" wx:for="{{runtimeModules}}" wx:key="id" data-index="{{index}}" bindtap="selectModule">
        <view class="module-index num">{{item.status === 'done' ? '✓' : index + 1}}</view>
        <view class="module-info"><text class="mi-name">{{item.name}}</text><text class="mi-num num">{{item.targetMinutes}} 分</text></view>
      </view>
    </scroll-view>
  </view>

  <view class="celebrate-mask" wx:if="{{celebrating}}">
    <view class="celebrate-bubble bubble-{{item.tone}}" wx:for="{{celebrationBubbles}}" wx:key="id"
      style="left:{{item.x}}%; width:{{item.size}}rpx; height:{{item.size}}rpx; animation-delay:{{item.delay}}ms; animation-duration:{{item.duration}}ms;"></view>
    <view class="celebrate-card">
      <view class="celebrate-reward" aria-label="计时完成">
        <view class="celebrate-halo"></view>
        <image class="celebrate-logo" src="/assets/brand/logo-mark.png" mode="aspectFit"></image>
      </view>
      <view class="celebrate-copy">
        <text class="celebrate-title">finish</text>
        <text class="celebrate-message" wx:if="{{celebrationMessage}}">{{celebrationMessage}}</text>
      </view>
    </view>
  </view>
</view>
