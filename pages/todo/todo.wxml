<view class="todo-shell theme-{{theme}} {{isDesktop ? 'desk' : ''}}" style="{{themeStyle}}">
  <view class="topbar" wx:if="{{!isDesktop}}">
    <view class="back-icon" bindtap="handleBack" aria-label="返回">‹</view>
    <view class="topbar-title">待办清单</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" dim="{{dockDim}}"></brand-dock>

  <view class="todo-view-slot">
    <todo-view id="todoView" class="todo-view" bind:dockdim="onDockDim"></todo-view>
  </view>
</view>
