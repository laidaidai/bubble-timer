<view class="todo-page theme-{{theme}}">
  <view class="topbar">
    <button class="back-icon" bindtap="handleBack">‹</button>
    <view class="topbar-title">待办清单</view>
    <view class="topbar-spacer"></view>
  </view>

  <scroll-view class="todo-body" scroll-y>
    <view class="todo-hero">
      <view class="todo-hero-top">
        <view class="todo-eyebrow">今日完成度 · {{doneCount}}/{{total}}</view>
        <view class="todo-percent"><text class="num">{{percent}}</text><text class="todo-unit">%</text></view>
      </view>
      <view class="todo-bar"><view class="todo-fill" style="width: {{percent}}%;"></view></view>
      <view class="todo-hint" wx:if="{{total}}">已完成 {{doneCount}} 项，还剩 {{total - doneCount}} 项</view>
      <view class="todo-hint" wx:else>把今天要练的模块写下来，一条条勾掉</view>
    </view>

    <view class="add-row">
      <input class="add-input" value="{{inputValue}}" placeholder="写一条待办，比如 判断推理 35 分钟" placeholder-class="add-placeholder" bindinput="onInput" confirm-type="done" bindconfirm="addTodo" />
      <button class="add-button" bindtap="addTodo">添加</button>
    </view>

    <view class="time-row">
      <picker mode="date" value="{{dueDate}}" bindchange="onDateChange">
        <view class="time-chip"><text class="chip-label">日期</text>{{dueDate}}</view>
      </picker>
      <picker mode="time" value="{{dueTime}}" bindchange="onTimeChange">
        <view class="time-chip"><text class="chip-label">时间</text>{{dueTime}}</view>
      </picker>
    </view>

    <view class="remind-row">
      <view class="remind-chip {{remindBefore === item.key ? 'active' : ''}}" wx:for="{{remindOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="setRemind">{{item.label}}</view>
    </view>

    <view class="todo-list" wx:if="{{total}}">
      <view class="todo-item {{item.done ? 'done' : ''}}" wx:for="{{todos}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleTodo" bindlongpress="removeTodo">
        <view class="todo-check {{item.done ? 'checked' : ''}}">
          <text class="check-mark" wx:if="{{item.done}}">✓</text>
        </view>
        <view class="todo-main">
          <view class="todo-text">{{item.text}}</view>
          <view class="todo-meta" wx:if="{{item.dueText}}">
            <text class="todo-due {{item.overdue ? 'overdue' : ''}}">{{item.dueText}}</text>
            <text class="todo-remind" wx:if="{{item.remindText}}">{{item.remindText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:else>
      <view class="empty-icon">＋</view>
      <view class="empty-title">还没有待办</view>
      <view class="empty-desc">在上面输入框写一条，训练时照着勾掉就行</view>
    </view>

    <view class="todo-actions">
      <button class="todo-action" bindtap="clearDone">清空已完成</button>
      <button class="todo-action primary" bindtap="pushReminder">开启学习提醒</button>
    </view>

    <view class="todo-foot">待办只存在本机；到点提醒需要你同意「订阅消息」，否则只在小程序打开时弹提示。</view>
  </scroll-view>
</view>
