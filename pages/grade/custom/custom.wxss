@import "../base.wxss";

.custom-page {
  padding-bottom: 214rpx;
}

/* 顶部卷名：作为页面标题，不再额外包一张重卡 */
.setup-card {
  padding: 0 4rpx 12rpx;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.name-input {
  width: 100%;
  height: 62rpx;
  padding: 0 2rpx;
  border: 0;
  border-bottom: 2rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 900;
}
.name-ph { color: var(--text-3); font-weight: 700; }

.presets {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}
.preset {
  min-height: 58rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--cream-1);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
  transition: transform .12s cubic-bezier(.2,.8,.3,1), box-shadow .12s cubic-bezier(.2,.8,.3,1);
}
.preset-press {
  transform: translate(2rpx, 3rpx);
  box-shadow: 1rpx 1rpx 0 var(--shadow-soft);
  background: var(--cream-3);
}

.mod-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

/* 每章一张卡：名称、题量分值、拖动把手都在同一条视觉轴线上 */
.mod-card {
  position: relative;
  padding: 20rpx 22rpx 18rpx;
  border-radius: 30rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
  transition: transform 200ms cubic-bezier(.25,.8,.3,1), box-shadow 160ms ease, background-color 160ms ease;
  will-change: transform;
}
.mod-card.is-drag {
  z-index: 6;
  background: var(--cream-3);
  box-shadow: 8rpx 10rpx 0 var(--shadow-soft);
}

.mod-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.mod-name-input {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 900;
}
.mod-name-ph { color: var(--text-2); font-weight: 800; }
.mod-name-ph-custom { color: var(--text-3); font-weight: 700; }

.mod-tools {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 5rpx;
  overflow: visible;
}
.mod-sub,
.mod-del,
.drag-handle {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  line-height: 1;
  transition: transform .1s ease, background-color .1s ease;
}
.mod-sub {
  color: var(--text-warm);
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  font-size: 30rpx;
  font-weight: 900;
}
.mod-sub.has-parts {
  color: var(--text-3);
  background: var(--card);
  border-color: var(--line-strong);
}
.mod-sub-plus { line-height: 1; }
.mod-sub-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 24rpx;
  height: 24rpx;
  padding: 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--text-2);
  background: var(--cream-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: 15rpx;
  font-weight: 900;
  line-height: 1;
}
.mod-sub-press { transform: scale(.94); background: var(--cream-3); }
.mod-del {
  color: var(--danger);
  background: var(--card);
  border: 2rpx solid var(--danger-line);
  font-size: 29rpx;
  font-weight: 800;
}
.mod-del-press { transform: scale(.94); background: var(--danger-bg); }
.drag-handle {
  color: var(--text-3);
  background: var(--cream-2);
  border: 2rpx solid var(--line-strong);
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.mod-subline {
  min-height: 32rpx;
  margin-top: 3rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.mod-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  overflow: hidden;
}
.mod-per,
.mod-total {
  overflow: hidden;
  color: var(--text-2);
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mod-total { color: var(--ink); }

.sub-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sub-row {
  padding: 13rpx 13rpx 14rpx;
  background: var(--cream-1);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  box-sizing: border-box;
}

.sub-top {
  display: flex;
  align-items: center;
  gap: 9rpx;
}
.sub-name {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  padding: 0 10rpx;
  color: var(--ink);
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 23rpx;
  font-weight: 900;
}
.sub-name-ph { color: var(--text-3); font-weight: 700; }
.sub-range {
  flex: 0 0 auto;
  color: var(--text-3);
  font-size: 19rpx;
  white-space: nowrap;
}
.sub-del {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger-text);
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
}
.sub-del-press { background: var(--danger-bg); }

.sub-fields { margin-top: 9rpx; }

.sub-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 2rpx;
}
.sub-add,
.sub-merge {
  min-height: 44rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--card);
  color: var(--ink);
  font-size: 19rpx;
  font-weight: 900;
}
.sub-add {
  width: 54rpx;
  min-width: 54rpx;
  height: 54rpx;
  padding: 0;
  color: var(--on-primary);
  background: var(--primary);
  border-color: var(--edge);
  border-radius: 50%;
  font-size: 28rpx;
}
.sub-merge {
  color: var(--text-2);
  background: var(--cream-2);
}
.sub-add-press,
.sub-press { background: var(--cream-3); }

/* 题量 / 分值：两行配置表，标签、数字、加减各占固定列，不再拼胶囊条 */
.mod-stats {
  width: 100%;
  margin-top: 12rpx;
  padding: 2rpx 10rpx 2rpx 14rpx;
  box-sizing: border-box;
  background: var(--cream-1);
  border: 2rpx solid var(--line-strong);
  border-radius: 22rpx;
}
.stat-row {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.stat-row + .stat-row {
  border-top: 2rpx solid var(--line);
}
.stat-label {
  flex: 0 0 62rpx;
  padding-left: 10rpx;
  box-sizing: border-box;
  color: var(--ink);
  border-left: 4rpx solid var(--primary);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.2;
}
.stat-value {
  flex: 0 0 120rpx;
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
}
.stat-num {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 56rpx;
  color: var(--ink);
  background: transparent;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: left;
}
.stat-steps {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: auto;
}
.stat-step {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--text-2);
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 50%;
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  transition: transform .1s ease, background-color .1s ease, box-shadow .1s ease;
}
.stat-step.is-plus {
  color: var(--primary-3);
  border-color: var(--primary-2);
}
.stat-step-press {
  transform: translate(1rpx, 2rpx);
  background: var(--cream-3);
  box-shadow: none;
}
.sub-stats {
  margin-top: 10rpx;
  padding: 2rpx 8rpx 2rpx 10rpx;
  background: var(--card);
  border-color: var(--line);
  border-radius: 18rpx;
}
.sub-stats .stat-row { min-height: 58rpx; gap: 8rpx; }
.sub-stats .stat-label { flex-basis: 54rpx; padding-left: 8rpx; border-left-width: 2rpx; border-left-color: var(--line-strong); font-size: 17rpx; letter-spacing: 0; }
.sub-stats .stat-value { flex-basis: 96rpx; }
.sub-stats .stat-num { height: 48rpx; font-size: 27rpx; line-height: 48rpx; }
.sub-stats .stat-steps { gap: 6rpx; }
.sub-stats .stat-step { width: 48rpx; height: 48rpx; background: var(--cream-1); font-size: 26rpx; }

.add-mod {
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--card);
  border: 2rpx solid var(--edge);
  border-radius: 26rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
  font-size: 25rpx;
  font-weight: 900;
}
.add-plus {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--on-primary);
  background: var(--primary);
  border: 2rpx solid var(--edge);
  border-radius: 50%;
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}
.add-press { transform: translateY(2rpx); background: var(--cream-2); }

.delete-row,
.reset-row {
  width: 224rpx;
  min-height: 56rpx;
  margin: 24rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  box-shadow: 2rpx 3rpx 0 var(--shadow-soft);
  color: var(--text-2);
  font-size: 21rpx;
  font-weight: 800;
}
.delete-row {
  color: var(--danger-text);
  border-color: var(--danger-line);
}
.delete-press { transform: translate(1rpx, 2rpx); box-shadow: none; background: var(--danger-bg); }
.reset-row { width: 244rpx; }
.reset-press { transform: translate(1rpx, 2rpx); box-shadow: none; background: var(--cream-2); }

/* 底部合计条：固定但不贴边，宽屏下和正文同宽居中 */
.save-bar {
  position: fixed;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 100%;
  max-width: 720px;
  box-sizing: border-box;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 26rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: var(--cream-1);
  border-top: 2rpx solid var(--line-strong);
  box-shadow: 0 -6rpx 0 var(--shadow-soft);
}
.bar-info { flex: 1; min-width: 0; }
.bar-total { color: var(--ink); font-size: 26rpx; font-weight: 800; }
.bar-diff {
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.bar-diff.ok { color: var(--success-text); }
.bar-diff.bad { color: var(--danger-text); }
.bar-fix {
  flex: 0 0 auto;
  min-height: 56rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--card);
  border: 2rpx solid var(--edge);
  border-radius: 999rpx;
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
  font-size: 22rpx;
  font-weight: 900;
}
.bar-fix-press { background: var(--line-2); }
.bar-save {
  flex: 0 0 auto;
  min-height: 72rpx;
  padding: 0 36rpx;
}
.bar-save-strong {
  background: var(--primary-3);
  border-color: var(--edge-deep);
  color: var(--on-primary);
  box-shadow: 3rpx 4rpx 0 var(--shadow);
}
.is-off { opacity: 0.5; }

/* 入场：模块逐张落下，小节展开时逐条浮起 */
.grade-card-in { animation: grade-card-in .34s cubic-bezier(.2,.8,.3,1) backwards; }
.preset { animation: grade-chip-in .28s cubic-bezier(.2,.8,.3,1) backwards; }
.sub-list { animation: sub-list-in .26s cubic-bezier(.2,.8,.3,1) both; }
.sub-row { animation: sub-row-in .3s cubic-bezier(.2,.8,.3,1) backwards; }

@keyframes grade-card-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes grade-chip-in {
  from { opacity: 0; transform: translateY(6rpx) scale(.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes sub-list-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes sub-row-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (min-width: 700px) {
  .custom-page { padding-bottom: 128px; }
  .setup-card { padding: 0 2px 8px; border-radius: 0; box-shadow: none; background: transparent; border: 0; }
  .name-input { height: 38px; font-size: 19px; border-bottom-width: 1px; }
  .presets { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; margin-top: 11px; }
  .preset { min-height: 33px; padding: 0 7px; border-width: 1px; font-size: 12px; box-shadow: 2px 2px 0 var(--shadow-soft); }
  .mod-list { gap: 8px; margin-top: 12px; }
  .mod-card { padding: 11px 12px 10px; border-radius: 17px; box-shadow: 3px 4px 0 var(--shadow-soft); }
  .mod-card.is-drag { box-shadow: 5px 6px 0 var(--shadow-soft); }
  .mod-name-input { height: 29px; font-size: 16px; }
  .mod-tools { gap: 4px; }
  .mod-sub, .mod-del, .drag-handle { width: 30px; height: 30px; border-width: 1px; }
  .mod-sub { font-size: 17px; }
  .mod-sub-badge { top: -4px; right: -4px; min-width: 14px; height: 14px; border-width: 1px; font-size: 9px; }
  .mod-del { font-size: 17px; }
  .drag-handle { font-size: 16px; }
  .mod-subline { min-height: 16px; margin-top: 2px; gap: 6px; }
  .mod-per, .mod-total { font-size: 12px; }
  .sub-list { gap: 6px; margin-top: 7px; }
  .sub-row { padding: 7px 7px 8px; border-width: 1px; border-radius: 12px; }
  .sub-top { gap: 6px; }
  .sub-name { height: 28px; padding: 0 6px; border-width: 1px; border-radius: 7px; font-size: 13px; }
  .sub-range { font-size: 11px; }
  .sub-del { width: 25px; height: 25px; font-size: 15px; }
  .sub-actions { gap: 6px; }
  .sub-add, .sub-merge { min-height: 25px; padding: 0 8px; border-width: 1px; font-size: 10px; }
  .sub-add { width: 30px; min-width: 30px; height: 30px; padding: 0; border-radius: 50%; font-size: 17px; }
  .mod-stats { margin-top: 7px; padding: 1px 6px 1px 8px; border-width: 1px; border-radius: 12px; }
  .stat-row { min-height: 36px; gap: 6px; }
  .stat-row + .stat-row { border-top-width: 1px; }
  .stat-label { flex-basis: 40px; padding-left: 6px; border-left-width: 2px; font-size: 11px; letter-spacing: .5px; }
  .stat-value { flex-basis: 62px; }
  .stat-num { flex: 1; width: 100%; height: 30px; font-size: 17px; line-height: 30px; }
  .stat-steps { gap: 4px; margin-left: auto; }
  .stat-step { width: 28px; height: 28px; border-width: 1px; font-size: 16px; box-shadow: 1px 1px 0 var(--shadow-soft); }
  .sub-stats { margin-top: 5px; padding: 1px 4px 1px 6px; border-radius: 10px; }
  .sub-stats .stat-row { min-height: 32px; gap: 5px; }
  .sub-stats .stat-label { flex-basis: 32px; padding-left: 5px; border-left-width: 1px; border-left-color: var(--line-strong); font-size: 10px; }
  .sub-stats .stat-value { flex-basis: 56px; }
  .sub-stats .stat-num { height: 28px; font-size: 15px; line-height: 28px; }
  .sub-stats .stat-steps { gap: 4px; }
  .sub-stats .stat-step { width: 26px; height: 26px; font-size: 14px; }
  .add-mod { min-height: 46px; margin-top: 8px; padding: 0 13px; gap: 8px; border-width: 1px; border-radius: 14px; font-size: 14px; box-shadow: 2px 2px 0 var(--shadow-soft); }
  .add-plus { width: 27px; height: 27px; border-width: 1px; font-size: 17px; box-shadow: 1px 1px 0 var(--shadow-soft); }
  .delete-row, .reset-row { min-height: 32px; margin-top: 14px; border-width: 1px; font-size: 12px; box-shadow: 1px 2px 0 var(--shadow-soft); }
  .delete-row { width: 125px; }
  .reset-row { width: 136px; }
  .save-bar { max-width: 688px; padding: 8px 15px; padding-bottom: 8px; gap: 8px; border-top-width: 1px; box-shadow: 0 -3px 0 var(--shadow-soft); }
  .bar-total { font-size: 15px; }
  .bar-diff { margin-top: 2px; font-size: 12px; }
  .bar-fix { min-height: 31px; padding: 0 11px; border-width: 1px; font-size: 12px; }
  .bar-save { min-height: 40px; padding: 0 20px; }
}
