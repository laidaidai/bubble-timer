<view class="topbar grade-topbar theme-{{theme}}" style="{{themeStyle}}" wx:if="{{!isDesktop}}">
  <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
  <view class="topbar-title">{{editingId ? '编辑自定义卷' : '新建自定义卷'}}</view>
  <view class="topbar-spacer"></view>
</view>
<view class="page custom-page {{isDesktop ? 'desk' : ''}} {{!isDesktop ? 'has-grade-topbar' : ''}} grade-root theme-{{theme}}" style="{{themeStyle}}">
  <view class="card setup-card anim-rise">
    <input
      class="name-input"
      value="{{name}}"
      maxlength="20"
      placeholder="卷名（可留空）"
      placeholder-class="name-ph"
      aria-label="卷名"
      bindinput="onName"
    />

    <view class="preset-block">
      <view class="preset-label">模板</view>
      <view class="presets">
        <view
          wx:for="{{presets}}"
          wx:key="id"
          class="preset"
          data-id="{{item.id}}"
          bindtap="applyPreset"
          hover-class="preset-press"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="mod-list">
    <view wx:for="{{modules}}" wx:key="key" class="card mod-card anim-rise" style="animation-delay: {{index * 40 + 60}}ms;">
      <view class="mod-body">
        <input
          class="mod-name-input"
          value="{{item.nameText}}"
          placeholder="{{item.ph}}"
          placeholder-class="{{item.custom ? 'mod-name-ph-custom' : 'mod-name-ph'}}"
          maxlength="12"
          data-key="{{item.key}}"
          aria-label="模块名"
          bindinput="onModName"
          bindblur="normalizeName"
        />
        <view wx:if="{{item.perText}}" class="mod-per num">{{item.perText}}</view>
        <view class="mod-fields">
          <view class="stepper">
            <view class="step" data-key="{{item.key}}" data-delta="-1" aria-label="减少题量" bindtap="step" hover-class="step-press">−</view>
            <view class="step-mid">
              <input
                class="step-num num"
                type="number"
                value="{{item.countText}}"
                data-key="{{item.key}}"
                data-field="count"
                aria-label="题量"
                bindinput="edit"
                bindblur="normalize"
              />
              <text class="unit">题</text>
            </view>
            <view class="step" data-key="{{item.key}}" data-delta="1" aria-label="增加题量" bindtap="step" hover-class="step-press">+</view>
          </view>
          <view class="point-box">
            <input
              class="point-num num"
              type="digit"
              value="{{item.pointsText}}"
              data-key="{{item.key}}"
              data-field="points"
              aria-label="模块分值"
              bindinput="edit"
              bindblur="normalize"
            />
            <text class="unit">分</text>
          </view>
        </view>
      </view>
      <view class="mod-acts">
        <view class="mod-act {{index === 0 ? 'off' : ''}}" data-index="{{index}}" data-delta="-1" aria-label="上移 {{item.displayName}}" bindtap="moveModule" hover-class="act-press">↑</view>
        <view class="mod-act {{index === modules.length - 1 ? 'off' : ''}}" data-index="{{index}}" data-delta="1" aria-label="下移 {{item.displayName}}" bindtap="moveModule" hover-class="act-press">↓</view>
        <view class="mod-act del" data-key="{{item.key}}" aria-label="移除 {{item.displayName}}" bindtap="removeModule" hover-class="del-press">×</view>
      </view>
    </view>
  </view>

  <view class="add-mod" aria-label="添加模块" bindtap="addModule" hover-class="add-press">
    <view class="add-plus">＋</view>
    <text>添加模块</text>
  </view>

  <view wx:if="{{editingId}}" class="delete-row" aria-label="删除这卷" bindtap="deleteCurrent" hover-class="delete-press">删除这卷</view>

  <view class="save-bar">
    <view class="bar-info">
      <view class="bar-total num">共 {{totalCount}} 题 · {{sumText}} / 100 分</view>
      <view class="bar-diff {{valid ? 'ok' : 'bad'}}">{{valid ? '分值已配满' : diffText}}</view>
    </view>
    <view wx:if="{{!valid && totalCount > 0}}" class="bar-fix" aria-label="补齐差额" bindtap="fillRest" hover-class="bar-fix-press">补齐</view>
    <view class="btn btn-amber bar-save {{valid ? '' : 'is-off'}}" aria-label="保存自定义卷" bindtap="save" hover-class="btn-pressed">保存</view>
  </view>
</view>
