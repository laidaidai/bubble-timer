<view class="topbar grade-topbar theme-{{theme}}" style="{{themeStyle}}" wx:if="{{!isDesktop}}">
  <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
  <view class="topbar-title">历史记录</view>
  <view class="topbar-spacer"></view>
</view>
<view class="page history-page {{isDesktop ? 'desk' : ''}} {{!isDesktop ? 'has-grade-topbar' : ''}} grade-root theme-{{theme}}" style="{{themeStyle}}">
  <view class="page-title anim-rise">{{paperName || '全部历史记录'}}</view>

  <view wx:if="{{paperId}}" class="hist-tools anim-rise" style="animation-delay: 60ms;">
    <view class="btn btn-dark mini" bindtap="retry" hover-class="btn-pressed">再练一次本卷</view>
    <view class="hist-count">共 {{list.length}} 次作答</view>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty card anim-pop">
    <view class="empty-mark num">0</view>
    <view class="empty-title">暂无作答记录</view>
    <view class="empty-sub">答完一套卷，得分会存这里</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card record-row anim-rise" style="animation-delay: {{(index > 8 ? 8 : index) * 45 + 100}}ms;">
    <view class="record-main">
      <view wx:if="{{!paperId}}" class="record-paper">{{item.paperName}}</view>
      <view class="record-time">{{item.timeText}}</view>
      <view class="record-meta">
        <text class="meta-right">{{item.right}} 对</text>
        <text class="meta-wrong">{{item.wrong}} 错</text>
        <text class="meta-blank">{{item.blank}} 未做</text>
        <text class="meta-acc num">正确率 {{item.accText}}%</text>
      </view>
    </view>
    <view class="record-right">
      <view class="record-score num">{{item.score}}<text class="record-unit">分</text></view>
      <view class="record-actions">
        <view class="btn btn-dark mini" data-id="{{item.id}}" catchtap="goDetail" hover-class="btn-pressed">详情</view>
        <view class="btn btn-outline mini del" data-id="{{item.id}}" catchtap="remove" hover-class="btn-pressed">删除</view>
      </view>
    </view>
  </view>
</view>
