<view class="topbar grade-topbar theme-{{theme}}" style="{{themeStyle}}" wx:if="{{!isDesktop}}">
  <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
  <view class="topbar-title">历史记录</view>
  <view class="topbar-spacer"></view>
</view>
<view class="page history-page {{isDesktop ? 'desk' : ''}} {{!isDesktop ? 'has-grade-topbar' : ''}} grade-root theme-{{theme}}" style="{{themeStyle}}">
  <view class="page-title anim-rise" wx:if="{{paperName}}">{{paperName}}</view>

  <view wx:if="{{list.length}}" class="hist-tools anim-rise">
    <view class="hist-count" aria-label="共 {{countText}} 条记录">共 <text class="num">{{countText}}</text> 条记录</view>
  </view>

  <view wx:if="{{pending.length}}" class="pending-block anim-rise">
    <view class="pending-head">
      <text class="pending-title">待填答案</text>
      <text class="pending-count num">{{pending.length}}</text>
    </view>
    <view
      wx:for="{{pending}}"
      wx:key="id"
      class="pending-card"
      data-paper-id="{{item.paperId}}"
      data-timer-id="{{item.id}}"
      bindtap="goFill"
      hover-class="pending-pressed"
      aria-label="去填 {{item.paperName}} 的答案"
    >
      <view class="pending-main">
        <view class="pending-top">
          <view class="pending-dot" aria-hidden="true"></view>
          <text class="pending-paper">{{item.paperName}}</text>
        </view>
        <view class="pending-meta num">{{item.metaText}}</view>
      </view>
      <view class="pending-go">去填答案<text class="pending-go-arrow">›</text></view>
    </view>
  </view>

  <view wx:if="{{!list.length && !pending.length}}" class="history-empty anim-pop">
    <image class="empty-logo" src="/assets/brand/logo.png" mode="aspectFit" aria-hidden="true"></image>
    <view class="empty-short">完成一次批改后，记录会出现在这里</view>
  </view>

  <view class="record-list {{list.length > 1 ? 'two-col' : ''}}">
  <view
    wx:for="{{list}}"
    wx:key="id"
    class="record-row anim-rise"
    style="animation-delay: {{(index > 8 ? 8 : index) * 45 + 100}}ms;"
  >
    <view class="record-head">
      <view class="record-title-wrap">
        <view wx:if="{{!paperId}}" class="record-title">{{item.paperName}}</view>
        <view class="record-time">{{item.timeText}}</view>
      </view>
    </view>

    <view class="record-meta">
      <view class="record-score num">
        <text class="record-score-value">{{item.score}}</text>
        <text class="record-denom">/100</text>
      </view>
      <view class="record-counts">
        <view class="record-stat is-right" aria-label="答对 {{item.right}} 题">
          <text class="stat-mark">✓</text>
          <text class="stat-value num">{{item.right}}</text>
        </view>
        <view class="record-stat is-wrong" aria-label="答错 {{item.wrong}} 题">
          <text class="stat-mark">×</text>
          <text class="stat-value num">{{item.wrong}}</text>
        </view>
        <view class="record-stat is-blank" aria-label="未做 {{item.blank}} 题">
          <view class="stat-empty" aria-hidden="true"></view>
          <text class="stat-value num">{{item.blank}}</text>
        </view>
      </view>
    </view>

    <view class="record-actions">
      <button class="record-action record-retry" data-id="{{item.id}}" bindtap="retryRecord" hover-class="record-action-pressed">再试一次</button>
      <button class="record-action record-delete" data-id="{{item.id}}" bindtap="remove" hover-class="record-action-pressed">删除</button>
      <button class="record-action record-detail" data-id="{{item.id}}" bindtap="goDetail" hover-class="record-action-pressed">查看详情</button>
    </view>
  </view>
  </view>
</view>
