<view class="topbar grade-topbar theme-{{theme}}" style="{{themeStyle}}" wx:if="{{!isDesktop}}">
  <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
  <view class="topbar-title">历史记录</view>
  <view class="topbar-spacer"></view>
</view>
<view class="page history-page {{isDesktop ? 'desk' : ''}} {{!isDesktop ? 'has-grade-topbar' : ''}} grade-root theme-{{theme}}" style="{{themeStyle}}">
  <view class="page-title anim-rise">{{paperName || '全部历史记录'}}</view>

  <view wx:if="{{paperId}}" class="hist-tools anim-rise" style="animation-delay: 60ms;">
    <view class="btn btn-dark mini retry-btn" bindtap="retry" hover-class="btn-pressed" aria-label="重做本卷">
      <text class="retry-glyph">↻</text>
      <text class="retry-label">重做</text>
    </view>
    <view class="hist-count" aria-label="共 {{countText}} 次作答">
      <view class="hist-stack" aria-hidden="true">
        <view class="hist-line"></view>
        <view class="hist-line"></view>
        <view class="hist-line"></view>
      </view>
      <text class="hist-count-num num">{{countText}}</text>
      <text class="hist-count-unit">次</text>
    </view>
  </view>

  <view wx:if="{{pending.length}}" class="pending-block anim-rise">
    <view class="pending-head">
      <text class="pending-title">待填答案</text>
      <text class="pending-count num">{{pending.length}}</text>
    </view>
    <view
      wx:for="{{pending}}"
      wx:key="id"
      class="pending-card"
      data-paper-id="{{item.paperId}}"
      data-timer-id="{{item.id}}"
      bindtap="goFill"
      hover-class="pending-pressed"
      aria-label="去填 {{item.paperName}} 的答案"
    >
      <view class="pending-main">
        <view class="pending-top">
          <view class="pending-dot" aria-hidden="true"></view>
          <text class="pending-paper">{{item.paperName}}</text>
        </view>
        <view class="pending-meta num">{{item.metaText}}</view>
      </view>
      <view class="pending-go">去填答案<text class="pending-go-arrow">›</text></view>
    </view>
  </view>

  <view wx:if="{{!list.length && !pending.length}}" class="empty card anim-pop">
    <view class="empty-title">暂无作答记录</view>
    <view class="empty-sub">答完一套卷，得分会存这里</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card record-row anim-rise"
    style="animation-delay: {{(index > 8 ? 8 : index) * 45 + 100}}ms;"
    data-id="{{item.id}}"
    bindtap="goDetail"
    hover-class="record-pressed"
    aria-label="查看 {{item.timeText}} 的作答详情"
  >
    <view wx:if="{{!paperId}}" class="record-paper">{{item.paperName}}</view>

    <view class="record-head">
      <view class="record-when">
        <view class="record-clock" aria-hidden="true"></view>
        <text class="record-time">{{item.timeText}}</text>
      </view>
      <view class="record-score num">
        <text class="record-score-value">{{item.score}}</text>
        <text class="record-unit">分</text>
      </view>
    </view>

    <view class="record-stats">
      <view class="stat-chip is-right" aria-label="答对 {{item.right}} 题">
        <text class="stat-mark">✓</text>
        <text class="stat-value num">{{item.right}}</text>
      </view>
      <view class="stat-chip is-wrong" aria-label="答错 {{item.wrong}} 题">
        <text class="stat-mark">×</text>
        <text class="stat-value num">{{item.wrong}}</text>
      </view>
      <view class="stat-chip is-blank" aria-label="未做 {{item.blank}} 题">
        <view class="stat-empty" aria-hidden="true"></view>
        <text class="stat-value num">{{item.blank}}</text>
      </view>
      <view class="stat-chip is-acc" aria-label="正确率 {{item.accText}}%">
        <view class="stat-target" aria-hidden="true"></view>
        <text class="stat-value num">{{item.accText}}%</text>
      </view>

      <view class="record-actions">
        <view class="icon-btn" data-id="{{item.id}}" catchtap="goDetail" hover-class="icon-btn-pressed" aria-label="查看详情">
          <text class="chev">›</text>
        </view>
        <view class="icon-btn is-danger" data-id="{{item.id}}" catchtap="remove" hover-class="icon-btn-pressed" aria-label="删除这条记录">
          <view class="trash" aria-hidden="true"></view>
        </view>
      </view>
    </view>
  </view>
</view>
