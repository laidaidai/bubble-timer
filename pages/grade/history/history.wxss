@import "../base.wxss";
.history-page { padding-top: 26rpx; }

.page-title {
  margin-bottom: 22rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

/* 顶部工具条：只留记录条数，动作下沉到每张记录卡 */
.hist-tools { margin: 0 2rpx 20rpx; }
.hist-count { color: var(--text-2); font-size: 21rpx; font-weight: 800; }
.hist-count .num { color: var(--ink); font-weight: 900; }

/* 空状态：只放品牌 logo 和一句去向，不写「暂无」 */
.history-empty {
  padding: 82rpx 24rpx 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}
.empty-logo {
  width: 210rpx;
  height: 210rpx;
  margin-bottom: 2rpx;
  animation: grade-empty-float 4.2s ease-in-out infinite;
}
.empty-short {
  color: var(--text-2);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.55;
  text-align: center;
}
@keyframes grade-empty-float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(8rpx, -8rpx) rotate(-1.5deg); }
}

/* 待填答案：计时已完成但还没交卷，置顶提醒，点一下回到原会话 */
.pending-block { margin-bottom: 20rpx; }
.pending-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 2rpx 10rpx;
}
.pending-title { font-size: 24rpx; font-weight: 900; color: var(--ink); }
.pending-count {
  min-width: 32rpx;
  padding: 1rpx 9rpx;
  color: var(--on-primary);
  background: var(--primary);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}
.pending-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  background: var(--accent-bg);
  border: 2rpx solid var(--primary);
  border-radius: 20rpx;
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  box-sizing: border-box;
  transition: transform .12s cubic-bezier(.2,.8,.3,1), box-shadow .12s cubic-bezier(.2,.8,.3,1);
}
.pending-pressed { transform: translate(1rpx, 2rpx); box-shadow: none; }
.pending-main { flex: 1; min-width: 0; }
.pending-top { display: flex; align-items: center; gap: 8rpx; }
.pending-dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--primary);
}
.pending-paper {
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pending-meta { margin-top: 5rpx; color: var(--text-3); font-size: 20rpx; line-height: 1.35; }
.pending-go {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  color: var(--on-primary);
  background: var(--primary);
  border: 2rpx solid var(--edge);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
}
.pending-go-arrow { margin-left: 2rpx; font-size: 22rpx; }

/* 记录卡：对齐训练记录页——卷名 / 时间在上，分数最大，动作按钮明示 */
.record-row {
  width: 100%;
  margin-bottom: 22rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--card);
  border: 2rpx solid var(--edge);
  border-radius: 28rpx;
  box-shadow: 6rpx 7rpx 0 var(--shadow);
}

.record-head { display: flex; align-items: flex-start; }
.record-title-wrap { flex: 1; min-width: 0; overflow: hidden; }
.record-title {
  margin-bottom: 8rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-time {
  display: block;
  overflow: hidden;
  color: var(--text-3);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: .2rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-meta {
  margin: 20rpx 0 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.record-score {
  flex: 0 0 auto;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--ink);
}
.record-score-value {
  font-size: 56rpx;
  font-weight: 900;
  line-height: .9;
  letter-spacing: -2rpx;
}
.record-denom {
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1;
}

.record-counts {
  flex: 0 0 auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.record-stat {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}
.stat-mark {
  width: 22rpx;
  color: inherit;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}
.stat-value { color: inherit; font-size: 22rpx; font-weight: 900; }
.stat-empty {
  flex: 0 0 auto;
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}
.record-stat.is-right { color: var(--success-text); }
.record-stat.is-wrong { color: var(--danger-text); }
.record-stat.is-blank { color: var(--text-3); }

.record-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.record-action {
  width: auto !important;
  min-width: 0 !important;
  max-width: 100% !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
  box-sizing: border-box;
}
.record-action::after { border: none; }
.record-retry {
  color: var(--ink);
  background: var(--primary-2);
  border: 2rpx solid var(--edge);
  box-shadow: 3rpx 4rpx 0 var(--shadow);
}
.record-delete {
  color: var(--danger);
  background: var(--card);
  border: 2rpx solid var(--danger);
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  font-size: 22rpx;
}
.record-detail {
  margin-left: auto;
  padding: 16rpx 28rpx;
  color: var(--on-panel);
  background: var(--panel);
  border: 2rpx solid var(--panel);
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
  font-size: 24rpx;
}
.record-action-pressed {
  transform: translate(2rpx, 3rpx);
  box-shadow: none;
}

/* 桌面档：rpx 随窗口放大，这里统一 px 化 */
@media (min-width: 700px) {
  .pending-title { font-size: 13px; }
  .pending-count { min-width: 17px; padding: 1px 5px; font-size: 10px; }
  .pending-card { gap: 8px; margin-bottom: 7px; padding: 9px 10px; border-width: 2px; border-radius: 11px; box-shadow: 2px 2px 0 var(--shadow-soft); }
  .pending-dot { width: 5px; height: 5px; }
  .pending-paper { font-size: 14px; }
  .pending-meta { margin-top: 3px; font-size: 11px; }
  .pending-go { padding: 4px 7px; border-width: 1px; font-size: 11px; }
  .pending-go-arrow { font-size: 12px; }
  .history-page { padding-top: 15px; }
  .page-title { font-size: 22px; margin-bottom: 13px; }
  .hist-tools { margin-bottom: 11px; }
  .hist-count { font-size: 12px; }

  .history-empty { padding: 46px 16px 56px; gap: 7px; }
  .empty-logo { width: 118px; height: 118px; margin-bottom: 2px; }
  .empty-short { font-size: 13px; }
  .desk .empty-logo { animation: none !important; }

  .record-row { margin-bottom: 12px; padding: 13px; border-width: 1px; border-radius: 15px; box-shadow: 3px 4px 0 var(--shadow); }
  .record-title { margin-bottom: 4px; font-size: 16px; }
  .record-time { font-size: 11px; }
  .record-meta { margin: 11px 0 10px; gap: 8px; }
  .record-score-value { font-size: 32px; letter-spacing: -1px; }
  .record-denom { font-size: 12px; }

  .record-counts { gap: 8px; }
  .record-stat { gap: 3px; font-size: 12px; }
  .stat-mark { width: 13px; font-size: 14px; }
  .stat-value { font-size: 12px; }
  .stat-empty { width: 10px; height: 10px; border-width: 1px; border-radius: 2px; }

  .record-actions { gap: 7px; }
  .record-action {
    padding: 8px 15px;
    border-width: 1px;
    font-size: 13px;
    line-height: 1.3;
    box-shadow: 2px 3px 0 var(--shadow-soft);
  }
  .record-retry { box-shadow: 2px 3px 0 var(--shadow); }
  .record-delete { font-size: 12px; }
  .record-detail { padding: 8px 16px; font-size: 13px; box-shadow: 3px 4px 0 var(--shadow-soft); }
}

/* 宽窗口：历史记录列放到 1040px；两条以上记录时两列，单条保持整行 */
.page.history-page.desk { max-width: 1040px; }
@media (min-width: 960px) {
  .record-list.two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    align-items: start;
  }
  .record-list.two-col .record-row { margin-bottom: 0; }
}
