@import "../base.wxss";
.history-page { padding-top: 26rpx; }

.page-title {
  margin-bottom: 22rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

/* 顶部工具条：一个短动作 + 一个计数胶囊 */
.hist-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 0 0 20rpx;
  box-sizing: border-box;
}
.retry-btn { padding: 0 18rpx; }
.retry-glyph {
  color: inherit;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
}
.retry-label { font-size: 21rpx; font-weight: 900; }

.hist-count {
  flex: 0 0 auto;
  min-height: 44rpx;
  padding: 0 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
  color: var(--text-2);
  background: var(--cream-1);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 800;
}
.hist-count-num { color: var(--ink); font-size: 22rpx; font-weight: 900; }
.hist-count-unit { font-size: 19rpx; }
.hist-stack {
  width: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  margin-right: 1rpx;
}
.hist-line {
  height: 2rpx;
  background: var(--text-3);
  border-radius: 2rpx;
}

/* 空状态：只留一句结论和一句去向 */
.empty {
  padding: 34rpx 28rpx 36rpx;
  text-align: center;
  border-color: var(--line);
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
}
.empty-title { font-size: 28rpx; font-weight: 900; }
.empty-sub { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

/* 待填答案：计时已完成但还没交卷，置顶提醒，点一下回到原会话 */
.pending-block { margin-bottom: 20rpx; }
.pending-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0 2rpx 10rpx;
}
.pending-title { font-size: 24rpx; font-weight: 900; color: var(--ink); }
.pending-count {
  min-width: 32rpx;
  padding: 1rpx 9rpx;
  color: var(--on-primary);
  background: var(--primary);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}
.pending-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  background: var(--accent-bg);
  border: 2rpx solid var(--primary);
  border-radius: 20rpx;
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  box-sizing: border-box;
  transition: transform .12s cubic-bezier(.2,.8,.3,1), box-shadow .12s cubic-bezier(.2,.8,.3,1);
}
.pending-pressed { transform: translate(1rpx, 2rpx); box-shadow: none; }
.pending-main { flex: 1; min-width: 0; }
.pending-top { display: flex; align-items: center; gap: 8rpx; }
.pending-dot {
  flex: 0 0 auto;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: var(--primary);
}
.pending-paper {
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pending-meta { margin-top: 5rpx; color: var(--text-3); font-size: 20rpx; line-height: 1.35; }
.pending-go {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  color: var(--on-primary);
  background: var(--primary);
  border: 2rpx solid var(--edge);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
}
.pending-go-arrow { margin-left: 2rpx; font-size: 22rpx; }

/* 记录卡：日期 + 得分 → 四项图标统计 → 查看 / 删除图标 */
.record-row {
  width: 100%;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 22rpx;
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  transition: transform .12s cubic-bezier(.2,.8,.3,1), box-shadow .12s cubic-bezier(.2,.8,.3,1), background .12s ease;
}
.record-pressed {
  transform: translate(1rpx, 2rpx);
  box-shadow: none;
  background: var(--cream-1);
}

.record-paper {
  margin-bottom: 6rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-head {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}
.record-when {
  flex: 1;
  min-width: 0;
  padding-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.record-clock {
  position: relative;
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  color: var(--text-3);
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.record-clock::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 2rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.record-clock::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 7rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
  transform-origin: left center;
  transform: rotate(32deg);
}
.record-time {
  overflow: hidden;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.record-score {
  flex: 0 0 auto;
  display: flex;
  align-items: baseline;
  gap: 3rpx;
  color: var(--ink);
  font-size: 52rpx;
  font-weight: 900;
  line-height: .9;
  letter-spacing: -2rpx;
}
.record-score-value { color: inherit; }
.record-unit {
  color: var(--text-3);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.record-stats {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7rpx;
}
.stat-chip {
  min-height: 44rpx;
  padding: 0 10rpx;
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}
.stat-mark {
  width: 24rpx;
  color: inherit;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
}
.stat-value { color: inherit; font-size: 24rpx; font-weight: 900; }
.stat-empty {
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}
.is-right {
  color: var(--success-text);
  background: var(--success-bg);
  border-color: var(--success-line);
}
.is-wrong {
  color: var(--danger-text);
  background: var(--danger-bg);
  border-color: var(--danger-line);
}
.is-blank {
  color: var(--text-3);
  background: var(--chip-neutral);
  border-color: var(--line);
}
.is-acc {
  color: var(--primary-3);
  background: var(--cream-2);
  border-color: var(--line-strong);
}
.stat-target {
  position: relative;
  flex: 0 0 auto;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.stat-target::after {
  content: "";
  position: absolute;
  inset: 4rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.record-actions {
  flex: 0 0 auto;
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.icon-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: var(--text-2);
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 14rpx;
  transition: transform .12s cubic-bezier(.2,.8,.3,1), background .12s ease;
}
.icon-btn.is-danger {
  color: var(--danger-text);
  border-color: var(--danger-line);
}
.icon-btn-pressed {
  transform: translate(2rpx, 3rpx);
  background: var(--cream-3);
}
.chev {
  color: inherit;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1;
  transform: translateY(-1rpx);
}
.trash {
  position: relative;
  width: 22rpx;
  height: 24rpx;
  box-sizing: border-box;
  color: inherit;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 6rpx 6rpx;
  background:
    linear-gradient(currentColor, currentColor) 7rpx 5rpx / 2rpx 11rpx no-repeat,
    linear-gradient(currentColor, currentColor) 13rpx 5rpx / 2rpx 11rpx no-repeat;
}
.trash::before {
  content: "";
  position: absolute;
  left: -4rpx;
  top: -5rpx;
  width: 26rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.trash::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: -9rpx;
  width: 8rpx;
  height: 4rpx;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 2rpx 2rpx 0 0;
}

/* 桌面档：rpx 随窗口放大，这里统一 px 化 */
@media (min-width: 700px) {
  .pending-title { font-size: 13px; }
  .pending-count { min-width: 17px; padding: 1px 5px; font-size: 10px; }
  .pending-card { gap: 8px; margin-bottom: 7px; padding: 9px 10px; border-width: 2px; border-radius: 11px; box-shadow: 2px 2px 0 var(--shadow-soft); }
  .pending-dot { width: 5px; height: 5px; }
  .pending-paper { font-size: 14px; }
  .pending-meta { margin-top: 3px; font-size: 11px; }
  .pending-go { padding: 4px 7px; border-width: 1px; font-size: 11px; }
  .pending-go-arrow { font-size: 12px; }
  .history-page { padding-top: 15px; }
  .page-title { font-size: 22px; margin-bottom: 13px; }
  .hist-tools { margin-bottom: 11px; gap: 8px; }
  .retry-btn { padding: 0 10px; }
  .retry-glyph { font-size: 15px; }
  .retry-label { font-size: 12px; }
  .hist-count { min-height: 25px; padding: 0 8px; gap: 4px; border-width: 1px; font-size: 11px; }
  .hist-count-num { font-size: 12px; }
  .hist-count-unit { font-size: 11px; }
  .hist-stack { width: 10px; gap: 1px; margin-right: 1px; }
  .hist-line { height: 1px; }

  .empty { padding: 32px 16px; box-shadow: 3px 4px 0 var(--shadow-soft); }
  .empty-title { font-size: 17px; }
  .empty-sub { font-size: 13px; margin-top: 6px; }

  .record-row { margin-bottom: 9px; padding: 11px 12px; border-width: 1px; border-radius: 13px; box-shadow: 2px 3px 0 var(--shadow-soft); }
  .record-paper { margin-bottom: 3px; font-size: 17px; }
  .record-head { gap: 8px; }
  .record-when { padding-bottom: 2px; gap: 5px; }
  .record-clock { width: 12px; height: 12px; border-width: 1px; }
  .record-clock::before { left: 5px; top: 2px; width: 1px; height: 4px; }
  .record-clock::after { left: 5px; top: 5px; width: 4px; height: 1px; }
  .record-time { font-size: 13px; }
  .record-score { gap: 2px; font-size: 30px; letter-spacing: -1px; }
  .record-unit { font-size: 11px; }

  .record-stats { margin-top: 6px; gap: 4px; }
  .stat-chip { min-height: 26px; padding: 0 7px; gap: 3px; border-width: 1px; font-size: 14px; }
  .stat-mark { width: 13px; font-size: 15px; }
  .stat-value { font-size: 14px; }
  .stat-empty { width: 13px; height: 13px; border-width: 1px; border-radius: 3px; }
  .stat-target { width: 13px; height: 13px; border-width: 1px; }
  .stat-target::after { inset: 2px; border-width: 1px; }

  .record-actions { gap: 5px; }
  .icon-btn { width: 32px; height: 32px; border-width: 1px; border-radius: 8px; }
  .chev { font-size: 18px; }
  .trash { width: 12px; height: 14px; border-width: 1px; border-radius: 0 0 3px 3px; background: none; }
  .trash::before { left: -2px; top: -3px; width: 15px; height: 1px; }
  .trash::after { left: 3px; top: -6px; width: 4px; height: 3px; border-width: 1px; }
}
