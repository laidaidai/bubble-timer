@import "../base.wxss";
.history-page { padding-top: 26rpx; }

.page-title {
  margin-bottom: 22rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

/* 顶部工具条：再练一次做成主按钮，次数收进胶囊 */
.hist-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 0 0 20rpx;
  padding: 12rpx 16rpx;
  background: var(--cream-1);
  border: 2rpx solid var(--edge-soft);
  border-radius: 20rpx;
  box-shadow: 3rpx 3rpx 0 var(--shadow-soft);
  box-sizing: border-box;
}
.hist-count {
  flex: 0 0 auto;
  padding: 4rpx 11rpx;
  color: var(--text-3);
  background: var(--card);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

/* 空状态：大号 0 当一张标签，不再只放两行小字 */
.empty {
  padding: 56rpx 28rpx;
  text-align: center;
  border-style: dashed;
  border-color: var(--edge-soft);
  box-shadow: 5rpx 6rpx 0 var(--shadow-soft);
}
.empty-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-warm);
  background: var(--accent-bg);
  border: 3rpx solid var(--edge);
  border-radius: 50%;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
  transform: rotate(-6deg);
}
.empty-title { font-size: 30rpx; font-weight: 900; }
.empty-sub { font-size: 23rpx; color: var(--text-3); margin-top: 10rpx; }

/* 记录卡：左侧一条主色书签，右侧大分数 */
.record-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx 20rpx 28rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 26rpx;
  box-shadow: 5rpx 6rpx 0 var(--shadow-soft);
}
.record-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary);
  border-right: 2rpx solid var(--edge);
}
.record-main { flex: 1; min-width: 0; }

.record-paper { overflow: hidden; font-size: 29rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.record-time { font-size: 21rpx; color: var(--text-3); margin-top: 5rpx; }
.record-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 9rpx;
  color: var(--text-2);
  font-size: 20rpx;
}
.meta-right {
  padding: 2rpx 9rpx;
  color: var(--success-text);
  background: var(--success-bg);
  border: 2rpx solid var(--success);
  border-radius: 999rpx;
  font-weight: 800;
}
.meta-wrong {
  padding: 2rpx 9rpx;
  color: var(--danger-text);
  background: var(--danger-bg);
  border: 2rpx solid var(--danger);
  border-radius: 999rpx;
  font-weight: 800;
}
.meta-blank {
  padding: 2rpx 9rpx;
  color: var(--text-3);
  background: var(--cream-2);
  border: 2rpx solid var(--line-strong);
  border-radius: 999rpx;
  font-weight: 800;
}
.meta-acc { margin-left: auto; color: var(--text-3); font-weight: 800; font-variant-numeric: tabular-nums; }

.record-right {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.record-score {
  color: var(--ink);
  font-size: 54rpx;
  font-weight: 900;
  line-height: .95;
  letter-spacing: -2rpx;
}
.record-unit { font-size: 21rpx; font-weight: 800; margin-left: 3rpx; color: var(--text-3); }

.record-actions { display: flex; gap: 8rpx; }
.record-actions .btn { min-height: 46rpx; padding: 0 14rpx; font-size: 19rpx; box-shadow: 2rpx 2rpx 0 var(--shadow-soft); }
.del { color: var(--danger-text); border-color: var(--danger); }

/* 桌面档：rpx 随窗口放大，这里统一 px 化（px ≈ rpx × 0.56） */
@media (min-width: 700px) {
  .history-page { padding-top: 15px; }
  .page-title { font-size: 22px; margin-bottom: 13px; }
  .hist-tools { margin-bottom: 11px; padding: 7px 9px; border-width: 2px; border-radius: 11px; box-shadow: 2px 2px 0 var(--shadow-soft); }
  .hist-count { padding: 2px 6px; font-size: 11px; border-width: 1px; }
  .empty { padding: 32px 16px; box-shadow: 3px 4px 0 var(--shadow-soft); }
  .empty-mark { width: 54px; height: 54px; margin-bottom: 10px; border-width: 2px; border-radius: 50%; box-shadow: 2px 3px 0 var(--shadow-soft); font-size: 27px; }
  .empty-title { font-size: 17px; }
  .empty-sub { font-size: 13px; margin-top: 6px; }
  .record-row { gap: 10px; padding: 11px 12px 11px 16px; margin-bottom: 10px; border-radius: 15px; box-shadow: 3px 4px 0 var(--shadow-soft); }
  .record-row::before { width: 5px; border-right-width: 1px; }
  .record-paper { font-size: 17px; }
  .record-time { font-size: 12px; margin-top: 3px; }
  .record-meta { gap: 4px; margin-top: 5px; font-size: 11px; }
  .meta-right, .meta-wrong, .meta-blank { padding: 1px 5px; border-width: 1px; }
  .meta-acc { font-size: 11px; }
  .record-right { gap: 6px; }
  .record-score { font-size: 30px; letter-spacing: -1px; }
  .record-unit { font-size: 12px; }
  .record-actions { gap: 4px; }
  .record-actions .btn { min-height: 26px; padding: 0 8px; font-size: 11px; box-shadow: 1px 1px 0 var(--shadow-soft); }
}
