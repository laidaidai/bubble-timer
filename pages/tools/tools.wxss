.tools-page { height: 100vh; background: var(--bg); color: var(--ink); }
.tools-body { height: calc(100vh - 286rpx - env(safe-area-inset-bottom)); box-sizing: border-box; }
.tools-body .page-content { padding: 16rpx 20rpx 48rpx; }

.quick-feature { margin: 4rpx 0 14rpx; padding: 20rpx 20rpx 20rpx 18rpx; display: flex; align-items: center; gap: 16rpx; background: var(--primary); border: 2rpx solid var(--edge); border-radius: 26rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); }
.quick-feature:active { transform: translate(2rpx, 2rpx); box-shadow: 3rpx 4rpx 0 var(--shadow); }
.quick-feature-icon { flex: 0 0 88rpx; width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); }
.quick-feature-icon .glyph-stopwatch { transform: scale(1.35); }
.quick-feature-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.quick-feature-title { color: var(--ink); font-size: 31rpx; font-weight: 900; line-height: 1.15; }
.quick-feature-modes { display: flex; flex-wrap: wrap; gap: 6rpx; }
.quick-feature-modes .qf-mode { display: inline-flex; align-items: center; padding: 3rpx 10rpx; color: var(--text-warm); background: var(--cream-2); border: 1rpx solid var(--line-strong); border-radius: 999rpx; font-size: 17rpx; font-weight: 800; line-height: 1.2; }
.quick-feature-arrow { flex: 0 0 auto; color: var(--ink); font-size: 36rpx; font-weight: 900; line-height: 1; }

.tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-bottom: 10rpx; }
.tool-tile { position: relative; min-width: 0; min-height: 112rpx; padding: 16rpx 16rpx 16rpx 14rpx; display: flex; align-items: center; gap: 10rpx; background: var(--card); border: 2rpx solid var(--line-strong); border-radius: 20rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.tool-tile:active { transform: translate(1rpx, 1rpx); box-shadow: 2rpx 3rpx 0 var(--shadow-soft); }
.tool-tile-icon { flex: 0 0 52rpx; width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; }
.tool-tile-label { min-width: 0; overflow: hidden; color: var(--ink); font-size: 24rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.tool-tile-badge { position: absolute; z-index: 2; top: -9rpx; right: -7rpx; min-width: 24rpx; height: 24rpx; padding: 0 7rpx; display: flex; align-items: center; justify-content: center; color: var(--on-primary); background: var(--primary); border: 2rpx solid var(--edge); border-radius: 999rpx; font-size: 16rpx; font-weight: 900; line-height: 1; }

.settings-entry { width: 96rpx; height: 96rpx; margin: 16rpx 0 0 auto; display: flex; align-items: center; justify-content: center; background: var(--card); border: 2rpx solid var(--line-strong); border-radius: 50%; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); transition: transform .12s ease, box-shadow .12s ease; }
.settings-entry:active { transform: translate(1rpx, 1rpx); box-shadow: 2rpx 3rpx 0 var(--shadow-soft); }
.settings-entry-icon { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; }
.settings-entry-icon .di-gear { transform: scale(.9); }

.glyph-clock { position: relative; width: 42rpx; height: 42rpx; box-sizing: border-box; border: 2rpx solid var(--ink); border-radius: 50%; }
.glyph-clock::before { content: ""; position: absolute; left: 18rpx; top: 8rpx; width: 2rpx; height: 12rpx; background: var(--ink); border-radius: 2rpx; }
.glyph-clock::after { content: ""; position: absolute; left: 19rpx; top: 19rpx; width: 11rpx; height: 2rpx; background: var(--ink); border-radius: 2rpx; transform-origin: left center; transform: rotate(32deg); }
.glyph-stopwatch { position: relative; width: 42rpx; height: 42rpx; margin-top: 4rpx; box-sizing: border-box; border: 2rpx solid var(--ink); border-radius: 50%; }
.stopwatch-crown { position: absolute; left: 50%; top: -8rpx; width: 18rpx; height: 6rpx; border: 2rpx solid var(--ink); border-bottom: 0; border-radius: 4rpx 4rpx 0 0; transform: translateX(-50%); }
.stopwatch-hand { position: absolute; left: 50%; top: 8rpx; width: 2rpx; height: 13rpx; background: var(--ink); border-radius: 2rpx; transform-origin: bottom center; transform: translateX(-50%) rotate(38deg); }
.glyph-todo { position: relative; width: 38rpx; height: 42rpx; border: 2rpx solid var(--ink); border-radius: 10rpx; }
.todo-check { position: absolute; left: 6rpx; top: 14rpx; width: 9rpx; height: 11rpx; border-right: 3rpx solid var(--ink); border-bottom: 3rpx solid var(--ink); transform: rotate(45deg); }
.todo-line { position: absolute; left: 21rpx; width: 12rpx; height: 2rpx; background: var(--ink); border-radius: 2rpx; }
.todo-line.l1 { top: 11rpx; }
.todo-line.l2 { top: 20rpx; }
.todo-line.l3 { top: 29rpx; }
.glyph-calendar { position: relative; width: 40rpx; height: 38rpx; margin-top: 4rpx; border: 2rpx solid var(--ink); border-radius: 9rpx; }
.cal-top { position: absolute; top: 9rpx; left: 0; right: 0; height: 2rpx; background: var(--ink); }
.cal-ring { position: absolute; top: -4rpx; width: 3rpx; height: 8rpx; background: var(--ink); border-radius: 2rpx; }
.cal-ring.r1 { left: 8rpx; }
.cal-ring.r2 { right: 8rpx; }
.glyph-chart { width: 40rpx; height: 40rpx; padding: 0 2rpx; display: flex; align-items: flex-end; gap: 5rpx; }
.chart-bar { flex: 1; background: var(--ink); border-radius: 3rpx 3rpx 0 0; }
.chart-bar.b1 { height: 20rpx; }
.chart-bar.b2 { height: 30rpx; }
.chart-bar.b3 { height: 38rpx; }
.gear-entry { flex: 0 0 70rpx; width: 70rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; }
.gear-entry:active { opacity: .62; }
.di-gear { position: relative; width: 40rpx; height: 40rpx; }
/* 齿轮：空心圆环做本体，八枚小齿沿半径向外排，比原来的实心圆更像齿轮 */
.di-gear .gear-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  box-sizing: border-box;
  width: 26rpx;
  height: 26rpx;
  margin: -13rpx 0 0 -13rpx;
  border: 5rpx solid var(--ink);
  border-radius: 50%;
}
.di-gear .gear-tooth {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 9rpx;
  margin: -4.5rpx 0 0 -3.5rpx;
  background: var(--ink);
  border-radius: 2rpx 2rpx 1rpx 1rpx;
  transform-origin: 50% 50%;
}
.di-gear .t1 { transform: rotate(0deg) translateY(-15rpx); }
.di-gear .t2 { transform: rotate(45deg) translateY(-15rpx); }
.di-gear .t3 { transform: rotate(90deg) translateY(-15rpx); }
.di-gear .t4 { transform: rotate(135deg) translateY(-15rpx); }
.di-gear .t5 { transform: rotate(180deg) translateY(-15rpx); }
.di-gear .t6 { transform: rotate(225deg) translateY(-15rpx); }
.di-gear .t7 { transform: rotate(270deg) translateY(-15rpx); }
.di-gear .t8 { transform: rotate(315deg) translateY(-15rpx); }

.todo-summary { margin-top: 14rpx; display: flex; align-items: stretch; gap: 10rpx; min-width: 0; }
.todo-sum-item { flex: 0 0 105rpx; padding: 10rpx 12rpx; display: flex; flex-direction: column; gap: 2rpx; background: var(--accent-bg); border-radius: 14rpx; }
.todo-sum-num { color: var(--ink); font-size: 32rpx; font-weight: 900; line-height: 1.1; }
.todo-sum-label { color: var(--text-mid); font-size: 18rpx; font-weight: 700; }
.todo-next { flex: 1; min-width: 0; padding: 10rpx 12rpx; display: flex; flex-direction: column; gap: 3rpx; background: var(--cream-4); border: 2rpx solid var(--line); border-radius: 14rpx; }
.todo-next-label { color: var(--text-3); font-size: 18rpx; font-weight: 700; }
.todo-next-text { overflow: hidden; color: var(--ink); font-size: 20rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.todo-next-time { color: var(--text-warm); font-size: 18rpx; font-weight: 700; }
.todo-next.empty-next { justify-content: center; }

.todo-preview { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; }
.todo-preview.single, .todo-preview.count-1 { grid-template-columns: minmax(0, 1fr); }
.todo-preview.count-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.todo-preview.count-3 .todo-preview-row { padding: 13rpx 10rpx; }
.todo-preview.count-3 .todo-preview-text { font-size: 21rpx; }
.todo-preview.count-3 .todo-preview-time { font-size: 17rpx; }
.todo-preview-row { min-width: 0; min-height: 84rpx; padding: 15rpx 16rpx; display: flex; flex-direction: row; align-items: center; gap: 10rpx; background:var(--card); border:2rpx solid var(--line); border-radius: 14rpx; }
.todo-preview-line { flex: 1; display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.todo-preview-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; box-sizing: border-box; border: 2rpx solid var(--line-strong); border-radius: 50%; }
.todo-preview-text { flex: 1; min-width: 0; overflow: hidden; color: var(--ink); font-size: 24rpx; font-weight: 800; white-space: nowrap; text-overflow: ellipsis; }
.todo-preview-time { flex: 0 0 auto; margin-left: auto; color: var(--text-2); font-size: 20rpx; font-weight: 900; white-space: nowrap; }
.important-grid { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.important-grid.count-1 { grid-template-columns: minmax(0, 1fr); }
.important-grid.count-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.important-grid.count-3 .important-tool-item { padding: 12rpx 10rpx; }
.important-grid.count-3 .important-tool-name { font-size: 21rpx; }
.important-grid.count-3 .important-tool-num { font-size: 18rpx; }
.important-grid.count-3 .important-tool-unit { font-size: 16rpx; }
.important-tool-item { box-sizing: border-box; min-width: 0; min-height: 84rpx; padding: 15rpx 16rpx; display: flex; flex-direction: row; align-items: center; gap: 10rpx; background: var(--card); border: 2rpx solid var(--line); border-radius: 14rpx; }
.important-tool-item.soon { border-color: var(--line-strong); }
.important-tool-item.past { opacity: .58; }
.important-tool-line { flex: 1; display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.important-tool-dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; box-sizing: border-box; border: 2rpx solid var(--line-strong); border-radius: 50%; }
.important-tool-dot.soon { background: var(--primary); border-color: var(--primary); }
.important-tool-name { flex: 1; min-width: 0; overflow: hidden; color: var(--ink); font-size: 24rpx; font-weight: 800; white-space: nowrap; text-overflow: ellipsis; }
.important-tool-yearly { flex: 0 0 auto; padding: 1rpx 6rpx; color: var(--text-warm); background: var(--cream-2); border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.important-tool-count { flex: 0 0 auto; margin-left: auto; display: flex; align-items: baseline; gap: 3rpx; line-height: 1.1; white-space: nowrap; }
.important-tool-num { color: var(--text-2); font-size: 20rpx; font-weight: 900; }
.important-tool-unit { color: var(--text-2); font-size: 18rpx; font-weight: 900; }
.important-tool-date { color: var(--text-3); font-size: 17rpx; font-weight: 700; }
.important-tool-empty { margin-top: 14rpx; padding: 18rpx; display: flex; flex-direction: column; gap: 4rpx; background: var(--cream-4); border: 2rpx dashed var(--line-strong); border-radius: 16rpx; }
.important-tool-empty-main { color: var(--ink); font-size: 21rpx; font-weight: 800; }
.important-tool-empty-sub { color: var(--text-3); font-size: 18rpx; font-weight: 600; }

.data-percent-row { margin-top: 12rpx; display: flex; align-items: baseline; gap: 4rpx; }
.data-percent { color: var(--ink); font-size: 56rpx; font-weight: 900; line-height: 1; }
.data-percent-unit { color: var(--text-mid); font-size: 24rpx; font-weight: 900; }
.data-bar { margin-top: 12rpx; height: 14rpx; overflow: hidden; background: var(--cream-3); border: 2rpx solid var(--line-strong); border-radius: 999rpx; }
.data-bar-fill { height: 100%; background: var(--primary); border-radius: 999rpx; }
.data-metrics { margin-top: 14rpx; display: flex; align-items: stretch; gap: 10rpx; }
.data-metric { flex: 1; min-width: 0; padding: 10rpx 10rpx; display: flex; flex-direction: column; gap: 2rpx; background: var(--cream-4); border-radius: 12rpx; }
.data-metric-num { overflow: hidden; color: var(--ink); font-size: 22rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.data-metric-label { color: var(--text-3); font-size: 18rpx; font-weight: 700; }

.modal-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 999; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 0 48rpx; background: rgba(60, 44, 28, .45); }
.modal-card { width: 100%; min-width: 0; box-sizing: border-box; padding: 32rpx 28rpx 28rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 30rpx; box-shadow: 8rpx 9rpx 0 var(--shadow); }
.modal-title { color: var(--ink); font-size: 32rpx; font-weight: 900; }
.modal-desc { margin-top: 8rpx; color: var(--text-2); font-size: 21rpx; }
.modal-input { margin-top: 22rpx; padding: 0 22rpx; height: 84rpx; color: var(--ink); background: var(--cream-4); border: 2rpx solid var(--edge); border-radius: 18rpx; font-size: 28rpx; font-weight: 800; }
.modal-actions { margin-top: 24rpx; display: flex; gap: 16rpx; }
.modal-cancel { flex: 1; padding: 20rpx 0; color: var(--text-dim); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 999rpx; font-size: 26rpx; font-weight: 900; }
.modal-confirm { flex: 1; padding: 20rpx 0; color: var(--ink); background: var(--primary); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 5rpx 0 var(--shadow); font-size: 26rpx; font-weight: 900; }

.important-modal { width: 100%; min-width: 0; max-width: 100%; max-height: 86vh; overflow-y: auto; }
.important-form-row { margin-top: 14rpx; display: flex; align-items: stretch; gap: 10rpx; }
.important-date-btn { flex: 1; min-width: 0; padding: 12rpx 18rpx; background: var(--cream-4); border: 2rpx solid var(--edge); border-radius: 16rpx; }
.important-date-btn.on { background: var(--accent-bg); }
.important-date-label { display: block; color: var(--text-2); font-size: 18rpx; font-weight: 700; }
.important-date-value { display: block; margin-top: 3rpx; color: var(--ink); font-size: 24rpx; font-weight: 900; }
.important-yearly { flex: 0 0 150rpx; display: flex; align-items: center; justify-content: center; padding: 0 10rpx; color: var(--text-mid); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 16rpx; font-size: 19rpx; font-weight: 800; }
.important-yearly.on { color: var(--on-primary); background: var(--primary); box-shadow: 3rpx 3rpx 0 var(--shadow); }
.important-calendar { margin-top: 12rpx; padding: 12rpx; background: var(--cream-4); border: 2rpx solid var(--line-strong); border-radius: 18rpx; }
.important-cal-head { display: flex; align-items: center; justify-content: space-between; }
.important-cal-nav { width: 52rpx; color: var(--text-mid); text-align: center; font-size: 28rpx; font-weight: 900; }
.important-cal-title { color: var(--ink); font-size: 22rpx; font-weight: 900; }
.important-cal-weekdays { margin-top: 8rpx; display: flex; gap: 5rpx; }
.important-cal-weekday { flex: 1; color: var(--text-3); text-align: center; font-size: 18rpx; font-weight: 800; }
.important-cal-row { width: 100%; min-width: 0; margin-top: 5rpx; display: flex; gap: 5rpx; }
.important-cal-cell { flex: 1; min-width: 0; height: 48rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); background: var(--card); border: 2rpx solid var(--line); border-radius: 10rpx; font-size: 20rpx; font-weight: 800; }
.important-cal-cell.empty { background: transparent; border-color: transparent; }
.important-cal-cell.today { color: var(--text-warm); border-color: var(--line-strong); }
.important-cal-cell.selected { color: var(--on-primary); background: var(--primary); border-color: var(--edge); box-shadow: 2rpx 2rpx 0 var(--shadow); }

/* ===== 工具页动效 ===== */
.quick-feature { animation: app-rise-in .42s cubic-bezier(.2, .8, .3, 1) backwards; }
.tool-tile { animation: app-pop-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.tool-tile:nth-child(1) { animation-delay: .05s; }
.tool-tile:nth-child(2) { animation-delay: .10s; }
.tool-tile:nth-child(3) { animation-delay: .15s; }
.tool-tile:nth-child(4) { animation-delay: .20s; }
.todo-preview-row, .important-tool-item { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.todo-preview-row:nth-child(2), .important-tool-item:nth-child(2) { animation-delay: .06s; }
.todo-preview-row:nth-child(3), .important-tool-item:nth-child(3) { animation-delay: .12s; }
.todo-preview-row:nth-child(4), .important-tool-item:nth-child(4) { animation-delay: .18s; }
.settings-entry { animation: app-pop-in .46s .26s cubic-bezier(.2, .8, .3, 1) backwards; }
.settings-entry-icon .di-gear { animation: tools-gear-in .72s cubic-bezier(.2, .8, .3, 1) both; }
.tool-tile-badge { animation: app-pop-in .42s cubic-bezier(.2, .8, .3, 1) both; }

/* 图标轻微呼吸，让工具页不死板 */
.tool-tile-icon { animation: tools-icon-bob 3.4s ease-in-out infinite; }
.tool-tile:nth-child(2) .tool-tile-icon { animation-delay: .28s; }
.tool-tile:nth-child(3) .tool-tile-icon { animation-delay: .56s; }
.tool-tile:nth-child(4) .tool-tile-icon { animation-delay: .84s; }
.quick-feature-icon .stopwatch-hand { animation: tools-hand-sweep 4.8s linear infinite; }
.tool-tile .glyph-clock::after { animation: tools-clock-sweep 6s linear infinite; }
.tool-tile .chart-bar { transform-origin: center bottom; animation: tools-bar-grow .72s cubic-bezier(.2, .8, .3, 1) both; }
.tool-tile .chart-bar.b2 { animation-delay: .08s; }
.tool-tile .chart-bar.b3 { animation-delay: .16s; }
.tool-tile .todo-check { animation: tools-check-pop .6s cubic-bezier(.2, .8, .3, 1) both; }

@keyframes tools-icon-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3rpx); } }
@keyframes tools-hand-sweep { from { transform: translateX(-50%) rotate(38deg); } to { transform: translateX(-50%) rotate(398deg); } }
@keyframes tools-clock-sweep { from { transform: rotate(32deg); } to { transform: rotate(392deg); } }
@keyframes tools-bar-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
@keyframes tools-check-pop { 0% { opacity: 0; transform: scale(.4) rotate(-18deg); } 70% { opacity: 1; transform: scale(1.12) rotate(4deg); } 100% { opacity: 1; transform: scale(1) rotate(0); } }
@keyframes tools-gear-in { 0% { transform: scale(.7) rotate(-70deg); } 100% { transform: scale(.9) rotate(0); } }
.modal-mask { animation: app-page-fade .18s ease-out both; }
.modal-card { animation: app-pop-in .30s cubic-bezier(.2, .8, .3, 1) both; }

/* 快捷计时主卡的一次性高光，引导视线落到主入口 */
.quick-feature { position: relative; overflow: hidden; }
.quick-feature::after { content: ""; position: absolute; top: -20%; bottom: -20%; left: -36%; width: 26%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .34), transparent); transform: rotate(12deg); animation: tools-shimmer 1.1s .35s ease-out both; pointer-events: none; }
@keyframes tools-shimmer { from { transform: translateX(0) rotate(12deg); } to { transform: translateX(620%) rotate(12deg); } }

/* 切回工具页时重新播放入场动画 */
.tools-page.reveal { animation: app-page-fade .24s ease-out both; }
.tools-page.reveal .quick-feature { animation: app-rise-in .42s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile { animation: app-pop-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile:nth-child(1) { animation-delay: .05s; }
.tools-page.reveal .tool-tile:nth-child(2) { animation-delay: .10s; }
.tools-page.reveal .tool-tile:nth-child(3) { animation-delay: .15s; }
.tools-page.reveal .tool-tile:nth-child(4) { animation-delay: .20s; }
.tools-page.reveal .todo-preview-row,
.tools-page.reveal .important-tool-item { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .todo-preview-row:nth-child(2),
.tools-page.reveal .important-tool-item:nth-child(2) { animation-delay: .06s; }
.tools-page.reveal .todo-preview-row:nth-child(3),
.tools-page.reveal .important-tool-item:nth-child(3) { animation-delay: .12s; }
.tools-page.reveal .todo-preview-row:nth-child(4),
.tools-page.reveal .important-tool-item:nth-child(4) { animation-delay: .18s; }
.tools-page.reveal .settings-entry { animation: app-pop-in .46s .26s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile-badge { animation: app-pop-in .42s cubic-bezier(.2, .8, .3, 1) both; }

/* ===== 工具页入场动画：只挂在 reveal 上，每次切回都重播 ===== */
.tools-page { animation: none; }
.quick-feature,
.tool-tile,
.todo-preview-row,
.important-tool-item,
.settings-entry,
.tool-tile-badge { animation: none; }
.quick-feature::after,
.settings-entry-icon .di-gear,
.tool-tile .chart-bar,
.tool-tile .todo-check { animation: none; }

.tools-page.reveal { animation: app-page-fade .24s ease-out both; }
.tools-page.reveal .quick-feature { animation: app-rise-in .42s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile { animation: app-pop-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile:nth-child(1) { animation-delay: .05s; }
.tools-page.reveal .tool-tile:nth-child(2) { animation-delay: .10s; }
.tools-page.reveal .tool-tile:nth-child(3) { animation-delay: .15s; }
.tools-page.reveal .tool-tile:nth-child(4) { animation-delay: .20s; }
.tools-page.reveal .todo-preview-row,
.tools-page.reveal .important-tool-item { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .todo-preview-row:nth-child(2),
.tools-page.reveal .important-tool-item:nth-child(2) { animation-delay: .06s; }
.tools-page.reveal .todo-preview-row:nth-child(3),
.tools-page.reveal .important-tool-item:nth-child(3) { animation-delay: .12s; }
.tools-page.reveal .todo-preview-row:nth-child(4),
.tools-page.reveal .important-tool-item:nth-child(4) { animation-delay: .18s; }
.tools-page.reveal .settings-entry { animation: app-pop-in .46s .26s cubic-bezier(.2, .8, .3, 1) backwards; }
.tools-page.reveal .tool-tile-badge { animation: app-pop-in .42s cubic-bezier(.2, .8, .3, 1) both; }
.tools-page.reveal .quick-feature::after { animation: tools-shimmer 1.1s .35s ease-out both; }
.tools-page.reveal .settings-entry-icon .di-gear { animation: tools-gear-in .72s cubic-bezier(.2, .8, .3, 1) both; }
.tools-page.reveal .tool-tile .chart-bar { animation: tools-bar-grow .72s cubic-bezier(.2, .8, .3, 1) both; }
.tools-page.reveal .tool-tile .chart-bar.b2 { animation-delay: .08s; }
.tools-page.reveal .tool-tile .chart-bar.b3 { animation-delay: .16s; }
.tools-page.reveal .tool-tile .todo-check { animation: tools-check-pop .6s cubic-bezier(.2, .8, .3, 1) both; }

/* 设置齿轮固定在工具页右下角，不随内容滚动 */
.tools-page .settings-entry {
  position: fixed;
  right: 28rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  margin: 0;
  z-index: 40;
}

/* ===== 桌面 / 大屏：工具页按手机档物理尺寸渲染，避免 rpx 被窗口等比放大 ===== */
/* 底部内距要避开左下角悬浮球（它落在这块内容区上方），否则最后一张卡被压住 */
.desk .tools-body .page-content { padding: 9px 11px 72px; }
.desk .quick-feature {
  margin: 2px 0 8px;
  padding: 11px 11px 11px 10px;
  gap: 9px;
  border-width: 1px;
  border-radius: 15px;
  box-shadow: 3px 4px 0 var(--shadow);
}
.desk .quick-feature-icon { flex: 0 0 49px; width: 49px; height: 49px; border-width: 1px; border-radius: 12px; box-shadow: 2px 2px 0 var(--shadow-soft); }
.desk .quick-feature-copy { gap: 4px; }
.desk .quick-feature-title { font-size: 17px; }
.desk .quick-feature-modes .qf-mode { padding: 2px 6px; border-width: 1px; font-size: 10px; }
.desk .quick-feature-arrow { font-size: 20px; }

.desk .tool-tile {
  min-height: 63px;
  padding: 9px 9px 9px 8px;
  gap: 6px;
  border-width: 1px;
  border-radius: 11px;
  box-shadow: 2px 3px 0 var(--shadow-soft);
}
.desk .tool-tile-icon { flex: 0 0 29px; width: 29px; height: 29px; }
.desk .tool-tile-label { font-size: 13px; }
.desk .tool-tile-badge { top: -5px; right: -4px; min-width: 13px; height: 13px; padding: 0 4px; border-width: 1px; font-size: 9px; }

.desk .settings-entry { width: 54px; height: 54px; margin: 9px 0 0 auto; border-width: 1px; box-shadow: 2px 3px 0 var(--shadow-soft); }
/* 桌面下 28rpx / 126rpx 会被窗口放大成 63px / 286px，齿轮浮在半空、离底栏很远；
 * 这里钉成 px：贴屏幕右边 24px、浮在自定义底栏（52px + 安全区）上方 14px，
 * 与左下角悬浮球的基线齐平，内容列限宽时也不会被挤到列内。 */
.desk.tools-page .settings-entry {
  right: 24px;
  bottom: calc(52px + env(safe-area-inset-bottom) + 14px);
  margin: 0;
}
.desk .settings-entry-icon { width: 29px; height: 29px; }

/* 图标按手机档重绘 */
.desk .glyph-clock { width: 24px; height: 24px; border-width: 1px; }
.desk .glyph-clock::before { left: 10px; top: 5px; width: 1px; height: 7px; border-radius: 1px; }
.desk .glyph-clock::after { left: 11px; top: 11px; width: 6px; height: 1px; border-radius: 1px; transform-origin: left center; transform: rotate(32deg); }
.desk .glyph-stopwatch { width: 24px; height: 24px; margin-top: 2px; border-width: 1px; }
.desk .stopwatch-crown { top: -5px; width: 10px; height: 3px; border-width: 1px; border-bottom: 0; border-radius: 2px 2px 0 0; }
.desk .stopwatch-hand { top: 5px; width: 1px; height: 7px; border-radius: 1px; transform-origin: bottom center; transform: translateX(-50%) rotate(38deg); }
.desk .glyph-todo { width: 21px; height: 24px; border-width: 1px; border-radius: 6px; }
.desk .todo-check { left: 3px; top: 8px; width: 5px; height: 6px; border-right-width: 2px; border-bottom-width: 2px; transform: rotate(45deg); }
.desk .todo-line { left: 12px; width: 7px; height: 1px; border-radius: 1px; }
.desk .todo-line.l1 { top: 6px; }
.desk .todo-line.l2 { top: 11px; }
.desk .todo-line.l3 { top: 16px; }
.desk .glyph-calendar { width: 22px; height: 21px; margin-top: 2px; border-width: 1px; border-radius: 5px; }
.desk .cal-top { top: 5px; height: 1px; }
.desk .cal-ring { top: -2px; width: 2px; height: 4px; border-radius: 1px; }
.desk .glyph-chart { width: 22px; height: 22px; padding: 0 1px; gap: 3px; }
.desk .chart-bar { border-radius: 2px 2px 0 0; }
.desk .chart-bar.b1 { height: 11px; }
.desk .chart-bar.b2 { height: 17px; }
.desk .chart-bar.b3 { height: 21px; }
.desk .gear-entry { flex: 0 0 39px; width: 39px; height: 33px; }
.desk .di-gear { width: 22px; height: 22px; }
.desk .di-gear .gear-ring { width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px; border-width: 3px; }
.desk .di-gear .gear-tooth { width: 4px; height: 5px; margin: -2.5px 0 0 -2px; border-radius: 1px; }
.desk .di-gear .t1 { transform: rotate(0deg) translateY(-8px); }
.desk .di-gear .t2 { transform: rotate(45deg) translateY(-8px); }
.desk .di-gear .t3 { transform: rotate(90deg) translateY(-8px); }
.desk .di-gear .t4 { transform: rotate(135deg) translateY(-8px); }
.desk .di-gear .t5 { transform: rotate(180deg) translateY(-8px); }
.desk .di-gear .t6 { transform: rotate(225deg) translateY(-8px); }
.desk .di-gear .t7 { transform: rotate(270deg) translateY(-8px); }
.desk .di-gear .t8 { transform: rotate(315deg) translateY(-8px); }

/* 待办 / 数据卡 */
.desk .todo-summary { margin-top: 8px; gap: 6px; }
.desk .todo-sum-item { flex: 0 0 59px; padding: 6px 7px; gap: 1px; border-radius: 8px; }
.desk .todo-sum-num { font-size: 18px; }
.desk .todo-sum-label { font-size: 10px; }
.desk .todo-next { padding: 6px 7px; gap: 2px; border-width: 1px; border-radius: 8px; }
.desk .todo-next-label { font-size: 10px; }
.desk .todo-next-text { font-size: 11px; }
.desk .todo-next-time { font-size: 10px; }
.desk .todo-preview { margin-top: 8px; gap: 5px; }
.desk .todo-preview-text { font-size: 13px; }
.desk .todo-preview-time { font-size: 11px; }
/* 重要日子预览卡 + 日历弹窗 */
.desk .important-grid { margin-top: 8px; gap: 6px; }
.desk .important-tool-item { min-height: 47px; padding: 8px 9px; gap: 6px; border-width: 1px; border-radius: 8px; }
.desk .important-grid.count-3 .important-tool-item { padding: 7px 6px; }
.desk .important-tool-line { gap: 4px; }
.desk .important-tool-dot { flex: 0 0 8px; width: 8px; height: 8px; border-width: 1px; }
.desk .important-tool-name { font-size: 13px; }
.desk .important-grid.count-3 .important-tool-name { font-size: 12px; }
.desk .important-tool-num { font-size: 11px; }
.desk .important-grid.count-3 .important-tool-num { font-size: 10px; }
.desk .important-tool-unit { font-size: 10px; }
.desk .important-grid.count-3 .important-tool-unit { font-size: 9px; }
.desk .important-tool-yearly { padding: 1px 3px; font-size: 10px; }
.desk .important-tool-date { font-size: 10px; }
.desk .important-tool-count { gap: 2px; }
.desk .important-tool-empty { margin-top: 8px; padding: 10px; gap: 2px; border-width: 1px; border-radius: 9px; }
.desk .important-tool-empty-main { font-size: 12px; }
.desk .important-tool-empty-sub { font-size: 10px; }

.desk .important-modal { max-height: 76vh; }
.desk .important-form-row { margin-top: 8px; gap: 6px; }
.desk .important-date-btn { padding: 7px 10px; border-width: 1px; border-radius: 9px; }
.desk .important-date-label { font-size: 10px; }
.desk .important-date-value { margin-top: 2px; font-size: 13px; }
.desk .important-yearly { flex: 0 0 84px; padding: 0 6px; border-width: 1px; border-radius: 9px; font-size: 11px; }
.desk .important-calendar { margin-top: 7px; padding: 7px; border-width: 1px; border-radius: 10px; }
.desk .important-cal-nav { width: 29px; font-size: 16px; }
.desk .important-cal-title { font-size: 12px; }
.desk .important-cal-weekdays { margin-top: 4px; gap: 3px; }
.desk .important-cal-weekday { font-size: 10px; }
.desk .important-cal-row { margin-top: 3px; gap: 3px; }
.desk .important-cal-cell { height: 27px; border-width: 1px; border-radius: 6px; font-size: 11px; }

/* 待办预览行 */
.desk .todo-preview-row { min-height: 47px; padding: 8px 9px; gap: 6px; border-width: 1px; border-radius: 8px; }
.desk .todo-preview.count-3 .todo-preview-row { padding: 7px 6px; }
.desk .todo-preview-dot { flex: 0 0 8px; width: 8px; height: 8px; border-width: 1px; }
