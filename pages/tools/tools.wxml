<view class="tools-page theme-{{theme}} {{toolsReveal ? 'reveal' : ''}}" style="{{themeStyle}}">
  <view class="topbar">
    <view class="back-icon" bindtap="handleBack" aria-label="返回">‹</view>
    <view class="topbar-title">工具</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" dim="{{dockDim}}" above-tabbar="{{true}}"></brand-dock>

  <scroll-view class="tools-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="page-content">
      <!-- 快捷计时主卡 -->
      <view class="quick-feature" bindtap="openQuick">
        <view class="quick-feature-icon">
          <view class="glyph-stopwatch">
            <view class="stopwatch-crown"></view>
            <view class="stopwatch-hand"></view>
          </view>
        </view>
        <view class="quick-feature-copy">
          <text class="quick-feature-title">快捷计时</text>
          <view class="quick-feature-modes">
            <text>秒表</text>
            <text>计时器</text>
            <text>番茄钟</text>
          </view>
        </view>
        <text class="quick-feature-arrow">›</text>
      </view>

      <!-- 工具卡片 -->
      <view class="tool-grid">
        <view class="tool-tile" bindtap="openHome">
          <view class="tool-tile-icon"><view class="glyph-clock"></view></view>
          <text class="tool-tile-label">训练</text>
        </view>
        <view class="tool-tile" bindtap="openTodo">
          <view class="tool-tile-icon">
            <view class="glyph-todo">
              <view class="todo-check"></view>
              <view class="todo-line l1"></view>
              <view class="todo-line l2"></view>
              <view class="todo-line l3"></view>
            </view>
          </view>
          <text class="tool-tile-label">待办</text>
          <text class="tool-tile-badge" wx:if="{{todoTodayPending}}">{{todoTodayPending}}</text>
        </view>
        <view class="tool-tile" bindtap="openImportantPage">
          <view class="tool-tile-icon">
            <view class="glyph-calendar">
              <view class="cal-top"></view>
              <view class="cal-ring r1"></view>
              <view class="cal-ring r2"></view>
            </view>
          </view>
          <text class="tool-tile-label">重要日子</text>
          <text class="tool-tile-badge" wx:if="{{importantDates.length}}">{{importantDates.length}}</text>
        </view>
        <view class="tool-tile" bindtap="openStats">
          <view class="tool-tile-icon">
            <view class="glyph-chart">
              <view class="chart-bar b1"></view>
              <view class="chart-bar b2"></view>
              <view class="chart-bar b3"></view>
            </view>
          </view>
          <text class="tool-tile-label">打卡</text>
          <text class="tool-tile-badge" wx:if="{{todayPercent}}">{{todayPercent}}%</text>
        </view>
      </view>

      <!-- 待办 -->
      <view class="todo-preview count-{{todoPreview.length}}" wx:if="{{todoPreview.length}}" bindtap="openTodo">
        <view class="todo-preview-row" wx:for="{{todoPreview}}" wx:key="id">
          <view class="todo-preview-line">
            <view class="todo-preview-dot"></view>
            <text class="todo-preview-text">{{item.text}}</text>
          </view>
          <text class="todo-preview-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>
      </view>

      <!-- 重要日子 -->
      <view class="important-grid count-{{importantPreview.length}}" wx:if="{{importantPreview.length}}">
        <view class="important-tool-item {{item.soon ? 'soon' : ''}} {{item.isPast ? 'past' : ''}}" wx:for="{{importantPreview}}" wx:key="id" bindtap="openImportantPage">
          <view class="important-tool-name-row">
            <text class="important-tool-name">{{item.name}}</text>
          </view>
          <view class="important-tool-count">
            <text class="important-tool-num num">{{item.countdownNumber}}</text>
            <text class="important-tool-unit" wx:if="{{item.countdownUnit}}">{{item.countdownUnit}}</text>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 设置：固定悬浮在工具页右下角 -->
  <view class="settings-entry" bindtap="openSettings" aria-label="设置">
    <view class="settings-entry-icon">
      <view class="di-gear">
        <view class="gear-tooth g1"></view><view class="gear-tooth g2"></view>
        <view class="gear-tooth g3"></view><view class="gear-tooth g4"></view>
        <view class="gear-tooth g5"></view><view class="gear-tooth g6"></view>
        <view class="gear-tooth g7"></view><view class="gear-tooth g8"></view>
        <view class="gear-core"></view><view class="gear-hole"></view>
      </view>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{importantModalOpen}}" catchtouchmove="blockTouch" bindtap="closeImportantModal">
  <view class="modal-card important-modal" catchtap="blockTouch">
    <view class="modal-title">{{importantEditingId ? '编辑重要日子' : '添加重要日子'}}</view>
    <input class="modal-input" value="{{importantName}}" placeholder="例如：考研初试、妈妈的生日" maxlength="16" focus="{{importantModalOpen}}" confirm-type="done" bindinput="onImportantNameInput" bindconfirm="saveImportantDate" />
    <view class="important-form-row">
      <view class="important-date-btn {{importantCalendarOpen ? 'on' : ''}}" bindtap="toggleImportantCalendar">
        <text class="important-date-label">日期</text>
        <text class="important-date-value">{{importantDateText}}</text>
      </view>
      <view class="important-yearly {{importantYearly ? 'on' : ''}}" bindtap="toggleImportantYearly">每年重复</view>
    </view>
    <view class="important-calendar" wx:if="{{importantCalendarOpen}}">
      <view class="important-cal-head">
        <view class="important-cal-nav" data-step="-1" catchtap="shiftImportantMonth">‹</view>
        <text class="important-cal-title">{{importantCalTitle}}</text>
        <view class="important-cal-nav" data-step="1" catchtap="shiftImportantMonth">›</view>
      </view>
      <view class="important-cal-weekdays">
        <text class="important-cal-weekday" wx:for="{{importantCalWeekLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="important-cal-row" wx:for="{{importantCalRows}}" wx:key="key" wx:for-item="row">
        <view class="important-cal-cell {{cell.empty ? 'empty' : ''}} {{cell.selected ? 'selected' : ''}} {{cell.today ? 'today' : ''}}" wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key" data-key="{{cell.key}}" bindtap="selectImportantDay">{{cell.day}}</view>
      </view>
    </view>
    <view class="modal-actions">
      <button class="modal-cancel" bindtap="closeImportantModal">取消</button>
      <button class="modal-confirm" bindtap="saveImportantDate">{{importantEditingId ? '保存修改' : '添加'}}</button>
    </view>
  </view>
</view>
