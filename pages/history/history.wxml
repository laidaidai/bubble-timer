<view class="history-page theme-{{theme}}" style="{{themeStyle}}">
  <view class="topbar">
    <button class="back-icon" bindtap="handleBack">‹</button>
    <view class="topbar-title">本地训练记录</view>
    <view class="topbar-spacer"></view>
  </view>

  <scroll-view class="history-body" scroll-y>
    <view class="history-tip">
      <view class="tip-line">自动保存在本机 · 保留最近 <text class="num">10</text> 条</view>
      <view class="tip-line">清理本地缓存后记录可能丢失，重要报告请及时保存图片</view>
    </view>

    <view wx:if="{{!records.length}}" class="empty-state">
      <text class="empty-title">还没有训练记录</text>
      <button class="primary-button" bindtap="handleBack">回去开始第一次训练</button>
    </view>

    <view class="history-card" wx:for="{{records}}" wx:key="id">
      <view class="history-head">
        <view class="history-title-wrap">
          <view class="history-title">模考训练分析报告</view>
          <view class="history-time num">{{item.startedAtText}}</view>
        </view>
        <text class="status-tag">已完成</text>
      </view>
      <view class="history-meta">
        <text class="history-duration num">{{item.totalActualText}}</text>
        <text class="history-count"><text class="num">{{item.rows.length}}</text> 个模块</text>
      </view>
      <view class="history-actions">
        <button class="history-rerun" data-index="{{index}}" bindtap="rerunRecord">重跑</button>
        <button class="delete-link" data-index="{{index}}" bindtap="removeRecord">删除</button>
        <button class="history-report-button" data-index="{{index}}" bindtap="openReport">查看报告</button>
      </view>
    </view>
  </scroll-view>
</view>
