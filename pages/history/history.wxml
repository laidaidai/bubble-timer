<view class="history-page theme-{{theme}} {{historyReveal ? 'reveal' : ''}}" style="{{themeStyle}}">
  <view class="topbar">
    <view class="back-icon" bindtap="handleBack" aria-label="返回">‹</view>
    <view class="topbar-title">记录</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" dim="{{dockDim}}" above-tabbar="{{true}}"></brand-dock>

  <scroll-view class="history-body" scroll-y>
    <view class="history-card {{burstingIndex === index ? 'bubble-bursting' : ''}}" wx:for="{{records}}" wx:key="id">
      <view class="history-head">
        <view class="history-title-wrap">
          <view class="history-title">{{item.title}}</view>
          <view class="history-time num">{{item.startedAtText}}</view>
        </view>
      </view>
      <view class="history-meta">
        <text class="history-duration num">{{item.totalActualText}}</text>
        <text class="history-count"><text class="num">{{item.rows.length}}</text> 个模块</text>
      </view>
      <view class="history-actions">
        <button class="history-rerun" data-index="{{index}}" bindtap="rerunRecord">再试一次</button>
        <button class="delete-link" data-index="{{index}}" bindtap="removeRecord">删除</button>
        <button class="history-report-button" data-index="{{index}}" bindtap="openReport">查看报告</button>
      </view>
        <view class="burst-layer" aria-hidden="true">
          <view class="burst-ring"></view>
          <view class="burst-drop d1"></view><view class="burst-drop d2"></view><view class="burst-drop d3"></view><view class="burst-drop d4"></view>
          <view class="burst-drop d5"></view><view class="burst-drop d6"></view><view class="burst-drop d7"></view><view class="burst-drop d8"></view>
        </view>
    </view>

    <view class="history-empty" wx:if="{{!records.length}}">
      <image class="empty-logo" src="/assets/brand/logo.png" mode="aspectFit"></image>
      <text class="empty-short">完成一次计时后，记录会出现在这里</text>
    </view>
  </scroll-view>
  <view class="timer-launch-cover" wx:if="{{timerLaunching}}"></view>
</view>
