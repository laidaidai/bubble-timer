.history-page { min-height: 100vh; background: var(--bg); color: var(--ink); overflow-x: hidden; }
.history-body { width: 100%; height: calc(100vh - 286rpx - env(safe-area-inset-bottom)); box-sizing: border-box; overflow-x: hidden; padding: 20rpx 24rpx 0; }
.history-tail { height: 30rpx; }
.history-tip { margin-bottom: 22rpx; color: var(--text-warm); font-size: 22rpx; line-height: 1.7; }
.history-tip .tip-line { display: block; }

.empty-state { margin-top: 60rpx; display: flex; flex-direction: column; align-items: center; gap: 20rpx; color: var(--text-2); font-size: 24rpx; }
.empty-title { font-size: 26rpx; font-weight: 800; }

.history-card { width: 100%; box-sizing: border-box; min-width: 0; margin-bottom: 22rpx; padding: 24rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 28rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); }
.history-head { display: flex; align-items: flex-start; justify-content: space-between; }
.history-title-wrap { flex: 1; min-width: 0; overflow: hidden; }
.history-title { margin-bottom: 8rpx; overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 900; white-space: nowrap; text-overflow: ellipsis; }
.history-time { color: var(--text-3); font-size: 20rpx; }
.history-subline { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.history-pending-tag {
  padding: 2rpx 9rpx;
  color: var(--on-primary);
  background: var(--primary);
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.35;
}

.history-meta { margin: 20rpx 0 18rpx; display: flex; align-items: baseline; justify-content: space-between; color: var(--text-dim); font-size: 22rpx; }
.history-duration { color: var(--ink); font-size: 48rpx; font-weight: 900; }
.history-count { flex: 0 0 auto; color: var(--text-2); white-space: nowrap; }

.history-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.history-fill { width: auto !important; min-width: 0 !important; box-sizing: border-box; margin: 0; padding: 16rpx 28rpx; color: var(--on-primary); background: var(--primary); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 3rpx 4rpx 0 var(--shadow); font-size: 23rpx; font-weight: 900; line-height: 1.3; }
.history-rerun { width: auto !important; min-width: 0 !important; box-sizing: border-box; margin: 0; padding: 16rpx 28rpx; color: var(--ink); background: var(--primary-2); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 3rpx 4rpx 0 var(--shadow); font-size: 23rpx; font-weight: 900; line-height: 1.3; }
.delete-link { width: auto !important; min-width: 0 !important; box-sizing: border-box; margin: 0; padding: 16rpx 24rpx; color: var(--danger); background: var(--card); border: 2rpx solid var(--danger); border-radius: 999rpx; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); font-size: 22rpx; font-weight: 800; line-height: 1.3; }
.history-report-button { width: auto !important; min-width: 0 !important; box-sizing: border-box; margin: 0 0 0 auto; padding: 16rpx 28rpx; color: var(--on-panel); background: var(--panel); border-radius: 999rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); font-size: 24rpx; font-weight: 900; line-height: 1.3; }

.history-empty { display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 80rpx 24rpx; }
.empty-title { color: var(--ink); font-size: 30rpx; font-weight: 900; }
.empty-sub { color: var(--text-2); font-size: 22rpx; font-weight: 600; }
.empty-tip { margin-top: 8rpx; padding: 10rpx 18rpx; color: var(--text-warm); background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 19rpx; font-weight: 800; }

/* 动效：记录卡逐张出现 */
.history-card { animation: app-rise-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.history-card:nth-child(2) { animation-delay: .05s; }
.history-card:nth-child(3) { animation-delay: .10s; }
.history-card:nth-child(4) { animation-delay: .15s; }
.history-card:nth-child(n+5) { animation-delay: .20s; }

/* ===== 记录页空态与数字动效 ===== */
.history-duration { animation: app-pop-in .45s cubic-bezier(.2, .8, .3, 1) both; }
.history-card:active { transform: translate(1rpx, 1rpx); box-shadow: 3rpx 4rpx 0 var(--shadow); }
.empty-title { animation: app-rise-in .4s .05s cubic-bezier(.2, .8, .3, 1) backwards; }
.empty-tip { animation: app-pop-in .46s .12s cubic-bezier(.2, .8, .3, 1) backwards; }

/* 品牌 logo 空态 */
.empty-logo { width: 210rpx; height: 210rpx; margin-bottom: 4rpx; animation: history-logo-float 4.2s ease-in-out infinite; }
@keyframes history-logo-float { 0%, 100% { transform: translate(0, 0) rotate(0deg); } 50% { transform: translate(8rpx, -8rpx) rotate(-1.5deg); } }

/* 记录页：入场动效每次回到页面都重新播放 */
.history-page.reveal { animation: app-page-fade .24s ease-out both; }
.history-card { animation: none; }
.history-duration { animation: none; }
.history-page.reveal .history-card { animation: app-rise-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.history-page.reveal .history-duration { animation: app-pop-in .45s cubic-bezier(.2, .8, .3, 1) both; }
.history-page.reveal .empty-short { animation: app-rise-in .4s .1s cubic-bezier(.2, .8, .3, 1) backwards; }

/* 空记录只保留一句简短说明 */
.empty-short { color: var(--text-2); font-size: 22rpx; font-weight: 600; line-height: 1.5; text-align: center; }
.history-page.reveal .history-card:nth-child(2) { animation-delay: .05s; }
.history-page.reveal .history-card:nth-child(3) { animation-delay: .10s; }
.history-page.reveal .history-card:nth-child(4) { animation-delay: .15s; }
.history-page.reveal .history-card:nth-child(n+5) { animation-delay: .20s; }

/* 记录页顶部：条数 + 一键清空小图标 */
.history-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}
.history-toolbar-count { color: var(--text-2); font-size: 21rpx; font-weight: 800; }
.clear-all-btn {
  position: relative;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border: 2rpx solid var(--danger);
  border-radius: 50%;
  box-shadow: 3rpx 3rpx 0 var(--shadow-soft);
}
.clear-all-btn:active { transform: translate(1rpx, 1rpx); box-shadow: 1rpx 1rpx 0 var(--shadow-soft); }
.cross-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--danger);
}
.cross-line.a { transform: translate(-50%, -50%) rotate(45deg); }
.cross-line.b { transform: translate(-50%, -50%) rotate(-45deg); }

/* ===== 桌面 / 大屏：记录页按手机档物理尺寸渲染 ===== */
/* 底部内距避开左下角悬浮球，避免最后一条记录被压住 */
.desk .history-body { padding: 11px 13px 0; }
.desk .history-tail { height: 72px; }
.desk .history-toolbar { gap: 7px; margin-bottom: 9px; padding: 0 2px; }
.desk .history-toolbar-count { font-size: 12px; }
.desk .clear-all-btn { flex: 0 0 29px; width: 29px; height: 29px; border-width: 1px; box-shadow: 2px 2px 0 var(--shadow-soft); }
.desk .cross-line { width: 12px; height: 2px; }
.desk .history-tip { margin-bottom: 12px; font-size: 12px; line-height: 1.6; }

.desk .history-card {
  margin-bottom: 12px;
  padding: 13px;
  border-width: 1px;
  border-radius: 15px;
  box-shadow: 3px 4px 0 var(--shadow);
}
.desk .history-title { margin-bottom: 4px; font-size: 16px; }
.desk .history-time { font-size: 11px; }
.desk .history-pending-tag { padding: 1px 5px; font-size: 10px; }
.desk .history-meta { margin: 11px 0 10px; font-size: 12px; }
.desk .history-duration { font-size: 27px; }
.desk .history-count { font-size: 12px; }

/* 三个按钮：文字单行，但按钮本身可收缩、放不下就换行（修桌面下文字竖排 + 顶出卡片） */
.desk .history-actions { gap: 7px; flex-wrap: wrap; justify-content: flex-end; }
.desk .history-fill,
.desk .history-rerun,
.desk .delete-link,
.desk .history-report-button {
  /* 小程序 button 自带默认宽度（约 184px），不改它会顶出卡片 */
  flex: 0 1 auto;
  width: auto !important;
  min-width: 0 !important;
  max-width: 100%;
  box-sizing: border-box;
  padding: 8px 15px;
  border-width: 1px;
  font-size: 13px;
  line-height: 1.3;
  white-space: nowrap;
  word-break: keep-all;
  box-shadow: 2px 3px 0 var(--shadow-soft);
}
.desk .history-rerun { font-size: 13px; }
.desk .delete-link { font-size: 12px; }
.desk .history-report-button { margin-left: 0; padding: 8px 16px; font-size: 13px; box-shadow: 3px 4px 0 var(--shadow-soft); }

.desk .empty-state { margin-top: 34px; gap: 11px; font-size: 13px; }
.desk .empty-title { font-size: 15px; }
.desk .empty-sub { font-size: 12px; }
.desk .empty-tip { margin-top: 4px; padding: 5px 10px; border-width: 1px; font-size: 11px; }
.desk .empty-short { font-size: 12px; }
.desk .empty-logo { width: 118px; height: 118px; }

/* ===== 桌面 / 大屏：记录卡（主体）随屏幕适度放大；三个按钮保持手机档 ===== */
@media (min-width: 1400px) {
  .desk .history-card { padding: 16px; border-radius: 18px; }
  .desk .history-title { font-size: 20px; }
  .desk .history-pending-tag { padding: 1px 6px; font-size: 11px; }
  .desk .history-time { font-size: 12px; }
  .desk .history-meta { margin: 14px 0 12px; font-size: 14px; }
  .desk .history-duration { font-size: 34px; }
  .desk .history-toolbar-count { font-size: 13px; }
}

/* 桌面下空态 logo 静态显示，不做浮动 */
.desk .empty-logo { animation: none !important; }
