<template name="quickClock">
  <view class="q-clock-shell q-shell-{{clockStyle}} {{long ? 'q-clock-long' : ''}} {{msShow ? 'q-with-ms' : ''}}">
    <block wx:if="{{clockStyle === 'flip'}}">
      <flip-clock cells="{{flipCells}}" ms-cells="{{msCells}}" ms-show="{{msShow}}" flip-phase="{{flipPhase}}"/>
    </block>

    <!-- 积木方块：与计时页同一套牌面，毫秒用同款小牌 -->
    <view class="q-block-row" wx:elif="{{clockStyle === 'blocks'}}">
      <block wx:for="{{blockCells}}" wx:key="key">
        <view class="q-block-colon" wx:if="{{item.sep}}">:</view>
        <view class="q-block-tile" wx:else><text class="q-block-num">{{item.text}}</text></view>
      </block>
      <view class="q-block-ms" wx:if="{{msShow}}">
        <text class="q-block-ms-dot">.</text>
        <view class="q-block-tile q-block-tile-ms" wx:for="{{msCells}}" wx:key="key">
          <text class="q-block-num q-block-num-ms">{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- LED 灯：与计时页同一套七段，毫秒用同款小七段 -->
    <view class="q-led-clock" wx:elif="{{clockStyle === 'led'}}">
      <block wx:for="{{ledCells}}" wx:key="key">
        <view class="q-led-colon" wx:if="{{item.sep}}">
          <view class="q-led-dot"></view>
          <view class="q-led-dot"></view>
        </view>
        <view class="q-led-digit" wx:else>
          <view class="q-led-seg seg-a {{item.segs[0] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-b {{item.segs[1] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-c {{item.segs[2] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-d {{item.segs[3] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-e {{item.segs[4] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-f {{item.segs[5] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-g {{item.segs[6] ? 'on' : ''}}"></view>
        </view>
      </block>
      <view class="q-led-ms" wx:if="{{msShow}}">
        <text class="q-led-ms-dot">.</text>
        <view class="q-led-digit q-led-digit-ms" wx:for="{{msCells}}" wx:key="key">
          <view class="q-led-seg seg-a {{item.segs[0] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-b {{item.segs[1] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-c {{item.segs[2] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-d {{item.segs[3] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-e {{item.segs[4] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-f {{item.segs[5] ? 'on' : ''}}"></view>
          <view class="q-led-seg seg-g {{item.segs[6] ? 'on' : ''}}"></view>
        </view>
      </view>
    </view>

    <view class="q-plain-clock" wx:else>
      <text class="q-plain-num">{{mainText}}</text>
    </view>

    <view class="q-clock-ms {{clockStyle}}" wx:if="{{msShow && clockStyle !== 'flip' && clockStyle !== 'blocks' && clockStyle !== 'led'}}">
      <text class="q-ms-dot">.</text>
      <text class="q-ms-inline">{{msText}}</text>
    </view>
  </view>
</template>

<view class="quick-page theme-{{theme}} {{isDesktop ? 'desk' : ''}}" style="{{themeStyle}}">
  <view class="topbar" wx:if="{{!isDesktop}}">
    <view class="back-icon" bindtap="goBack" aria-label="返回">‹</view>
    <view class="topbar-title">快捷计时</view>
    <view class="topbar-spacer"></view>
  </view>

  <view class="quick-tabs">
    <view class="quick-tab {{tab === 'stopwatch' ? 'on' : ''}}" data-tab="stopwatch" bindtap="switchTab">秒表</view>
    <view class="quick-tab {{tab === 'countdown' ? 'on' : ''}}" data-tab="countdown" bindtap="switchTab">计时器</view>
    <view class="quick-tab {{tab === 'pomodoro' ? 'on' : ''}}" data-tab="pomodoro" bindtap="switchTab">番茄钟</view>
  </view>

  <view class="quick-body {{tab === 'countdown' && !countdownStarted ? 'picker-body' : ''}}">
    <view class="quick-clock-card {{tab === 'countdown' && !countdownStarted ? 'picker-mode' : ''}}">
      <view class="pomo-chip {{pomodoroPhase === 'focus' ? 'focus' : 'rest'}}" wx:if="{{tab === 'pomodoro'}}">
        <text class="pomo-dot {{running ? 'on' : ''}}"></text>
        <text>{{pomodoroPhase === 'focus' ? '专注' : '休息'}}</text>
        <text class="pomo-cycle num">{{pomodoroCycle}}/4</text>
      </view>

      <view class="time-picker-wrap" wx:if="{{tab === 'countdown' && !countdownStarted}}">
        <picker-view class="time-picker" indicator-style="{{indicatorStyle}}" value="{{pickerValue}}" bindchange="onTimeChange">
          <picker-view-column>
            <view class="picker-item" wx:for="{{hourOptions}}" wx:key="key">{{item.label}}</view>
          </picker-view-column>
          <picker-view-column>
            <view class="picker-item" wx:for="{{minuteOptions}}" wx:key="key">{{item.label}}</view>
          </picker-view-column>
          <picker-view-column>
            <view class="picker-item" wx:for="{{secondOptions}}" wx:key="key">{{item.label}}</view>
          </picker-view-column>
        </picker-view>
        <view class="picker-units">
          <text class="picker-unit">时</text><text class="picker-unit">分</text><text class="picker-unit">秒</text>
        </view>
      </view>

      <view class="quick-clock-stage" wx:else bindtap="cycleClockStyle">
        <view class="q-clock-slot">
          <view class="clock-display {{clockReady ? 'ready' : ''}}" style="{{clockFitVars}}">
            <template is="quickClock" data="{{...clockData}}"/>
          </view>
        </view>
        <view class="clock-style-hint {{clockHintShow ? 'show' : ''}}">{{clockHintText}}</view>
      </view>

      <scroll-view class="lap-list" wx:if="{{tab === 'stopwatch' && laps.length}}" scroll-y="true" enhanced="true" show-scrollbar="false">
        <view class="lap-row" wx:for="{{laps}}" wx:key="key">
          <text class="lap-no num">#{{item.no}}</text>
          <text class="lap-total num">{{item.total}}</text>
          <text class="lap-split num">{{item.split}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="preset-wrap" wx:if="{{tab === 'countdown' && !countdownStarted}}">
      <view class="preset-head">
        <text class="preset-title">预设时间</text>
        <text class="preset-hint" wx:if="{{recommended}}">常用推荐</text>
      </view>
      <view class="preset-grid">
        <view class="preset-chip {{selectedPreset === item.minutes ? 'on' : ''}}" wx:for="{{presets}}" wx:key="minutes" data-minutes="{{item.minutes}}" bindtap="selectPreset">
          <text>{{item.label}}</text>
          <text class="preset-badge" wx:if="{{item.minutes === recommended}}">推荐</text>
        </view>
      </view>
    </view>

  </view>

  <view class="quick-actions">
    <button class="quick-primary" bindtap="toggleRun">{{running ? '暂停' : (sessionStarted ? '继续' : '开始')}}</button>
    <button class="quick-lap" wx:if="{{tab === 'stopwatch' && sessionStarted}}" bindtap="recordLap">计次</button>
    <button class="quick-reset" bindtap="reset">重置</button>
  </view>
</view>