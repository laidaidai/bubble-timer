@import "../../styles/clocks.wxss";
.quick-page { height: 100vh; min-height: 0; display: flex; flex-direction: column; background: var(--bg); color: var(--ink); overflow: hidden; }
.quick-tabs { flex: 0 0 auto; margin: 18rpx 24rpx 0; padding: 8rpx; display: flex; gap: 8rpx; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 999rpx; }
.quick-tab { flex: 1; padding: 13rpx 0; color: var(--text-2); text-align: center; border-radius: 999rpx; font-size: 25rpx; font-weight: 900; }
.quick-tab.on { color: var(--ink); background: var(--primary); border: 2rpx solid var(--edge); box-shadow: 3rpx 4rpx 0 var(--shadow); }
.quick-body { flex: 1; min-height: 0; padding: 22rpx 24rpx 8rpx; display: flex; flex-direction: column; gap: 14rpx; overflow-y: auto; }
.quick-clock-card { position: relative; flex: 1; min-height: 0; width: 100%; margin-top: 0; padding: 10rpx 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.quick-clock-card.picker-mode { flex: 0 0 auto; padding-top: 2rpx; }

@keyframes quick-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

.preset-wrap { padding: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.preset-head { margin-bottom: 14rpx; display: flex; align-items: center; justify-content: space-between; }
.preset-title { color: var(--ink); font-size: 24rpx; font-weight: 900; }
.preset-hint { color: var(--text-warm); font-size: 19rpx; font-weight: 800; }
.preset-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.preset-chip { position: relative; flex: 1 1 calc(33.333% - 8rpx); min-width: calc(33.333% - 8rpx); padding: 17rpx 6rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); background: var(--cream-3); border: 2rpx solid var(--line-strong); border-radius: 16rpx; font-size: 24rpx; font-weight: 900; }
.preset-chip.on { background: var(--primary); border-color: var(--edge); box-shadow: 3rpx 4rpx 0 var(--shadow-soft); }
.preset-badge { position: absolute; top: -12rpx; right: -8rpx; padding: 2rpx 7rpx; color: var(--on-primary); background: var(--primary-2); border: 2rpx solid var(--edge); border-radius: 999rpx; font-size: 15rpx; font-weight: 900; line-height: 1.3; }

/* 时间选择器 */
.time-picker { width: 100%; height: 320rpx; overflow: hidden; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.picker-item { height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); font-family: "Courier New", Menlo, monospace; font-size: 42rpx; font-weight: 900; line-height: 88rpx; }
.picker-units { margin-top: 6rpx; display: flex; color: var(--text-3); font-size: 20rpx; font-weight: 800; }
.picker-units .picker-unit { flex: 1; text-align: center; }

.quick-actions { flex: 0 0 auto; display: flex; gap: 12rpx; }
.quick-primary, .quick-lap, .quick-reset { height: 92rpx; min-height: 92rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 5rpx 0 var(--shadow); font-size: 27rpx; font-weight: 900; line-height: 1; }
.quick-primary { flex: 1; color: var(--ink); background: var(--primary); }
.quick-lap { flex: 0 0 150rpx; color: var(--ink); background: var(--cream-3); }
.quick-reset { flex: 0 0 150rpx; color: var(--text-2); background: var(--cream-1); }
.quick-primary:active, .quick-lap:active, .quick-reset:active { transform: translate(2rpx, 2rpx); box-shadow: 2rpx 3rpx 0 var(--shadow); }

/* 倒计时时间选择：时 / 分 / 秒，滚动时轻微震动 */
.time-picker-wrap { width: 100%; padding: 0 8rpx; }
.time-picker { width: 100%; height: 280rpx; overflow: hidden; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 20rpx; }
.picker-item { height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); font-family: "Courier New", Menlo, monospace; font-size: 36rpx; font-weight: 900; line-height: 88rpx; }
.picker-units { margin-top: 4rpx; display: flex; color: var(--text-2); font-size: 20rpx; font-weight: 800; }
.picker-units .picker-unit { flex: 1; text-align: center; }

/* ---- 快捷计时的时钟特效 ---- */
.quick-clock-stage { flex: 1; min-height: 0; width: 100%; display: flex; justify-content: center; align-items: center; }
.clock-display { width: 100%; display: flex; justify-content: center; align-items: center; }
/* 时钟容器：高度由 JS 按窗口写入（--clockSlotH），皮肤统一等比缩进容器。
   zoom 会真的改变布局尺寸，所以换皮肤时卡片、按钮都不会跟着跳。 */
.quick-page .q-clock-slot {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
.quick-page .q-clock-shell { zoom: var(--q-fit, 1); transform-origin: center center; }

.q-clock-shell.q-shell-flip { padding: 10rpx 14rpx; background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); gap: 2rpx; }
.q-clock-shell.q-shell-flip.q-clock-long { padding: 8rpx 10rpx; }
.q-flip-row { display: flex; align-items: center; justify-content: center; gap: 2rpx; perspective: 760rpx; }
.q-shell-flip .q-flip-colon { color: var(--text-warm); font-size: 34rpx; font-weight: 900; padding: 0 4rpx; line-height: 1; opacity: .8; }
.q-flip-card { position: relative; width: 92rpx; height: 160rpx; overflow: hidden; flex: 0 0 auto; background: transparent; border: 0; border-radius: 8rpx; box-shadow: none; transform-style: preserve-3d; }
.q-flip-face { position: absolute; left: 0; width: 100%; height: 50%; overflow: hidden; z-index: 1; background: var(--panel); }
.q-flip-face-top { top: 0; border-radius: 8rpx 8rpx 0 0; }
.q-flip-face-bottom { bottom: 0; border-radius: 0 0 8rpx 8rpx; }
.q-flip-face-old { z-index: 2; }
.q-flip-num { position: absolute; left: 0; width: 100%; height: 200%; color: var(--accent-text); font-family: "Courier New", "Menlo", monospace; font-size: 66rpx; font-weight: 900; line-height: 160rpx; text-align: center; }
.q-flip-face-top .q-flip-num { top: 0; }
.q-flip-face-bottom .q-flip-num { top: -100%; }
.q-flip-flap { position: absolute; z-index: 4; left: 0; right: 0; height: 50%; overflow: hidden; background: var(--panel); backface-visibility: hidden; }
.q-flip-flap-top { top: 0; border-radius: 8rpx 8rpx 0 0; transform-origin: 50% 100%; animation-duration: 190ms; animation-timing-function: cubic-bezier(.4, .02, .22, 1); animation-fill-mode: both; }
.q-flip-flap-bottom { bottom: 0; border-radius: 0 0 8rpx 8rpx; transform-origin: 50% 0; transform: rotateX(90deg); animation-duration: 190ms; animation-delay: 190ms; animation-timing-function: cubic-bezier(.4, .02, .22, 1); animation-fill-mode: both; }
.q-flip-flap-face { position: absolute; left: 0; top: 0; width: 100%; height: 200%; display: flex; align-items: center; justify-content: center; background: var(--panel); border-radius: 10rpx 10rpx 0 0; }
.q-flip-flap-face-bottom { top: -100%; border-radius: 0 0 10rpx 10rpx; }
.q-flip-flap-face .q-flip-num { position: relative; top: auto; left: auto; width: auto; height: auto; line-height: 1; }
.q-flip-card.flip-a .q-flip-flap-top { animation-name: q-flip-top; }
.q-flip-card.flip-b .q-flip-flap-top { animation-name: q-flip-top; animation-delay: 0ms; }
.q-flip-card.flip-b .q-flip-flap-bottom { animation-delay: 190ms; }
.q-flip-card.flip-a .q-flip-flap-bottom { animation-name: q-flip-bottom; }
.q-flip-card.flip-b .q-flip-flap-bottom { animation-name: q-flip-bottom; animation-delay: 190ms; }
@keyframes q-flip-top { 0% { transform: rotateX(0deg); } 100% { transform: rotateX(-90deg); } }
@keyframes q-flip-bottom { 0% { transform: rotateX(90deg); } 100% { transform: rotateX(0deg); } }
.q-flip-split { position: absolute; z-index: 6; left: 0; right: 0; top: 50%; height: 1rpx; margin-top: -1rpx; background: var(--panel-deep); opacity: .75; }
.q-shell-flip .q-flip-face, .q-shell-flip .q-flip-flap, .q-shell-flip .q-flip-flap-face { background: var(--cream-2); }
.q-shell-flip .q-flip-num { color: var(--ink); }
.q-shell-flip .q-flip-split { background: var(--line-strong); opacity: .8; }

.q-plain-clock { display: flex; align-items: center; justify-content: center; }
.q-plain-num { display: inline-block; min-width: 3.3em; text-align: center; font-family: "Courier New", "Menlo", monospace; font-weight: 900; font-size: 100rpx; line-height: 1; letter-spacing: 2rpx; font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }

/* 毫秒读数：翻页风格用迷你翻页卡片，数字风格用内联小字 */
.q-clock-shell { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 4rpx; }
.q-clock-line { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 4rpx; max-width: 100%; }
.q-clock-shell.q-shell-gradient { padding: 10rpx 18rpx; background: var(--panel); border: 2rpx solid var(--edge-deep); border-radius: 20rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft), inset 0 0 24rpx rgba(255, 209, 102, .14); gap: 4rpx; }
.q-clock-shell.q-shell-gradient.q-clock-long { padding: 8rpx 14rpx; }
.q-shell-gradient { align-items: flex-end; gap: 2rpx; }
.q-shell-gradient .q-plain-num { color: var(--on-panel); text-shadow: 0 0 10rpx rgba(255,255,255,.18); }
.q-shell-gradient .q-ms-inline, .q-shell-gradient .q-ms-dot { color: var(--on-panel); }
.q-clock-ms { display: flex; align-items: flex-end; justify-content: center; gap: 3rpx; flex: 0 0 auto; min-width: 3.6ch; }
.q-clock-ms.flip { margin-left: 4rpx; padding-left: 4rpx; }
.q-ms-flip { color: var(--accent-text); font-size: 46rpx; letter-spacing: 1rpx; opacity: 1; padding-bottom: 10rpx; }
.q-shell-outline .q-ms-inline { color: transparent; -webkit-text-stroke: 4rpx var(--ink); }
.q-shell-outline .q-ms-dot { color: var(--ink); }
.q-shell-minimal .q-ms-inline, .q-shell-minimal .q-ms-dot { color: var(--ink); font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-weight: 200; letter-spacing: 4rpx; }
.q-ms-dot { color: var(--ink); font-family: "Courier New", Menlo, monospace; font-size: 40rpx; font-weight: 900; line-height: 1; margin: 0 2rpx; align-self: flex-end; }
.q-shell-flip .q-ms-dot { color: var(--accent-text); opacity: 1; }
.q-ms-inline { display: inline-block; min-width: 2.1ch; text-align: center; color: var(--ink); font-family: "Courier New", Menlo, monospace; font-size: 100rpx; font-weight: 900; line-height: 1; letter-spacing: 0; font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }
.q-flip-card-ms { width: 92rpx; height: 160rpx; }
.q-flip-card-ms .q-flip-num { font-size: 66rpx; line-height: 160rpx; }
.q-flip-card-ms .q-flip-split { height: 2rpx; margin-top: -1rpx; }

/* ---- 快速计时：荧光划线 / 描边空心 / 细体留白 三种数字时钟 ----
 * 外观（无框、描边、配色）统一在 styles/clocks.wxss，这里只留内边距。 */
.q-shell-neon { padding: 14rpx 26rpx; }
.q-shell-neon.q-clock-long { padding: 10rpx 18rpx; }
.q-shell-outline { padding: 10rpx 26rpx; }
.q-shell-outline.q-clock-long { padding: 8rpx 18rpx; }
.q-shell-minimal { padding: 0; }
.q-shell-minimal.q-clock-long { padding: 0; }

/* 超过 1 小时：时间整体缩小，避免超出屏幕 */
.q-clock-long .q-flip-card,
.q-clock-long .q-flip-card-ms { width: 64rpx; height: 116rpx; }
.q-clock-long .q-flip-card .q-flip-num,
.q-clock-long .q-flip-card-ms .q-flip-num { font-size: 46rpx; line-height: 116rpx; }
.q-clock-long .q-flip-colon { font-size: 28rpx; }
.q-clock-long .q-plain-num { font-size: 84rpx; }
.q-clock-long .q-ms-inline { font-size: 64rpx; }
.q-clock-long .q-ms-flip { font-size: 34rpx; padding-bottom: 7rpx; }

/* 番茄钟阶段 */
.pomo-chip { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -190rpx); display: flex; align-items: center; gap: 7rpx; padding: 6rpx 15rpx; color: var(--text-2); background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 20rpx; font-weight: 900; }
.pomo-chip.focus { color: var(--ink); background: var(--primary); border-color: var(--edge); }
.pomo-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--line-strong); }
.pomo-dot.on { background: var(--success); animation: quick-pulse 1.2s ease-in-out infinite; }
.pomo-cycle { margin-left: 3rpx; color: var(--text-warm); font-size: 18rpx; }

/* 秒表计次 */
.lap-list { align-self: stretch; width: 100%; max-height: 230rpx; margin-top: 2rpx; }
.lap-row { height: 56rpx; padding: 0 10rpx; display: flex; align-items: center; gap: 10rpx; border-bottom: 1rpx dashed var(--line); }
.lap-no { flex: 0 0 72rpx; color: var(--text-2); font-size: 21rpx; font-weight: 900; }
.lap-total { flex: 1; color: var(--ink); text-align: right; font-size: 25rpx; font-weight: 900; }
.lap-split { flex: 0 0 190rpx; color: var(--text-warm); text-align: right; font-size: 20rpx; font-weight: 800; }

/* 动效：快捷计时主体进入 */
.quick-body { animation: app-rise-in .40s cubic-bezier(.2, .8, .3, 1) both; }

/* 快捷计时到点：时钟卡片轻微弹一下 */
.quick-clock-card.just-finished { animation: quick-finish-pop .55s cubic-bezier(.2, .8, .3, 1) backwards; }
@keyframes quick-finish-pop {
  0% { transform: scale(1); }
  28% { transform: scale(1.035); }
  62% { transform: scale(.995); }
  100% { transform: scale(1); }
}

/* 快捷计时到点：小泡泡上浮 */
.quick-burst {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  z-index: 40;
  overflow: hidden;
  pointer-events: none;
  animation: quick-burst-fade .24s ease-out both;
}
.quick-burst-bubble {
  position: absolute;
  bottom: 32%;
  border-radius: 50%;
  opacity: 0;
  animation-name: quick-bubble-rise;
  animation-timing-function: cubic-bezier(.18, .7, .3, 1);
  animation-fill-mode: both;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, .35), 0 0 16rpx rgba(255, 255, 255, .25);
}
.qb-0 { background: var(--primary); }
.qb-1 { background: var(--primary-2); }
.qb-2 { background: var(--card); }
@keyframes quick-burst-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes quick-bubble-rise {
  0% { opacity: 0; transform: translateY(0) scale(.5); }
  16% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-58vh) scale(1.06); }
}

/* ---- 快捷计时 UI 刷新：贴纸式控制台 ---- */
.quick-page .topbar-title { font-size: 34rpx; letter-spacing: 1rpx; }
.quick-body { gap: 18rpx; }

.quick-clock-card { padding: 14rpx 0 0; gap: 8rpx; }
.quick-clock-card.picker-mode { flex: 0 0 auto; justify-content: flex-start; padding-top: 0; }

.quick-clock-stage { position: relative; flex: 1; min-height: 0; width: 100%; padding: 12rpx 0; }
.clock-halo {
  position: absolute;
  top: 50%; left: 50%;
  width: 470rpx; height: 470rpx;
  transform: translate(-50%, -50%) scale(.92);
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent-bg) 0%, rgba(0,0,0,0) 68%);
  opacity: .16;
  pointer-events: none;
  transition: opacity .28s ease, transform .28s ease;
}
.quick-clock-stage.running .clock-halo { opacity: .52; transform: translate(-50%, -50%) scale(1); animation: quick-halo-breathe 2.4s ease-in-out infinite; }
@keyframes quick-halo-breathe {
  0%, 100% { transform: translate(-50%, -50%) scale(.96); opacity: .4; }
  50% { transform: translate(-50%, -50%) scale(1.04); opacity: .62; }
}
.clock-display { position: relative; z-index: 1; }

.clock-style-dots { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 2rpx 0 4rpx; }
.clock-style-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--line-strong); border: 2rpx solid transparent; transition: all .18s ease; }
.clock-style-dot.on { width: 22rpx; border-radius: 999rpx; background: var(--primary); border-color: var(--edge); box-shadow: 2rpx 3rpx 0 var(--shadow-soft); }

.time-picker-wrap {
  box-sizing: border-box;
  width: 100%;
  padding: 10rpx 10rpx 4rpx;
  background: var(--card);
  border: 3rpx solid var(--edge);
  border-radius: 26rpx;
  box-shadow: 6rpx 7rpx 0 var(--shadow-soft);
}
.time-picker { width: 100%; height: 300rpx; background: transparent; border: 0; border-radius: 18rpx; box-shadow: none; }
.picker-indicator { height: 88rpx; background: transparent; border-top: 2rpx solid var(--line-strong); border-bottom: 2rpx solid var(--line-strong); border-radius: 14rpx; }
.picker-item { height: 88rpx; color: var(--ink); font-size: 38rpx; }
.picker-units { margin-top: 8rpx; padding: 0 18rpx; color: var(--text-2); }
.picker-units .picker-unit { flex: 1; text-align: center; font-size: 20rpx; }

.preset-wrap { padding-top: 2rpx; }
.preset-head { margin-bottom: 12rpx; }
.preset-chip {
  box-sizing: border-box;
  padding: 19rpx 8rpx;
  background: var(--cream-1);
  border: 3rpx solid var(--line-strong);
  border-radius: 18rpx;
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
}
.preset-chip.on { background: var(--primary); border-color: var(--edge); box-shadow: 4rpx 5rpx 0 var(--shadow); transform: translateY(-2rpx); }
.preset-chip:active { transform: translate(1rpx, 2rpx); box-shadow: 2rpx 2rpx 0 var(--shadow-soft); }
.preset-badge { top: -13rpx; right: -7rpx; padding: 3rpx 8rpx; }

.quick-actions { gap: 12rpx; padding-top: 4rpx; align-items: stretch; }
.quick-primary, .quick-lap, .quick-reset {
  box-sizing: border-box;
  height: 104rpx;
  min-height: 104rpx;
  border: 3rpx solid var(--edge);
  border-radius: 999rpx;
  box-shadow: 6rpx 7rpx 0 var(--shadow);
  gap: 10rpx;
  transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
}
.quick-primary { flex: 1; background: var(--primary); color: var(--ink); font-size: 28rpx; }
.quick-primary.running { background: var(--accent-bg); }
.quick-lap, .quick-reset { flex: 0 0 132rpx; flex-direction: column; gap: 2rpx; font-size: 20rpx; }
.quick-lap { background: var(--cream-2); color: var(--ink); }
.quick-reset { background: var(--cream-1); color: var(--text-2); }
.act-glyph { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.glyph-play { width: 0; height: 0; border-left: 18rpx solid var(--ink); border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; }
.glyph-pause { width: 24rpx; height: 28rpx; gap: 7rpx; }
.glyph-pause::before, .glyph-pause::after { content: ''; display: block; width: 8rpx; height: 28rpx; background: var(--ink); border-radius: 3rpx; }
.glyph-plus { position: relative; width: 24rpx; height: 24rpx; }
.glyph-plus::before, .glyph-plus::after { content: ''; position: absolute; background: var(--ink); border-radius: 2rpx; }
.glyph-plus::before { left: 0; top: 10rpx; width: 24rpx; height: 4rpx; }
.glyph-plus::after { left: 10rpx; top: 0; width: 4rpx; height: 24rpx; }
.glyph-reset { width: 24rpx; height: 24rpx; box-sizing: border-box; border: 3rpx solid var(--ink); border-top-color: transparent; border-radius: 50%; transform: rotate(-24deg); }
.quick-lap .act-glyph, .quick-reset .act-glyph { width: 24rpx; height: 24rpx; }
.quick-primary:active, .quick-lap:active, .quick-reset:active { transform: translate(3rpx, 4rpx); box-shadow: 2rpx 3rpx 0 var(--shadow); }

.lap-list { box-sizing: border-box; margin-top: 10rpx; padding: 4rpx 12rpx; background: var(--cream-1); border: 2rpx solid var(--line); border-radius: 20rpx; }
.lap-row { height: 54rpx; padding: 0 6rpx; }
.lap-no { flex-basis: 66rpx; font-size: 20rpx; }
.lap-total { font-size: 24rpx; }
.lap-split { flex-basis: 172rpx; font-size: 19rpx; }

.pomo-chip {
  position: static;
  transform: none;
  margin: 0 0 6rpx;
  padding: 7rpx 16rpx;
  background: var(--accent-bg);
  border: 2rpx solid var(--line-strong);
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  font-size: 19rpx;
}
.pomo-chip.focus { background: var(--primary); border-color: var(--edge); }
.pomo-dot { width: 10rpx; height: 10rpx; }

.q-clock-shell.q-shell-flip { padding: 12rpx 16rpx; border: 3rpx solid var(--edge); border-radius: 24rpx; box-shadow: 6rpx 7rpx 0 var(--shadow-soft); background: var(--cream-1); }
.q-clock-shell.q-shell-gradient { padding: 12rpx 20rpx; border: 3rpx solid var(--edge-deep); border-radius: 22rpx; box-shadow: 6rpx 7rpx 0 var(--shadow-soft); }
.q-clock-shell.q-shell-outline { padding: 12rpx 28rpx; }

/* 时钟再放大一档，填满快捷计时主舞台 */
.q-flip-card, .q-flip-card-ms { width: 100rpx; height: 176rpx; }
.q-flip-num, .q-flip-card-ms .q-flip-num { font-size: 72rpx; line-height: 176rpx; }
.q-plain-num { font-size: 112rpx; }
.q-ms-inline { font-size: 108rpx; }

/* 积木方块 / LED：与计时页、设置共用同一套样式目录 */
.q-block-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  background: var(--cream-2);
  border: 2rpx solid var(--line-strong);
  border-radius: 22rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
}
.q-block-tile {
  width: 78rpx;
  height: 136rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel);
  border: 3rpx solid var(--edge-deep);
  border-radius: 12rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
}
.q-block-num { color: var(--accent-text); font-family: "Courier New", Menlo, monospace; font-size: 70rpx; font-weight: 900; line-height: 1; }
.q-block-colon { color: var(--text-warm); font-size: 34rpx; font-weight: 900; line-height: 1; padding: 0 2rpx; opacity: .8; }

.q-led-clock {
  padding: 12rpx 24rpx;
  background: var(--panel);
  border: 2rpx solid var(--edge-deep);
  border-radius: 22rpx;
  box-shadow: 0 0 22rpx rgba(255, 60, 172, .18), inset 0 0 24rpx rgba(0, 0, 0, .18);
}
.q-led-num {
  color: var(--primary-2);
  font-family: "Courier New", Menlo, monospace;
  font-size: 100rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1;
  text-shadow: 0 0 8rpx var(--primary-2), 0 0 22rpx var(--primary-2), 0 0 40rpx rgba(80, 220, 255, .35);
}
.q-clock-ms.blocks .q-ms-inline { color: var(--accent-text); }
.q-clock-ms.led .q-ms-inline { color: var(--primary-2); text-shadow: 0 0 8rpx var(--primary-2); }
.q-clock-long .q-block-tile { width: 56rpx; height: 100rpx; border-width: 2rpx; }
.q-clock-long .q-block-num { font-size: 48rpx; }
.q-clock-long .q-block-colon { font-size: 28rpx; }
.q-clock-long .q-led-num { font-size: 76rpx; }


/* 毫秒跟随主时钟样式：不再是一条裸文字 */
.q-flip-card-ms { width: 58rpx; height: 104rpx; }
.q-flip-card-ms .q-flip-num { font-size: 38rpx; line-height: 104rpx; }
.q-flip-row .q-ms-dot { font-size: 30rpx; }
.q-clock-long .q-flip-card-ms { width: 44rpx; height: 78rpx; }
.q-clock-long .q-flip-card-ms .q-flip-num { font-size: 28rpx; line-height: 78rpx; }

.q-block-tile-ms { width: 30rpx; height: 40rpx; border-width: 2rpx; border-radius: 6rpx; box-shadow: 2rpx 2rpx 0 var(--shadow-soft); }
.q-block-tile-ms .q-block-num { font-size: 22rpx; }
.q-block-row .q-ms-dot { font-size: 24rpx; }

.q-clock-ms { margin-left: 2rpx; }
.q-clock-ms .q-ms-dot { font-size: 34rpx; }
.q-shell-gradient .q-ms-inline { font-size: 62rpx; padding-bottom: 4rpx; }
.q-shell-neon .q-ms-inline { font-size: 62rpx; padding-bottom: 8rpx; }
.q-shell-outline .q-ms-inline { font-size: 58rpx; }
.q-shell-minimal .q-ms-inline { font-size: 58rpx; }
.q-clock-ms.led .q-ms-inline { font-size: 54rpx; }

/* ===== 快捷计时页动效补充 ===== */
.quick-tabs { animation: app-rise-in .38s cubic-bezier(.2, .8, .3, 1) backwards; }
.quick-tab.on { animation: app-pop-in .24s ease-out backwards; }
.quick-clock-card { animation: app-rise-in .42s .04s cubic-bezier(.2, .8, .3, 1) backwards; }
.quick-clock-card.picker-mode { animation: app-rise-in .3s ease-out backwards; }

/* ===== 秒表毫秒与秒同尺寸；进入小时后毫秒由 JS 自动收起 ===== */
.q-flip-card-ms { width: 100rpx; height: 176rpx; }
.q-flip-card-ms .q-flip-num { font-size: 72rpx; line-height: 176rpx; }
.q-clock-long .q-flip-card-ms { width: 64rpx; height: 116rpx; }
.q-clock-long .q-flip-card-ms .q-flip-num { font-size: 46rpx; line-height: 116rpx; }

.q-block-tile-ms { width: 78rpx; height: 136rpx; border-width: 3rpx; border-radius: 12rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.q-block-tile-ms .q-block-num { font-size: 70rpx; }
.q-clock-long .q-block-tile-ms { width: 56rpx; height: 100rpx; border-width: 2rpx; }
.q-clock-long .q-block-tile-ms .q-block-num { font-size: 48rpx; }

.q-clock-ms .q-ms-inline { padding-bottom: 0; }
.q-shell-gradient .q-ms-inline { font-size: 112rpx; }
.q-shell-neon .q-ms-inline { font-size: 112rpx; }
.q-shell-outline .q-ms-inline { font-size: 112rpx; }
.q-shell-minimal .q-ms-inline { font-size: 112rpx; }
.q-clock-ms.led .q-ms-inline { font-size: 100rpx; }

/* 6 张卡片（4 位时间 + 2 位毫秒）同样尺寸，控制在手机宽度内 */
.q-flip-card, .q-flip-card-ms { width: 88rpx; height: 156rpx; }
.q-flip-num, .q-flip-card-ms .q-flip-num { font-size: 63rpx; line-height: 156rpx; }
.q-clock-long .q-flip-card, .q-clock-long .q-flip-card-ms { width: 64rpx; height: 116rpx; }
.q-clock-long .q-flip-card .q-flip-num, .q-clock-long .q-flip-card-ms .q-flip-num { font-size: 46rpx; line-height: 116rpx; }

/* LED 灯：主时间和毫秒必须同一行，不能上下换行 */
.q-led-clock { display: flex; flex-direction: row; align-items: flex-end; justify-content: center; gap: 0; white-space: nowrap; }
.q-led-clock .q-led-num { flex: 0 0 auto; }
.q-led-clock .q-clock-ms { flex: 0 0 auto; margin-left: 4rpx; }
.q-led-clock .q-ms-dot { align-self: flex-end; line-height: 1; }


/* ===== 时钟样式调整：翻页/积木去背景，数字/极简加框，极简手写，新增果冻 ===== */
.q-clock-shell.q-shell-flip,
.q-clock-shell.q-shell-flip.q-clock-long {
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.q-shell-flip .q-flip-face,
.q-shell-flip .q-flip-flap,
.q-shell-flip .q-flip-flap-face { background: transparent; }
.q-shell-flip .q-flip-split { display: none; }
.q-shell-flip .q-flip-colon { color: var(--ink); opacity: 1; }

.q-block-row {
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.q-block-tile {
  background: transparent;
  border: 0;
  box-shadow: none;
}
.q-block-num, .q-block-colon { color: var(--ink); }
.q-block-colon { opacity: 1; }

.q-shell-minimal {
  padding: 10rpx 26rpx;
  box-sizing: border-box;
  justify-content: center;
  transition: none;
}
.q-shell-minimal.q-clock-long { padding: 8rpx 20rpx; }
.q-shell-minimal .q-plain-num,
.q-shell-minimal .q-ms-inline,
.q-shell-minimal .q-ms-dot {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  text-align: center;
}
/* 极简壳的宽度锁死在最高位数量上，个位数字变化时外框不再抽动 */
.q-shell-minimal .q-plain-clock { justify-content: center; }

.q-shell-jelly .q-plain-num {
  color: var(--primary);
  -webkit-text-stroke: 2rpx var(--edge);
  text-shadow: 4rpx 5rpx 0 var(--primary-2), 7rpx 8rpx 0 var(--edge);
  letter-spacing: 2rpx;
}
.q-shell-jelly .q-ms-inline {
  color: var(--primary);
  -webkit-text-stroke: 2rpx var(--edge);
  text-shadow: 3rpx 4rpx 0 var(--primary-2), 5rpx 6rpx 0 var(--edge);
}
.q-shell-jelly .q-ms-dot { color: var(--ink); }

/* 翻页 / 积木去掉背景后，用中缝和投影保留各自识别度 */
.q-flip-split {
  display: block;
  left: 18%;
  right: 18%;
  height: 1rpx;
  margin-top: 0;
  background: rgba(30, 52, 72, .30);
  opacity: 1;
}
.q-flip-num { text-shadow: 2rpx 2rpx 0 var(--line-strong); }
.q-block-num { text-shadow: 3rpx 3rpx 0 var(--line-strong); }
.q-shell-flip .q-flip-split {
  display: block;
  left: 18%;
  right: 18%;
  height: 1rpx;
  margin-top: 0;
  background: rgba(30, 52, 72, .30);
  opacity: 1;
}

/* ===== 翻页时钟：快捷计时使用主题翻页牌 =====
   翻页牌已抽到 /components/flip-clock/index，这里只留非 flip 样式下的兼容兜底。 */

/* ===== 时钟皮肤收口：颜色一律取自 styles/clocks.wxss ===== */
.q-shell-flip .q-flip-face,
.q-shell-flip .q-flip-flap,
.q-shell-flip .q-flip-flap-face { background: var(--clk-face); }
.q-shell-flip .q-flip-num,
.q-shell-flip .q-flip-colon { color: var(--clk-ink); }
.q-shell-flip .q-flip-split { background: var(--clk-line); }
.q-shell-flip .q-ms-dot { color: var(--clk-accent); }
.q-shell-gradient .q-plain-num,
.q-shell-gradient .q-ms-inline,
.q-shell-gradient .q-ms-dot { color: var(--clk-ink); }
.q-shell-neon .q-plain-num,
.q-shell-neon .q-ms-inline,
.q-shell-neon .q-ms-dot { color: var(--clk-ink); }
.q-shell-outline .q-plain-num,
.q-shell-outline .q-ms-inline { -webkit-text-stroke-color: var(--clk-ink); }
.q-shell-outline .q-ms-dot,
.q-shell-minimal .q-plain-num,
.q-shell-minimal .q-ms-inline,
.q-shell-minimal .q-ms-dot { color: var(--clk-ink); }

/* ===== 积木 / LED：尺寸按快捷计时主舞台给，外观统一来自 styles/clocks.wxss ===== */
.q-block-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.q-block-tile {
  width: 76rpx;
  height: 132rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.q-block-num { font-size: 66rpx; line-height: 1; }
.q-block-colon { font-size: 52rpx; line-height: 1; padding: 0 2rpx; }

.q-led-clock {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 26rpx;
  border-radius: 22rpx;
}
.q-led-digit { position: relative; flex: 0 0 64rpx; width: 64rpx; height: 112rpx; }
.q-led-colon {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.q-led-dot { width: 8rpx; height: 8rpx; }

.q-clock-long .q-block-tile { width: 62rpx; height: 108rpx; }
.q-clock-long .q-block-num { font-size: 54rpx; }
.q-clock-long .q-block-colon { font-size: 42rpx; }
.q-clock-long .q-led-clock { padding: 12rpx 20rpx; }
.q-clock-long .q-led-digit { flex-basis: 52rpx; width: 52rpx; height: 92rpx; }
.q-clock-long .q-led-colon { flex-basis: 8rpx; width: 8rpx; height: 52rpx; gap: 14rpx; }
.q-clock-long .q-led-dot { width: 7rpx; height: 7rpx; }

/* 积木 / LED 的毫秒：跟主数字同一族，只小一号；>1 小时由 msShow 收起 */
.q-clock-ms.blocks { align-items: flex-end; margin-left: 6rpx; }
.q-clock-ms.blocks .q-ms-dot { font-size: 30rpx; margin: 0 1rpx 14rpx; }
.q-clock-ms.blocks .q-ms-inline { color: var(--ink); font-family: "Courier New", "Menlo", monospace; font-weight: 900; font-size: 58rpx; letter-spacing: 1rpx; padding-bottom: 14rpx; }
.q-clock-ms.led { align-items: flex-end; margin-left: 8rpx; }
.q-clock-ms.led .q-ms-dot { font-size: 28rpx; margin: 0 1rpx 16rpx; color: var(--primary-2); }
.q-clock-ms.led .q-ms-inline { color: var(--primary-2); font-family: "Courier New", "Menlo", monospace; font-weight: 900; font-size: 54rpx; letter-spacing: 1rpx; padding-bottom: 16rpx; text-shadow: 0 0 8rpx var(--primary-2); }
.q-clock-long .q-clock-ms.blocks .q-ms-inline { font-size: 46rpx; }
.q-clock-long .q-clock-ms.led .q-ms-inline { font-size: 44rpx; }

/* 积木 / LED 的毫秒：与主数字同款且同尺寸，整行等比收进屏宽 */
.q-block-ms { display: flex; align-items: center; gap: 6rpx; margin-left: 12rpx; }
.q-block-ms-dot { color: var(--clk-ink); font-family: "Courier New", "Menlo", monospace; font-size: 34rpx; font-weight: 900; line-height: 1; padding: 0 2rpx; align-self: flex-end; padding-bottom: 26rpx; }
.q-block-tile-ms { width: 78rpx; height: 136rpx; border-width: 3rpx; border-radius: 12rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.q-block-num-ms { font-size: 70rpx; }

.q-led-ms { display: flex; align-items: flex-end; gap: 4rpx; margin-left: 12rpx; padding-bottom: 0; }
.q-led-ms-dot { color: var(--clk-glow); font-family: "Courier New", "Menlo", monospace; font-size: 30rpx; font-weight: 900; line-height: 1; padding-bottom: 6rpx; }
.q-led-digit-ms { flex: 0 0 64rpx; width: 64rpx; height: 112rpx; }

.q-clock-long .q-block-tile-ms { width: 56rpx; height: 100rpx; border-width: 2rpx; }
.q-clock-long .q-block-num-ms { font-size: 48rpx; }
.q-clock-long .q-block-ms-dot { font-size: 26rpx; padding-bottom: 18rpx; }
.q-clock-long .q-led-digit-ms { flex-basis: 52rpx; width: 52rpx; height: 92rpx; }


/* ===== 毫秒读数紧贴主体：带毫秒时主数字不再撑 3.3em 定宽，整排收拢 ===== */
.q-clock-shell.q-with-ms { gap: 0; }
.q-clock-shell.q-with-ms .q-plain-num { min-width: 0; }
.q-clock-shell.q-with-ms .q-plain-clock { flex: 0 0 auto; }
.q-clock-shell.q-with-ms .q-clock-ms { margin-left: 4rpx; }

/* ===== 轻点切换样式：主题色小胶囊，进页面提示一次，不常驻 ===== */
.clock-style-hint {
  position: absolute;
  z-index: 6;
  left: 50%;
  bottom: 6rpx;
  transform: translate(-50%, 10rpx);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: var(--on-primary);
  border: 2rpx solid var(--edge);
  box-shadow: 3rpx 4rpx 0 var(--shadow-soft);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity .26s ease, transform .26s cubic-bezier(.2, .8, .3, 1);
}
.clock-style-hint.show { opacity: 1; transform: translate(-50%, 0); }

/* ===== 桌面 / 大屏：快捷计时 =====
 * 原则：看的主体（时钟）随屏幕适度放大；
 *       功能性的小控件（分段 tab、开始/计次/重置、预设、计次行）锁手机档，不跟着放大，
 *       只在布局上摊到屏幕边缘并保留边距。
 */
.desk .quick-tabs {
  margin: 10px 26px 0;
  padding: 4px;
  gap: 4px;
  border-width: 1px;
  border-radius: 999px;
}
.desk .quick-tab { padding: 7px 0; border-radius: 999px; font-size: 14px; }
.desk .quick-body { padding: 12px 26px 8px; gap: 8px; }
.desk .quick-clock-card { padding: 6px 0; gap: 7px; }
.desk .pomo-chip { gap: 4px; padding: 3px 9px; border-width: 1px; font-size: 11px; }
.desk .pomo-dot { width: 6px; height: 6px; }
.desk .pomo-cycle { margin-left: 2px; font-size: 10px; }

.desk .time-picker { height: 157px; border-width: 1px; border-radius: 11px; }
.desk .picker-item { height: 49px; font-size: 20px; line-height: 49px; }
.desk .picker-units { margin-top: 2px; font-size: 11px; }

.desk .quick-actions { gap: 10px; padding-top: 6px; }
.desk .quick-primary,
.desk .quick-lap,
.desk .quick-reset {
  height: 46px;
  min-height: 46px;
  border-width: 2px;
  border-radius: 999px;
  box-shadow: 2px 3px 0 var(--shadow);
  font-size: 15px;
}
.desk .quick-lap,
.desk .quick-reset { flex: 0 0 76px; }

.desk .preset-head { margin-bottom: 8px; }
.desk .preset-title { font-size: 13px; }
.desk .preset-hint { font-size: 11px; }
.desk .preset-grid { gap: 6px; }
.desk .preset-chip {
  flex: 1 1 calc(33.333% - 4px);
  min-width: calc(33.333% - 4px);
  padding: 9px 4px;
  border-width: 1px;
  border-radius: 9px;
  font-size: 13px;
}
.desk .preset-chip.on { box-shadow: 2px 3px 0 var(--shadow-soft); }
.desk .preset-badge { top: -7px; right: -4px; padding: 1px 4px; border-width: 1px; font-size: 9px; }

.desk .lap-list { max-height: 129px; margin-top: 1px; }
.desk .lap-row { height: 31px; padding: 0 6px; gap: 6px; font-size: 13px; }
.desk .clock-style-hint { font-size: 11px; padding: 4px 11px; border-width: 1px; }

/* 时钟（主体）的放大由 JS 注入 clockBoxStyle 控制：
 * 8 种皮肤内部尺寸都是 rpx，这里按窗口算出反缩系数，
 * 让时钟在大屏下的实际字号落在 62–76px（手机约 50px 的 1.25–1.5 倍），
 * 不再依赖 rpx 无限膨胀，也不影响三种皮肤的等比关系。 */

/* ===== 预设时间：改成一块一块的“板砖” =====
   竖屏一行两块、大屏一行三块，宽度按 1fr 平分铺满，高度用固定 px/rpx 做厚，
   不再是一排细长的小胶囊。 */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}
.preset-chip {
  box-sizing: border-box;
  width: auto;
  min-width: 0;
  height: 152rpx;
  padding: 0 10rpx;
  border-width: 3rpx;
  border-radius: 22rpx;
  box-shadow: 4rpx 5rpx 0 var(--shadow-soft);
  font-size: 30rpx;
}
.preset-chip.on {
  transform: none;
  box-shadow: 6rpx 7rpx 0 var(--shadow);
}
.preset-chip:active {
  transform: translate(2rpx, 3rpx);
  box-shadow: 2rpx 2rpx 0 var(--shadow-soft);
}

.desk .preset-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
.desk .preset-chip {
  height: 96px;
  min-width: 0;
  padding: 0 10px;
  border-width: 1px;
  border-radius: 14px;
  box-shadow: 3px 4px 0 var(--shadow-soft);
  font-size: 16px;
}
.desk .preset-chip.on { box-shadow: 4px 5px 0 var(--shadow); }

/* ===== 时间选择器：三个单位标签与三列滚轮严格对齐 =====
   滚轮是 content-box，width:100% 再加 2rpx 边框会让三列比下面那行标签宽一点点，
   放大到宽屏后误差被乘出来，看起来就是“时/分/秒对不上轮子”。 */
.time-picker { box-sizing: border-box; }
.picker-units {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 0;
  margin-top: 10rpx;
  font-size: 22rpx;
}
.picker-units .picker-unit { text-align: center; }
.desk .picker-units { margin-top: 6px; font-size: 12px; }

/* 大屏的滚轮整体加高一档，三行数字更大、也更接近“板砖”的厚实感 */
.desk .time-picker { height: 236px; border-radius: 14px; }
.desk .picker-item { height: 76px; line-height: 76px; font-size: 30px; }

/* ===== 时间选择器限高：窗口再高也不许把预设和按钮顶出屏幕 ===== */
.time-picker { max-height: 40vh; }

/* ===== 底部操作条：做成页面页脚（flex 尾项），不再用 fixed =====
 * 之前用 position:fixed 挂在 .quick-body 里，而 .quick-body 带 app-rise-in 动画（transform），
 * transform 会让 fixed 的参照系变成这个滚动容器，于是按钮跟着内容一起滚、停不到屏幕底部。 */
.quick-actions {
  position: static;
  padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 14rpx);
  background: var(--bg);
}
.desk .quick-actions { padding: 10px 26px calc(env(safe-area-inset-bottom) + 12px); }

/* ===== 快捷计时最终布局：页脚按钮贴底，时钟只活在中间容器里 =====
 * 页面本身是 flex 列：tabs / body(弹性) / actions(页脚)。
 * 时钟槽固定占满 body 里除 lap 列表外的空间，再由 JS 按槽宽高等比缩放；
 * 任何皮肤、任何数字长度都不允许把页面撑宽或把按钮顶走。 */
.quick-page {
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.quick-body {
  flex: 1 1 auto;
  min-height: 0;
  box-sizing: border-box;
  overflow-y: hidden;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}
.quick-body.picker-body {
  overflow-y: auto;
}
.quick-clock-card {
  flex: 1 1 auto;
  min-height: 0;
}
.quick-clock-stage {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 10rpx 0;
  overflow: hidden;
}
.q-clock-slot {
  width: 100%;
  height: 100%;
  min-height: 0;
  max-width: 100%;
  overflow: hidden;
}
.quick-page .clock-display {
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  opacity: 0;
  transition: opacity .18s ease;
}
.quick-page .clock-display.ready { opacity: 1; }
.quick-page .q-clock-shell {
  max-width: 100%;
  max-height: 100%;
}
.quick-actions {
  flex: 0 0 auto;
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx calc(env(safe-area-inset-bottom) + 14rpx);
  background: var(--bg);
}
.quick-primary,
.quick-lap,
.quick-reset {
  width: auto !important;
  min-width: 0 !important;
  max-width: 100%;
  box-sizing: border-box;
}
.desk .quick-clock-stage { padding: 10px 0; }
