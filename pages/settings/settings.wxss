.settings-page { min-height: 100vh; background: var(--bg); color: var(--ink); }
.settings-body { padding: 24rpx 24rpx 140rpx; }

/* 顶部分段切换 */
.seg-scroll { width: 100%; white-space: nowrap; }
.seg-bar { display: inline-flex; gap: 10rpx; padding-bottom: 6rpx; }
.seg { padding: 18rpx 34rpx; color: var(--text-mid); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 4rpx 0 var(--shadow); font-size: 25rpx; font-weight: 900; }
.seg.on { color: var(--on-primary); background: var(--primary); box-shadow: 5rpx 5rpx 0 var(--shadow); }

.pane { margin-top: 26rpx; }
.home-primary-list { display: flex; flex-direction: column; gap: 14rpx; }
.home-primary-item { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.home-primary-item.on { background: var(--cream-2); border-width: 3rpx; }
.home-primary-radio { flex: 0 0 36rpx; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 50%; }
.home-primary-dot { width: 20rpx; height: 20rpx; background: var(--primary); border-radius: 50%; transform: scale(0); transition: transform .15s ease; }
.home-primary-item.on .home-primary-radio { border-color: var(--edge); }
.home-primary-item.on .home-primary-dot { transform: scale(1); }
.home-primary-name { color: var(--ink); font-size: 27rpx; font-weight: 900; }
.pane-tip, .pane-sub { margin-bottom: 16rpx; color: var(--text-warm); font-size: 22rpx; font-weight: 700; }
.pane-more { margin-top: 20rpx; padding: 18rpx; color: var(--text-mid); text-align: center; background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }

/* 主题：两列卡片 */
.theme-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.theme-card { position: relative; padding: 22rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 24rpx; box-shadow: 5rpx 5rpx 0 var(--shadow); }
.theme-card.active { background: var(--cream-2); border-width: 3rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); }
.theme-swatch { display: flex; gap: 8rpx; margin-bottom: 14rpx; }
.swatch-dot { width: 40rpx; height: 40rpx; border: 2rpx solid var(--edge); border-radius: 10rpx; }
.theme-name { font-size: 25rpx; font-weight: 900; }
.theme-check { position: absolute; top: 14rpx; right: 16rpx; color: var(--on-primary); background: var(--primary); border: 2rpx solid var(--edge); border-radius: 999rpx; width: 34rpx; height: 34rpx; text-align: center; font-size: 22rpx; font-weight: 900; line-height: 34rpx; }

/* 提醒 */
.opt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.opt { padding: 20rpx; color: var(--ink); text-align: center; background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 20rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); font-size: 24rpx; font-weight: 800; }
.opt.active { color: var(--on-primary); background: var(--primary); border-color: var(--edge); box-shadow: 5rpx 5rpx 0 var(--shadow); }
.ring-grid { display: flex; gap: 12rpx; flex-wrap: wrap; }
.ring-pill { padding: 16rpx 24rpx; color: var(--ink); background: var(--card); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); font-size: 23rpx; font-weight: 800; }
.ring-pill.active { color: var(--on-primary); background: var(--primary); box-shadow: 5rpx 5rpx 0 var(--shadow); }
.ring-note { margin-right: 8rpx; font-size: 23rpx; }

/* 专注保护 */
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 24rpx; margin-bottom: 14rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.row-main { min-width: 0; }
.row-name { font-size: 25rpx; font-weight: 900; }
.row-desc { margin-top: 6rpx; color: var(--text-2); font-size: 21rpx; }
.switch { flex: 0 0 96rpx; width: 96rpx; height: 52rpx; position: relative; background: var(--cream-3); border: 2rpx solid var(--edge); border-radius: 999rpx; }
.switch.on { background: var(--primary); }
.knob { position: absolute; top: 4rpx; left: 4rpx; width: 40rpx; height: 40rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 50%; transition: left .18s ease; }
.switch.on .knob { left: 48rpx; }

/* 习惯模板 */
.habit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.habit-tile { padding: 20rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 20rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); }
.habit-tile.checked { background: var(--primary); box-shadow: 5rpx 5rpx 0 var(--shadow); }
.habit-tile-name { font-size: 24rpx; font-weight: 900; }
.habit-tile-desc { margin-top: 6rpx; color: var(--text-mid); font-size: 20rpx; }
.habit-tile.checked .habit-tile-desc { color: var(--on-primary); }

/* 自定义配色 */
.custom-box { margin-top: 18rpx; padding: 22rpx 24rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 24rpx; box-shadow: 5rpx 5rpx 0 var(--shadow); }
.custom-head { margin-bottom: 14rpx; font-size: 24rpx; font-weight: 900; }
.custom-name { width: 100%; box-sizing: border-box; height: 92rpx; min-height: 92rpx; margin-bottom: 16rpx; padding: 0 20rpx; color: var(--ink); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 16rpx; font-size: 26rpx; font-weight: 800; line-height: 92rpx; }
.custom-name-ph { color: var(--text-4); font-weight: 700; }
.custom-actions { margin-top: 16rpx; display: flex; gap: 14rpx; }
.custom-btn { flex: 1; padding: 16rpx 8rpx; text-align: center; color: var(--ink); background: var(--card); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); font-size: 22rpx; font-weight: 900; }
.custom-btn.primary { color: var(--on-primary); background: var(--primary); box-shadow: 5rpx 5rpx 0 var(--shadow); }
.color-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.color-label { flex: 0 0 56rpx; color: var(--text-mid); font-size: 20rpx; font-weight: 800; }
.color-list { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.color-dot { width: 52rpx; height: 52rpx; border: 2rpx solid var(--edge); border-radius: 50%; }
.color-dot.on { box-shadow: 0 0 0 4rpx var(--primary); border-width: 3rpx; }
.custom-tip { margin-top: 6rpx; color: var(--text-3); font-size: 19rpx; }

/* 自定义铃声 */
.ring-actions { margin-top: 16rpx; display: flex; gap: 12rpx; }
.ring-action { padding: 16rpx 26rpx; color: var(--ink); background: var(--cream-1); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 4rpx 0 var(--shadow-soft); font-size: 22rpx; font-weight: 800; }

/* 本地数据 */
.data-zone { margin-top: 42rpx; padding: 26rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 24rpx; box-shadow: 5rpx 5rpx 0 var(--shadow-soft); }
.data-title { color: var(--ink); font-size: 25rpx; font-weight: 900; }
.data-desc { margin-top: 8rpx; color: var(--text-2); font-size: 20rpx; line-height: 1.7; }
.data-clear-btn { display: flex; align-items: center; justify-content: center; width: 100%; box-sizing: border-box; margin: 20rpx 0 0; padding: 18rpx 10rpx; color: #FFFFFF; background: var(--danger); border: 2rpx solid var(--edge); border-radius: 999rpx; box-shadow: 4rpx 5rpx 0 var(--shadow); font-size: 23rpx; font-weight: 900; line-height: 1.3; }

/* 时钟样式：预览 + 列表 */
.clock-preview { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 34rpx 24rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 26rpx; box-shadow: 5rpx 5rpx 0 var(--shadow-soft); }
.clock-preview-card { padding: 12rpx 30rpx; background: var(--panel); border: 2rpx solid var(--edge-deep); border-radius: 22rpx; box-shadow: 5rpx 6rpx 0 var(--shadow-soft); }
.clock-preview-card .q-plain-num { font-family: "Courier New", Menlo, monospace; font-size: 88rpx; font-weight: 900; line-height: 1.1; letter-spacing: 2rpx; color: var(--on-panel-warm); text-shadow: 0 0 14rpx rgba(255, 209, 102, .55); }
.clock-preview-hint { color: var(--text-mid); font-size: 22rpx; font-weight: 800; }
.clock-style-list { display: flex; flex-direction: column; gap: 14rpx; }
.clock-style-card { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 22rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 22rpx; box-shadow: 4rpx 5rpx 0 var(--shadow-soft); }
.clock-style-card.on { background: var(--cream-2); border-width: 3rpx; box-shadow: 5rpx 6rpx 0 var(--shadow); }
.clock-style-sample { flex: 0 0 150rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; background: var(--cream-1); border: 2rpx solid var(--line-strong); border-radius: 16rpx; overflow: hidden; }
.clock-style-sample .q-plain-num { font-family: "Courier New", Menlo, monospace; font-size: 44rpx; font-weight: 900; line-height: 1; color: var(--ink); }
.clock-style-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.clock-style-name { font-size: 26rpx; font-weight: 900; }
.clock-style-desc { color: var(--text-2); font-size: 20rpx; font-weight: 700; }
.clock-style-radio { flex: 0 0 40rpx; width: 40rpx; height: 40rpx; color: var(--on-primary); background: var(--primary); border: 2rpx solid var(--edge); border-radius: 50%; font-size: 24rpx; font-weight: 900; line-height: 40rpx; text-align: center; }

/* 时钟样式预览：霓虹 / 描边 / 极简 */
.q-shell-neon { background: var(--ink); border-color: transparent; box-shadow: 0 0 22rpx rgba(255, 60, 172, .35), inset 0 0 26rpx rgba(80, 220, 255, .16); }
.q-shell-neon .q-plain-num { color: #FFE9F4; text-shadow: 0 0 6rpx #FF3CAC, 0 0 18rpx #FF3CAC, 0 0 36rpx rgba(80, 220, 255, .75); letter-spacing: 3rpx; }
.q-shell-outline { background: transparent; border: 4rpx solid var(--ink); box-shadow: none; }
.q-shell-outline .q-plain-num { color: transparent; -webkit-text-stroke: 3rpx var(--ink); text-shadow: none; letter-spacing: 3rpx; }
.q-shell-minimal { background: transparent; border: 0; box-shadow: none; }
.q-shell-minimal .q-plain-num { font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; font-weight: 200; color: var(--ink); text-shadow: none; letter-spacing: 4rpx; }
.q-shell-digital { background: transparent; border: 0; box-shadow: none; }
.q-shell-digital .q-plain-num { background: transparent; color: var(--accent-text); text-shadow: none; }
.q-shell-flip { background: var(--cream-2); }
.q-shell-flip .q-plain-num { color: var(--ink); text-shadow: none; background: var(--panel); padding: 4rpx 12rpx; border-radius: 8rpx; box-shadow: 3rpx 3rpx 0 var(--shadow-soft); }
.q-clock-long .q-plain-num { font-size: 60rpx; }
