<view class="stats-shell theme-{{theme}} {{isDesktop ? 'desk' : ''}}" style="{{themeStyle}}">
  <view class="topbar" wx:if="{{!isDesktop}}">
    <view class="back-icon" bindtap="handleBack" aria-label="返回">‹</view>
    <view class="topbar-title">打卡</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" above-tabbar="{{true}}" dim="{{dockDim}}"></brand-dock>

  <view class="stats-view-slot">
    <stats-view id="statsView" class="stats-view" bind:dockdim="onDockDim"></stats-view>
  </view>

  <app-dock />
</view>
