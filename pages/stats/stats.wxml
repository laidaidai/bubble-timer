<view class="stats-page theme-{{theme}} {{isDesktop ? 'desk' : ''}}" style="{{themeStyle}}">
  <view class="topbar" wx:if="{{!isDesktop}}">
    <view class="back-icon" bindtap="handleBack" aria-label="返回">‹</view>
    <view class="topbar-title">打卡</view>
    <view class="topbar-spacer"></view>
  </view>

  <brand-dock theme-style="{{themeStyle}}" dim="{{dockDim}}"></brand-dock>

  <scroll-view class="stats-body" scroll-y>

    <view class="panel poster-panel">
      <image class="poster-image" wx:if="{{posterPath}}" src="{{posterPath}}" mode="widthFix" bindlongpress="handlePosterLongPress" bindtap="previewPoster"></image>
      <view class="poster-loading" wx:else>
        <view class="poster-loading-ring"><view class="poster-loading-core"></view></view>
      </view>
    </view>

    <view class="panel" wx:if="{{weakness.length}}">
      <view class="panel-head">
        <view class="panel-title">弱项追踪</view>
      </view>
      <view class="weak-list">
        <view class="weak-row" wx:for="{{weakness}}" wx:key="name">
          <view class="weak-rank num">{{index + 1}}</view>
          <view class="weak-main">
            <view class="weak-top">
              <text class="weak-name">{{item.name}}</text>
              <text class="weak-pct num {{item.avg > 100 ? 'over' : ''}}">{{item.avg}}%</text>
            </view>
            <view class="weak-track">
              <view class="weak-fill" style="width: {{item.bar}}%;"></view>
              <view class="weak-knob" style="left: {{item.bar}}%;"></view>
            </view>
            <view class="weak-sub">已练 {{item.count}} 次</view>
          </view>
        </view>
      </view>
    </view>

    <view class="panel" wx:if="{{hasTrend}}">
      <view class="panel-head">
        <view class="panel-title">成绩趋势</view>
      </view>
      <view class="trend-legend">
        <view class="trend-key" wx:for="{{trendModules}}" wx:key="name" wx:for-item="item" wx:for-index="index">
          <view class="trend-dot tk-{{index}}"></view>
          <text class="trend-name">{{item.name}}</text>
          <text class="trend-last num">{{item.last}}%</text>
        </view>
      </view>
      <canvas canvas-id="trendCanvas" class="trend-canvas"></canvas>
    </view>
  </scroll-view>

</view>
