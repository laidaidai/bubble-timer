<view class="stats-page theme-{{theme}}">
  <view class="topbar">
    <button class="back-icon" bindtap="handleBack">‹</button>
    <view class="topbar-title">数据与打卡</view>
    <view class="topbar-spacer"></view>
  </view>

  <scroll-view class="stats-body" scroll-y>

    <view class="hero-card">
      <view class="hero-top">
        <view class="hero-eyebrow">今日目标完成</view>
        <view class="hero-mode">{{modeName}}</view>
      </view>
      <view class="hero-percent"><text class="hero-num num">{{todayPercent}}</text><text class="hero-unit">%</text></view>
      <view class="hero-bar"><view class="hero-bar-fill" style="width: {{todayPercent}}%;"></view></view>
      <view class="hero-meta">今日 {{todayText}} · 目标 {{todayTarget}}</view>
    </view>

    <view class="metric-row">
      <view class="metric-card">
        <view class="metric-label">本周累计</view>
        <view class="metric-value num">{{weekText}}</view>
        <view class="metric-sub">出勤 {{weekDays}} 天</view>
      </view>
      <view class="metric-card metric-accent">
        <view class="metric-label">连续打卡</view>
        <view class="metric-value num">{{streak}} 天</view>
        <view class="metric-sub">累计 {{totalDays}} 天</view>
      </view>
    </view>

    <view class="panel poster-panel">
      <view class="panel-head">
        <view class="panel-title">打卡海报</view>
        <view class="panel-sub">竖版 · 可保存或分享</view>
      </view>
      <view class="poster-card">
        <view class="pc-head">
          <view class="pc-brand">{{poster.brand}}</view>
          <view class="pc-row">
            <view class="pc-title">{{poster.title}}</view>
            <view class="pc-date num">{{todayLabel}}</view>
          </view>
        </view>

        <view class="pc-body">
          <view class="pc-ring" style="background: conic-gradient(var(--primary) 0% {{todayPercent}}%, var(--cream-2) {{todayPercent}}% 100%);">
            <view class="pc-ring-inner">
              <view class="pc-pct num">{{todayPercent}}<text class="pc-unit">%</text></view>
              <view class="pc-pct-sub">{{poster.ringLabel}}</view>
            </view>
          </view>
          <view class="pc-stats">
            <view class="pc-stat">
              <view class="pc-label">{{poster.metricToday}}</view>
              <view class="pc-value num">{{todayText}}</view>
            </view>
            <view class="pc-stat">
              <view class="pc-label">{{poster.metricWeek}}</view>
              <view class="pc-value num">{{weekText}}</view>
            </view>
            <view class="pc-stat">
              <view class="pc-label">{{poster.metricStreak}}</view>
              <view class="pc-value num">{{streak}} 天</view>
            </view>
          </view>
        </view>

        <view class="pc-trend">
          <view class="pc-trend-head">
            <text class="pc-trend-title">{{poster.trendTitle}}</text>
            <text class="pc-trend-unit">{{poster.trendUnit}}</text>
          </view>
          <view class="pc-bars">
            <view class="pc-bar-col" wx:for="{{trend}}" wx:key="key">
              <text class="pc-bar-val num">{{item.text}}</text>
              <view class="pc-bar-track">
                <view class="pc-bar-fill {{index === trend.length - 1 ? 'today' : ''}}" style="height: {{item.height}}%;"></view>
              </view>
              <text class="pc-bar-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="pc-quote">
          <view class="pc-quote-line"><text class="pc-star">★</text><text>{{poster.quote}}</text></view>
          <view class="pc-quote-sub">{{poster.totalPrefix}} {{totalDays}} 天</view>
        </view>

        <view class="pc-foot">
          <text>{{poster.footLeft}}</text>
          <text>{{poster.footRight}}</text>
        </view>
      </view>

      <view class="poster-actions">
        <button class="mini-action primary" bindtap="savePoster">保存相册</button>
        <button class="mini-action" bindtap="sharePoster">分享</button>
      </view>
    </view>

    <view class="panel">
      <view class="panel-head">
        <view class="panel-title">打卡热力图</view>
        <view class="panel-sub">近 8 周 · 颜色越深练得越多</view>
      </view>
      <view class="heat-wrap">
        <view class="heat-col" wx:for="{{heatCols}}" wx:key="key">
          <view class="heat-cell level-{{cell.level}}" wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key"></view>
        </view>
      </view>
      <view class="heat-legend">
        <text class="legend-label">少</text>
        <view class="heat-cell level-0"></view>
        <view class="heat-cell level-1"></view>
        <view class="heat-cell level-2"></view>
        <view class="heat-cell level-3"></view>
        <view class="heat-cell level-4"></view>
        <text class="legend-label">多</text>
      </view>
    </view>

    <view class="panel">
      <view class="panel-head">
        <view class="panel-title">近 7 天趋势</view>
        <view class="panel-sub">单位：分钟</view>
      </view>
      <view class="trend-row">
        <view class="trend-item" wx:for="{{trend}}" wx:key="key">
          <text class="trend-val num">{{item.text}}</text>
          <view class="trend-track"><view class="trend-bar" style="height: {{item.height}}%;"></view></view>
          <text class="trend-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="panel-head">
        <view class="panel-title">本周训练榜</view>
        <view class="panel-sub">先和自己比，再邀请好友一起练</view>
      </view>
      <view class="rank-list">
        <view class="rank-row {{index < 3 ? 'top' : ''}}" wx:for="{{rankList}}" wx:key="key">
          <view class="rank-no num">{{index + 1}}</view>
          <view class="rank-info">
            <view class="rank-name">{{item.label}}</view>
            <view class="rank-bar"><view class="rank-fill" style="width: {{item.width}}%;"></view></view>
          </view>
          <view class="rank-time num">{{item.text}}</view>
        </view>
      </view>
      <view class="rank-tip">好友榜需要云开发关系链，当前先用「打卡海报 + 小程序转发」和好友对比：把每天的时长截图发出去，谁都不许偷懒。</view>
      <button class="share-open" open-type="share">转发给好友</button>
    </view>

    <view class="stats-tip">数据统计按本机记录汇总，卸载小程序会一并清空。</view>
  </scroll-view>

  <canvas class="poster-canvas" canvas-id="posterCanvas"></canvas>
</view>
