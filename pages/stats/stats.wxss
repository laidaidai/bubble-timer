page { background: var(--bg); }

.stats-page { min-height: 100vh; background: var(--bg); color: var(--ink); }

.stats-body { height: calc(100vh - 176rpx); padding: 8rpx 28rpx 60rpx; box-sizing: border-box; }

/* ===== 通用面板 ===== */
.panel { margin-top: 20rpx; padding: 22rpx 24rpx; background: var(--card); border: 2rpx solid var(--edge); border-radius: 26rpx; box-shadow: 5rpx 6rpx 0 var(--shadow-soft); }
.panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.panel-title { font-size: 26rpx; font-weight: 900; }
.panel-sub { color: var(--text-3); font-size: 18rpx; }
.panel-empty { margin-top: 16rpx; padding: 30rpx 8rpx; color: var(--text-3); font-size: 20rpx; line-height: 1.6; text-align: center; }

/* ===== 打卡海报 ===== */
.poster-panel .poster-card { margin-top: 0; }
.poster-image { display: block; width: 100%; border: 3rpx solid var(--edge); border-radius: 26rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); background: var(--card); }
.poster-card { margin-top: 16rpx; background: var(--card); border: 3rpx solid var(--edge); border-radius: 26rpx; box-shadow: 6rpx 7rpx 0 var(--shadow); overflow: hidden; }
.pc-cal-cell.empty { background: transparent; }
.pc-cal-cell.today { box-shadow: inset 0 0 0 3rpx var(--panel); }
.poster-actions { margin-top: 16rpx; display: flex; gap: 12rpx; }
.mini-action.primary { color: var(--on-primary); background: var(--primary); }

/* ===== 弱项追踪 ===== */
.weak-list { margin-top: 16rpx; }
.weak-row { display: flex; align-items: flex-start; gap: 12rpx; padding: 10rpx 0; }
.weak-rank { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; margin-top: 2rpx; display: flex; align-items: center; justify-content: center; color: var(--text-mid); background: var(--cream-2); border: 2rpx solid var(--line-strong); border-radius: 999rpx; font-size: 20rpx; }
.weak-main { flex: 1; min-width: 0; }
.weak-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10rpx; }
.weak-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); font-size: 24rpx; font-weight: 800; }
.weak-pct { color: var(--ink); font-size: 24rpx; font-weight: 900; }
/* 弱项条：套用首页训练模块滑杆的样式（描边 + 硬阴影 + 歪圆角 + 斜纹 + 圆把手） */
.weak-track { position: relative; margin-top: 12rpx; height: 24rpx; box-sizing: border-box; background: var(--cream-2); border: 3rpx solid var(--edge); border-radius: 14rpx 10rpx 16rpx 11rpx; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); }
.weak-fill { position: relative; height: 100%; box-sizing: border-box; overflow: hidden; background: var(--primary); border-right: 2rpx solid var(--edge); border-radius: 11rpx 7rpx 13rpx 8rpx; transform-origin: left center; }
.weak-fill::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  background-image: repeating-linear-gradient(112deg, rgba(255, 255, 255, .24) 0, rgba(255, 255, 255, .24) 3rpx, rgba(255, 255, 255, 0) 3rpx, rgba(255, 255, 255, 0) 10rpx);
  pointer-events: none;
}
.weak-knob { position: absolute; z-index: 2; top: 50%; width: 30rpx; height: 30rpx; box-sizing: border-box; transform: translate(-50%, -50%); background: var(--primary); border: 3rpx solid var(--edge); border-radius: 46% 54% 48% 52%; box-shadow: 3rpx 4rpx 0 var(--shadow-soft); }
.weak-knob::after { content: ""; position: absolute; top: 6rpx; left: 8rpx; width: 8rpx; height: 8rpx; background: rgba(255, 255, 255, .72); border-radius: 50%; }
.weak-pct.over { color: var(--danger-text); }
.weak-sub { margin-top: 6rpx; color: var(--text-3); font-size: 18rpx; }

/* ===== 成绩趋势 ===== */
.trend-legend { margin: 14rpx 0 4rpx; display: flex; flex-wrap: wrap; gap: 10rpx 18rpx; }
.trend-key { display: flex; align-items: center; gap: 8rpx; }
.trend-dot { width: 18rpx; height: 18rpx; border-radius: 50%; border: 2rpx solid var(--edge); }
.tk-0 { background: var(--primary); }
.tk-1 { background: var(--primary-2); }
.tk-2 { background: var(--success); }
.trend-name { color: var(--ink); font-size: 20rpx; font-weight: 800; }
.trend-last { color: var(--text-3); font-size: 19rpx; font-weight: 900; }
.trend-canvas { width: 100%; height: 380rpx; margin-top: 6rpx; }

/* ===== 页脚提示 ===== */
.stats-tip { margin: 24rpx 4rpx 0; color: var(--text-3); font-size: 18rpx; line-height: 1.6; }

/* 海报生成前的加载态：不再显示旧版海报 */
.poster-loading {
  box-sizing: border-box;
  width: 100%;
  height: 920rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border: 3rpx solid var(--edge);
  border-radius: 26rpx;
  box-shadow: 6rpx 7rpx 0 var(--shadow);
}
.poster-loading-ring {
  width: 78rpx;
  height: 78rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 7rpx solid var(--line);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: poster-loading-spin .85s linear infinite;
}
.poster-loading-core { width: 22rpx; height: 22rpx; border-radius: 50%; background: var(--primary); opacity: .5; }
@keyframes poster-loading-spin { to { transform: rotate(360deg); } }

/* ===== 打卡页动效 ===== */
.stats-page { animation: app-page-fade .24s ease-out both; }
.poster-panel { animation: app-rise-in .42s cubic-bezier(.2, .8, .3, 1) both; }
.poster-image { transform-origin: center top; animation: stats-poster-reveal .55s cubic-bezier(.2, .8, .3, 1) both; }
.panel:nth-child(2) { animation: app-rise-in .42s .05s cubic-bezier(.2, .8, .3, 1) backwards; }
.panel:nth-child(3) { animation: app-rise-in .42s .10s cubic-bezier(.2, .8, .3, 1) backwards; }
.weak-row { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.weak-row:nth-child(2) { animation-delay: .06s; }
.weak-row:nth-child(3) { animation-delay: .12s; }
.weak-row:nth-child(4) { animation-delay: .18s; }
.weak-fill { transform-origin: left center; animation: stats-bar-grow .9s cubic-bezier(.2, .8, .3, 1) both; }
.trend-key { animation: app-rise-in .34s cubic-bezier(.2, .8, .3, 1) backwards; }
.trend-key:nth-child(2) { animation-delay: .06s; }
.trend-key:nth-child(3) { animation-delay: .12s; }
.trend-canvas { animation: stats-canvas-in .5s ease-out both; }

@keyframes stats-poster-reveal { 0% { opacity: 0; transform: translateY(14rpx) scale(.965); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes stats-bar-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
@keyframes stats-canvas-in { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }

/* 海报生成后的一次高光，强化“今天打卡完成”的反馈 */
.poster-panel { position: relative; overflow: hidden; border-radius: 26rpx; }
.poster-panel::after { content: ""; position: absolute; top: -20%; bottom: -20%; left: -30%; width: 22%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .30), transparent); transform: rotate(14deg); animation: stats-poster-shine 1.2s .3s ease-out both; pointer-events: none; }
@keyframes stats-poster-shine { from { transform: translateX(0) rotate(14deg); } to { transform: translateX(700%) rotate(14deg); } }
